msgstr "النكهة المدخنة مقصودة."

#. STRINGS.BLUEPRINTS.PERMIT_COOKINGSTATION_COTTAGE.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_COOKINGSTATION_COTTAGE.NAME"
