msgctxt "STRINGS.BLUEPRINTS.PERMIT_BOTTOM_GOTCH_QUANTUM_RADGLO.NAME"
msgid "Quantum Skivvies"
msgstr "ملابس داخلية كمومية"

#. STRINGS.BLUEPRINTS.PERMIT_BOTTOM_GOTCH_RUSTY_GRUBBY.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_BOTTOM_GOTCH_RUSTY_GRUBBY.DESC"
msgid "The vivid hue of these longjohns was achieved using only the finest tetanus-free dyes. Well, mostly."
msgstr "تم الحصول على اللون الزاهي لهذه السراويل الطويلة باستخدام أجود أنواع الصبغات الخالية من التيتانوس. حسناً، في الغالب."

