#. STRINGS.CREATURES.SPECIES.LIGHTBUG.VARIANT_PURPLE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.LIGHTBUG.VARIANT_PURPLE.BABY.DESC"
msgid "A chubby baby <link=\"LIGHTBUGPURPLE\">Shine Bug</link>.\n\nThis one is a Royal morph."
msgstr "صغير <link=\"LIGHTBUGPURPLE\">حشرة لامعة</link> ممتلئ الجسم.\n\nهذا النوع هو تحور ملكي."

#. STRINGS.CREATURES.SPECIES.LIGHTBUG.VARIANT_PURPLE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.LIGHTBUG.VARIANT_PURPLE.BABY.NAME"
msgid "<link=\"LIGHTBUGPURPLE\">Royal Nymph</link>"
msgstr "<link=\"LIGHTBUGPURPLE\">حورية ملكية</link>"

#. STRINGS.CREATURES.SPECIES.LIGHTBUG.VARIANT_PURPLE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.LIGHTBUG.VARIANT_PURPLE.DESC"
msgid "Royal Bugs emit a soft purple <link=\"LIGHT\">Light</link> in hopes of attracting more of their kind for company.\n\nTheir eggs contain small amounts of <link=\"NATURALRESIN\">Resin</link> that can be harvested when cracked at the <link=\"EGGCRACKER\">Egg Cracker</link>."
msgstr "تصدر الحشرات الملكية <link=\"LIGHT\">ضوءاً</link> أرجوانياً خافتاً على أمل جذب المزيد من فصيلتها للرفقة.\n\nيحتوي بيضها على كميات صغيرة من <link=\"NATURALRESIN\">الراتنج</link> التي يمكن حصادها عند كسرها في <link=\"EGGCRACKER\">كسارة البيض</link>."

