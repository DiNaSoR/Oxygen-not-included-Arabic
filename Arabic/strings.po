#. STRINGS.CREATURES.SPECIES.STEGO.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STEGO.BABY.DESC"
msgid "A heavy-footed little Lumb baby.\n\nIn time, it will grow into a stompy <link=\"STEGO\">Lumb</link>."
msgstr "صغير لومب ثقيل الخطى.\n\nمع مرور الوقت، سينمو ليصبح <link=\"STEGO\">لومب</link> مدمرًا."

#. STRINGS.CREATURES.SPECIES.STEGO.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STEGO.BABY.NAME"
msgid "<link=\"STEGO\">Lumblet</link>"
msgstr "<link=\"STEGO\">لومبليت</link>"

#. STRINGS.CREATURES.SPECIES.STEGO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STEGO.DESC"
msgid "Lumbs are non-hostile critters that subsist on <link=\"VINEMOTHER\">Ovagro</link> vines.\n\nWhen they stomp heavily near <link=\"PLANTS\">plants</link>, the commotion causes harvestable items to fall to the ground."
msgstr "اللومب مخلوقات غير عدائية تقتات على كرمات <link=\"VINEMOTHER\">أوفاجرو</link>.\n\nعندما تدوس بقوة بالقرب من <link=\"PLANTS\">النباتات</link>، يتسبب هذا الاضطراب في سقوط العناصر القابلة للحصاد على الأرض."

#. STRINGS.CREATURES.SPECIES.STEGO.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.STEGO.EGG_NAME"
msgid "<link=\"STEGO\">Lumb Egg</link>"
msgstr "<link=\"STEGO\">بيضة لومب</link>"

#. STRINGS.CREATURES.SPECIES.STEGO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STEGO.NAME"
msgid "<link=\"STEGO\">Lumb</link>"
msgstr "<link=\"STEGO\">لومب</link>"

#. STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DESC"
msgid "A Grubfruit Plant that has flourished after being tended by a <link=\"DIVERGENTSPECIES\">Divergent</link> critter.\n\nIt will produce high quality <link=\"WORMSUPERFRUIT\">Grubfruits</link>."
msgstr "نبات فاكهة اليرقات الذي ازدهر بعد أن اعتنى به مخلوق <link=\"DIVERGENTSPECIES\">دايفرجنت</link>.\n\nسينتج هذا النبات <link=\"WORMSUPERFRUIT\">فاكهة يرقات</link> عالية الجودة."

#. STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"WORMSUPERFRUIT\">Grubfruit</link>."
msgstr "هذا النبات ينتج <link=\"WORMSUPERFRUIT\">فاكهة يرقات</link> صالحة للأكل."

#. STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.NAME"
msgid "<link=\"WORMPLANT\">Grubfruit Plant</link>"
msgstr "<link=\"WORMPLANT\">نبات فاكهة اليرقات</link>"

#. STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.DESC"
msgid "Swamp Chards are incapable of propagating but can be harvested for a single low quality and calorie dense <link=\"FOOD\">Food</link> serving."
msgstr "سلق المستنقعات غير قادر على التكاثر ولكنه يمكن حصاده للحصول على حصة واحدة من <link=\"FOOD\">طعام</link> منخفضة الجودة وكثيفة السعرات الحرارية."

#. STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.NAME"
msgid "<link=\"SWAMPFORAGEPLANTPLANTED\">Swamp Chard</link>"
msgstr "<link=\"SWAMPFORAGEPLANTPLANTED\">سلق المستنقعات</link>"

#. STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DESC"
msgid "Bog Buckets produce juicy, sweet <link=\"SWAMPFRUIT\">Bog Jellies</link> for <link=\"FOOD\">Food</link>."
msgstr "تنتج نباتات بوغ باكيت <link=\"SWAMPFRUIT\">هلام المستنقع</link> الحلو والعصير لاستخدامه كـ <link=\"FOOD\">طعام</link>."

#. STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"SWAMPFRUIT\">Bog Jellies</link>."
msgstr "هذا النبات ينتج <link=\"SWAMPFRUIT\">هلام المستنقع</link> الصالح للأكل."

