msgid "<link=\"DATABANK\">Data Bank</link>"
msgstr "<link=\"DATABANK\">بنك بيانات</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ORBITAL_RESEARCH_DATABANK.NAME_PLURAL
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ORBITAL_RESEARCH_DATABANK.NAME_PLURAL"
msgid "<link=\"DATABANK\">Data Banks</link>"
msgstr "<link=\"DATABANK\">بنوك بيانات</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ORBITAL_RESEARCH_DATABANK.RECIPE_DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.ORBITAL_RESEARCH_DATABANK.RECIPE_DESC"
msgid "Data Banks of raw data generated from exploring, either by exploring new areas with Duplicants, or by using an <link=\"ORBITALRESEARCHCENTER\">Orbital Data Collection Lab</link>.\n\nUsed by the <link=\"DLC1COSMICRESEARCHCENTER\">Virtual Planetarium</link> to conduct research."
msgstr "بنوك بيانات من بيانات خام تم إنشاؤها من الاستكشاف، إما عن طريق استكشاف مناطق جديدة بالمكررين، أو باستخدام <link=\"ORBITALRESEARCHCENTER\">مختبر جمع بيانات المدار</link>.\n\nتستخدمها <link=\"DLC1COSMICRESEARCHCENTER\">القبة الفلكية الافتراضية</link> لإجراء الأبحاث."

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.PLANT_FIBER.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.PLANT_FIBER.DESC"
msgid "A bundle of dried plant matter.\n\nIt can be eaten by <link=\"MOOSPECIES\">Moos</link>, or processed into <link=\"POWER\">fuel</link> or <link=\"BUILDINGMATERIALCLASSES\">building materials</link>."
msgstr "حزمة من مادة نباتية مجففة.\n\nيمكن أن تأكلها <link=\"MOOSPECIES\">المو</link>، أو معالجتها إلى <link=\"POWER\">وقود</link> أو <link=\"BUILDINGMATERIALCLASSES\">مواد بناء</link>."

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.PLANT_FIBER.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.PLANT_FIBER.NAME"
msgid "<link=\"PLANTFIBER\">Plant Husk</link>"
msgstr "<link=\"PLANTFIBER\">قشرة نبات</link>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.DESC"
msgid "A specialized <link=\"POWERSTATIONTOOLS\">Microchip</link> created by a professional engineer.\n\nTunes up <link=\"REQUIREMENTCLASSGENERATORTYPE\">Generators</link> to increase their <link=\"POWER\">Power</link> output.\n\nAlso used in the production of <link=\"BOOSTER\">Boosters</link> for Bionic Duplicants."
msgstr "رقاقة دقيقة <link=\"POWERSTATIONTOOLS\">ميكروكهيب</link> متخصصة ابتكرها مهندس محترف.\n\nتضبط <link=\"REQUIREMENTCLASSGENERATORTYPE\">جينيراتورس</link> لزيادة مخرج <link=\"POWER\">بووير</link> الخاص بها.\n\nتُستخدم أيضاً في إنتاج <link=\"BOOSTER\">بووستيرس</link> للمكررات البيونية."

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.POWER_STATION_TOOLS.NAME
