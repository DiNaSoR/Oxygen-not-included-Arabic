msgstr "هاتف قابل للطي"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFLOORROBOT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFLOORROBOT.DESC"
msgid "The grasping robotic claw designed to assist technicians in a lab."
msgstr "مخلب آلي مصمم لمساعدة الفنيين في المختبر."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFLOORROBOT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFLOORROBOT.NAME"
msgid "Robotic Arm"
msgstr "ذراع آلية"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFRIDGE.DESC"
msgid "A non-functional cold storage unit full of expired samples.\n\nIt was originally someone's home appliance."
msgstr "وحدة تبريد غير وظيفية مليئة بعينات منتهية الصلاحية.\n\nكانت في الأصل جهازاً منزلياً لأحدهم."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFRIDGE.NAME"
msgid "Mini Fridge"
msgstr "ثلاجة صغيرة"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASHANDSCANNER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASHANDSCANNER.DESC"
msgid "A sophisticated security device.\n\nIt appears to use a method other than fingerprints to verify an individual's identity."
msgstr "جهاز أمني متطور.\n\nيبدو أنه يستخدم طريقة أخرى غير بصمات الأصابع للتحقق من هوية الفرد."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASHANDSCANNER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASHANDSCANNER.NAME"
msgid "Hand Scanner"
msgstr "ماسح يدوي"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR1.DESC"
msgid "An abnormally large brain floating in embalming liquid to prevent decomposition."
msgstr "دماغ كبير بشكل غير طبيعي يطفو في سائل تحنيط لمنع التحلل."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR1.NAME"
msgid "Big Brain Jar"
msgstr "جرة الدماغ الكبير"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR2.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR2.DESC"
msgid "The corpse of a proto-hatch creature meticulously preserved in a jar."
msgstr "جثة مخلوق هاتش أولي محفوظة بدقة في جرة."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR2.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR2.NAME"
msgid "Sample Jar"
msgstr "جرة عينات"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABTABLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABTABLE.DESC"
msgid "The quaint research desk of a departed lab technician.\n\nPerhaps the computer stores something of interest."
msgstr "مكتب الأبحاث الخاص بفني مختبر راحل.\n\nربما يخزن الحاسوب شيئاً مثيراً للاهتمام."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABTABLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABTABLE.NAME"
msgid "Lab Desk"
msgstr "مكتب مختبر"

