msgstr "يحتوي على <link=\"PLANTS\">نبات</link> واحد عند زراعته بـ <link=\"PLANTS\">بذرة</link>.\n\nيزيد من <link=\"DECOR\">الديكور</link> عند استخدامه، مما يساهم في <link=\"MORALE\">المعنويات</link>."

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.DEFAULT_FLOWERVASE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.DEFAULT_FLOWERVASE.DESC"
