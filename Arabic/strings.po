msgstr "<link=\"REFRIGERATOR\">ثلاجة نيوترونيوم ملكية</link>"

#. STRINGS.BLUEPRINTS.PERMIT_GASSTORAGE_DARTLE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_GASSTORAGE_DARTLE.DESC"
msgid "The splotchy parts have an unsettlingly leather-like texture."
msgstr "الأجزاء الملطخة لها ملمس يشبه الجلد بشكل مقلق."

#. STRINGS.BLUEPRINTS.PERMIT_GASSTORAGE_DARTLE.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_GASSTORAGE_DARTLE.NAME"
msgid "<link=\"GASRESERVOIR\">Dartle Gas Reservoir</link>"
msgstr "<link=\"GASRESERVOIR\">خزان غاز دارتل</link>"

#. STRINGS.BLUEPRINTS.PERMIT_GASSTORAGE_LUMB.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_GASSTORAGE_LUMB.DESC"
msgid "Does not stomp."
msgstr "لا تسبب ضجيجاً."

#. STRINGS.BLUEPRINTS.PERMIT_GASSTORAGE_LUMB.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_GASSTORAGE_LUMB.NAME"
msgid "<link=\"GASRESERVOIR\">Lumb Gas Reservoir</link>"
msgstr "<link=\"GASRESERVOIR\">خزان غاز لومب</link>"

#. STRINGS.BLUEPRINTS.PERMIT_GENERATORMANUAL_A.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_GENERATORMANUAL_A.DESC"
