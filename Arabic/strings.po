#. STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.DESC"
msgid "Sweatcorn Stalks produce <link=\"GARDENFOODPLANTFOOD\">Sweatcorn</link>, a crisp vegetable that can be harvested for <link=\"FOOD\">Food</link>."
msgstr "تنتج سيقان ذرة العرق <link=\"GARDENFOODPLANTFOOD\">ذرة العرق</link>، وهي خضروات منعشة يمكن حصادها للحصول على <link=\"FOOD\">طعام</link>."

#. STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"GARDENFOODPLANTFOOD\">Sweatcorn</link>s."
msgstr "ينتج هذا النبات <link=\"GARDENFOODPLANTFOOD\">ذرة العرق</link> القابلة للأكل."

#. STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GARDENFOODPLANT.NAME"
msgid "<link=\"GARDENFOODPLANT\">Sweatcorn Stalk</link>"
msgstr "<link=\"GARDENFOODPLANT\">ساق ذرة العرق</link>"

#. STRINGS.CREATURES.SPECIES.GARDENFORAGEPLANTPLANTED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GARDENFORAGEPLANTPLANTED.DESC"
msgid "Snacti are incapable of propagating but can be harvested for a single <link=\"FOOD\">Food</link> serving."
msgstr "نباتات السناكتي غير قادرة على التكاثر ولكن يمكن حصادها للحصول على حصة <link=\"FOOD\">طعام</link> واحدة."

#. STRINGS.CREATURES.SPECIES.GARDENFORAGEPLANTPLANTED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GARDENFORAGEPLANTPLANTED.NAME"
msgid "<link=\"GARDENFORAGEPLANTPLANTED\">Snactus</link>"
msgstr "<link=\"GARDENFORAGEPLANTPLANTED\">سناكتوس</link>"

#. STRINGS.CREATURES.SPECIES.GASGRASS.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GASGRASS.DESC"
msgid "Gas Grass is an alien lifeform tentatively categorized as a \"plant.\"\n\nIt can be harvested for <link=\"PLANTFIBER\">Plant Husk</link> or eaten as-is by <link=\"MOOSPECIES\">Moos</link>."
msgstr "عشب الغاز هو شكل حياة فضائي مصنف مبدئياً كـ \"نبات\".\n\nيمكن حصاده للحصول على <link=\"PLANTFIBER\">قشرة نبات</link> أو أكله كما هو بواسطة <link=\"MOOSPECIES\">مو</link>."

#. STRINGS.CREATURES.SPECIES.GASGRASS.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.GASGRASS.DOMESTICATEDDESC"
msgid "An alien grass variety that is eaten by <link=\"MOO\">Gassy Moos</link>."
msgstr "نوع من العشب الفضائي تأكله <link=\"MOO\">غاسي مو</link>."

#. STRINGS.CREATURES.SPECIES.GASGRASS.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GASGRASS.NAME"
msgid "<link=\"GASGRASS\">Gas Grass</link>"
msgstr "<link=\"GASGRASS\">عشب الغاز</link>"

#. STRINGS.CREATURES.SPECIES.GEYSER.BIG_VOLCANO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.BIG_VOLCANO.DESC"
msgid "A massive volcano that periodically erupts with molten <link=\"MAGMA\">Magma</link>."
msgstr "بركان ضخم يثور بشكل دوري مقذفاً <link=\"MAGMA\">حمم</link> منصهرة."

#. STRINGS.CREATURES.SPECIES.GEYSER.BIG_VOLCANO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.BIG_VOLCANO.NAME"
msgid "<link=\"GEYSERGENERICBIGVOLCANO\">Volcano</link>"
msgstr "<link=\"GEYSERGENERICBIGVOLCANO\">بركان</link>"

#. STRINGS.CREATURES.SPECIES.GEYSER.CHLORINE_GAS.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GEYSER.CHLORINE_GAS.DESC"
