msgid "Environmental Pledge"
msgstr "تعهد بيئي"

#. STRINGS.CODEX.JOURNALISTREQUEST.BODY.CONTAINER1
msgctxt "STRINGS.CODEX.JOURNALISTREQUEST.BODY.CONTAINER1"
msgid "<indent=5%>Dear colleagues, friends and community members,\n\nAfter nine deeply fulfilling years as editor of The STEM Scoop, I am stepping down to spend more time with my family.\n\nPlease give a warm welcome to Dorian Hearst, who will be taking over editorial management duties effective immediately.</indent>"
msgstr "<indent=5%>أعزائي الزملاء والأصدقاء وأعضاء المجتمع،\n\nبعد تسع سنوات مليئة بالإنجازات كمحرر لـ \"ذا ستيم سكوب\"، سأتنحى عن منصبي لأقضي وقتاً أطول مع عائلتي.\n\nيرجى الترحيب بحرارة بـ دوريان هيرست، الذي سيتولى مهام الإدارة التحريرية اعتباراً من الآن.</indent>"

#. STRINGS.CODEX.JOURNALISTREQUEST.BODY.CONTAINER2
msgctxt "STRINGS.CODEX.JOURNALISTREQUEST.BODY.CONTAINER2"
msgid "<indent=5%>I don't know how you pulled it off, but Stern's office just called the paper and granted me an exclusive...and a tour of the Gravitas Facility. I owe you a beer. No - a case of beer. Six cases of beer!\n\nSeriously, thank you. I know you're in a difficult position but you've done the right thing. See you on Tuesday.</indent>"
msgstr "<indent=5%>لا أعرف كيف تمكنت من فعل ذلك، لكن مكتب ستيرن اتصل للتو بالصحيفة ومنحني مقابلة حصرية... وجولة في منشأة غرافيتاس. أنا مدين لك ببيرة. لا، بل بصندوق من البيرة. ستة صناديق من البيرة!\n\nبجدية، شكراً لك. أعلم أنك في موقف صعب لكنك فعلت الصواب. أراك يوم الثلاثاء.</indent>"

#. STRINGS.CODEX.JOURNALISTREQUEST.BODY.CONTAINER3
msgctxt "STRINGS.CODEX.JOURNALISTREQUEST.BODY.CONTAINER3"
msgid "<indent=5%>I waited at the fountain for four hours. Where were you? This story is going to be huge. Call me.</indent>"
msgstr "<indent=5%>انتظرت عند النافورة لمدة أربع ساعات. أين كنت؟ هذه القصة ستكون ضخمة. اتصل بي.</indent>"

#. STRINGS.CODEX.JOURNALISTREQUEST.BODY.CONTAINER4
msgctxt "STRINGS.CODEX.JOURNALISTREQUEST.BODY.CONTAINER4"
msgid "<indent=5%>Dr. Olowe,\n\nI'm sorry - I know ambushing you at your home last night was a bad idea. But something is happening at Gravitas, and people need to know. Please call me.</indent>"
msgstr "<indent=5%>دكتور أولوي،\n\nأنا آسف، أعلم أن مباغتتك في منزلك الليلة الماضية كانت فكرة سيئة. لكن شيئاً ما يحدث في غرافيتاس، ويجب أن يعرف الناس. يرجى الاتصال بي.</indent>"

#. STRINGS.CODEX.JOURNALISTREQUEST.BODY.EMAILHEADER1
msgctxt "STRINGS.CODEX.JOURNALISTREQUEST.BODY.EMAILHEADER1"
msgid "<smallcaps>To: <b>Dr. Olowe</b><size=10><alpha=#AA> <aolowe@gravitas.nova></size></color>\nFrom: <b>Quinn Kelly</b><alpha=#AA><size=10> <editor@stemscoop.news></size></color></smallcaps>\n------------------\n"
msgstr "<smallcaps>إلى: <b>دكتور أولوي</b><size=10><alpha=#AA> <aolowe@gravitas.nova></size></color>\nمن: <b>كوين كيلي</b><alpha=#AA><size=10> <editor@stemscoop.news></size></color></smallcaps>\n------------------\n"

#. STRINGS.CODEX.JOURNALISTREQUEST.BODY.EMAILHEADER2
msgctxt "STRINGS.CODEX.JOURNALISTREQUEST.BODY.EMAILHEADER2"
msgid "<smallcaps>To: <b>[BCC: all]</b><alpha=#AA><size=10> </size></color>\nFrom: <b>Quinn Kelly</b><alpha=#AA><size=10> <editor@stemscoop.news></size></color></smallcaps>\n------------------\n"
msgstr "<smallcaps>إلى: <b>[نسخة مخفية: الجميع]</b><alpha=#AA><size=10> </size></color>\nمن: <b>كوين كيلي</b><alpha=#AA><size=10> <editor@stemscoop.news></size></color></smallcaps>\n------------------\n"

