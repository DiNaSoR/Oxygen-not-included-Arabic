msgctxt "STRINGS.ITEMS.FOOD.BEAN.DESC"
msgid "The crisp bean of a <link=\"BEANPLANT\">Nosh Sprout</link>.\n\nEach bite tastes refreshingly natural and wholesome."
msgstr "الفول المنعش لنبات <link=\"BEANPLANT\">برعم نوش</link>.\n\nكل قضمة لها مذاق طبيعي وصحي ومنعش."

#. STRINGS.ITEMS.FOOD.BEAN.NAME
msgctxt "STRINGS.ITEMS.FOOD.BEAN.NAME"
msgid "<link=\"BEAN\">Nosh Bean</link>"
msgstr "<link=\"BEAN\">فول نوش</link>"

#. STRINGS.ITEMS.FOOD.BEANPLANTSEED.DESC
msgctxt "STRINGS.ITEMS.FOOD.BEANPLANTSEED.DESC"
msgid "An inedible bean that can be processed into delicious foods."
msgstr "فول غير صالح للأكل يمكن معالجته ليصبح أطعمة لذيذة."

#. STRINGS.ITEMS.FOOD.BEANPLANTSEED.NAME
msgctxt "STRINGS.ITEMS.FOOD.BEANPLANTSEED.NAME"
msgid "<link=\"BEANPLANTSEED\">Nosh Bean</link>"
msgstr "<link=\"BEANPLANTSEED\">فول نوش</link>"

#. STRINGS.ITEMS.FOOD.BERRYPIE.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.BERRYPIE.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"BERRYPIE\">Mixed Berry Pie</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "حصة <link=\"BERRYPIE\">فطيرة التوت المشكل</link> مجففة. يجب إعادة ترطيبها لكي تُعتبر <link=\"FOOD\">طعام</link>.\n\nحصص الطعام الجافة ليس لها تاريخ انتهاء صلاحية."

#. STRINGS.ITEMS.FOOD.BERRYPIE.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.BERRYPIE.DEHYDRATED.NAME"
msgid "<link=\"BERRYPIE\">Dried Berry Pie</link>"
msgstr "<link=\"BERRYPIE\">فطيرة التوت المجففة</link>"

#. STRINGS.ITEMS.FOOD.BERRYPIE.DESC
msgctxt "STRINGS.ITEMS.FOOD.BERRYPIE.DESC"
msgid "A pie made primarily of <link=\"WORMSUPERFRUIT\">Grubfruit</link> and <link=\"PRICKLEFRUIT\">Gristle Berries</link>.\n\nThe mixture of berries creates a fragrant, colorful filling that packs a sweet punch."
msgstr "فطيرة مصنوعة بشكل أساسي من <link=\"WORMSUPERFRUIT\">فاكهة اليرقات</link> و<link=\"PRICKLEFRUIT\">توت غريستل</link>.\n\nيخلق مزيج التوت حشوة عطرة وملونة ذات نكهة حلوة قوية."

#. STRINGS.ITEMS.FOOD.BERRYPIE.NAME
msgctxt "STRINGS.ITEMS.FOOD.BERRYPIE.NAME"
msgid "<link=\"BERRYPIE\">Mixed Berry Pie</link>"
msgstr "<link=\"BERRYPIE\">فطيرة التوت المشكل</link>"

#. STRINGS.ITEMS.FOOD.BERRYPIE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.BERRYPIE.RECIPEDESC"
msgid "A pie made primarily of <link=\"WORMSUPERFRUIT\">Grubfruit</link> and <link=\"PRICKLEFRUIT\">Gristle Berries</link>."
msgstr "فطيرة مصنوعة بشكل أساسي من <link=\"WORMSUPERFRUIT\">فاكهة اليرقات</link> و<link=\"PRICKLEFRUIT\">توت غريستل</link>."

#. STRINGS.ITEMS.FOOD.BURGER.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.BURGER.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"BURGER\">Frost Burger</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "حصة <link=\"BURGER\">برغر الصقيع</link> مجففة. يجب إعادة ترطيبها لكي تُعتبر <link=\"FOOD\">طعام</link>.\n\nحصص الطعام الجافة ليس لها تاريخ انتهاء صلاحية."

#. STRINGS.ITEMS.FOOD.BURGER.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.BURGER.DEHYDRATED.NAME"
msgid "<link=\"BURGER\">Dried Frost Burger</link>"
msgstr "<link=\"BURGER\">برغر الصقيع المجفف</link>"

#. STRINGS.ITEMS.FOOD.BURGER.DESC
msgctxt "STRINGS.ITEMS.FOOD.BURGER.DESC"
msgid "<link=\"MEAT\">Meat</link> and <link=\"LETTUCE\">Lettuce</link> on a chilled <link=\"COLDWHEATBREAD\">Frost Bun</link>.\n\nIt's the only burger best served cold."
msgstr "<link=\"MEAT\">لحم</link> و<link=\"LETTUCE\">خس</link> على <link=\"COLDWHEATBREAD\">كعكة صقيع</link> مبردة.\n\nإنه البرغر الوحيد الذي يُفضل تقديمه بارداً."

#. STRINGS.ITEMS.FOOD.BURGER.NAME
msgctxt "STRINGS.ITEMS.FOOD.BURGER.NAME"
msgid "<link=\"BURGER\">Frost Burger</link>"
msgstr "<link=\"BURGER\">برغر الصقيع</link>"

#. STRINGS.ITEMS.FOOD.BURGER.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.BURGER.RECIPEDESC"
msgid "<link=\"MEAT\">Meat</link> and <link=\"LETTUCE\">Lettuce</link> on a chilled <link=\"COLDWHEATBREAD\">Frost Bun</link>."
msgstr "<link=\"MEAT\">لحم</link> و<link=\"LETTUCE\">خس</link> على <link=\"COLDWHEATBREAD\">كعكة صقيع</link> مبردة."

#. STRINGS.ITEMS.FOOD.BUTTERFLYFOOD.DESC
msgctxt "STRINGS.ITEMS.FOOD.BUTTERFLYFOOD.DESC"
msgid "A lightly toasted <link=\"BUTTERFLYPLANTSEED\">Mimillet</link>.\n\nIt makes the tummy feel a bit fluttery."
msgstr "<link=\"BUTTERFLYPLANTSEED\">ميميليت</link> محمصة قليلاً.\n\nتجعل المعدة تشعر ببعض الاضطراب الخفيف."

#. STRINGS.ITEMS.FOOD.BUTTERFLYFOOD.NAME
msgctxt "STRINGS.ITEMS.FOOD.BUTTERFLYFOOD.NAME"
msgid "<link=\"BUTTERFLYFOOD\">Toasted Mimillet</link>"
msgstr "<link=\"BUTTERFLYFOOD\">ميميليت محمصة</link>"

#. STRINGS.ITEMS.FOOD.BUTTERFLYFOOD.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.BUTTERFLYFOOD.RECIPEDESC"
msgid "A lightly toasted <link=\"BUTTERFLYPLANTSEED\">Mimillet</link>."
msgstr "<link=\"BUTTERFLYPLANTSEED\">ميميليت</link> محمصة قليلاً."

#. STRINGS.ITEMS.FOOD.BUTTERFLYPLANTSEED.DESC
msgctxt "STRINGS.ITEMS.FOOD.BUTTERFLYPLANTSEED.DESC"
msgid "An inedible seed from a <link=\"BUTTERFLYPLANT\">Mimika Bud</link>.\n\nIt can be sown to cultivate more plants, or processed into <link=\"FOOD\">Food</link>.\n\nDigging up Buried Objects may uncover a Mimillet Seed."
msgstr "بذرة غير صالحة للأكل من <link=\"BUTTERFLYPLANT\">برعم ميميكا</link>.\n\nيمكن زراعتها لإنتاج المزيد من النباتات، أو معالجتها لتصبح <link=\"FOOD\">طعام</link>.\n\nقد يكشف حفر الكائنات المدفونة عن بذرة ميميليت."

#. STRINGS.ITEMS.FOOD.BUTTERFLYPLANTSEED.NAME
msgctxt "STRINGS.ITEMS.FOOD.BUTTERFLYPLANTSEED.NAME"
msgid "<link=\"BUTTERFLYPLANTSEED\">Mimillet</link>"
msgstr "<link=\"BUTTERFLYPLANTSEED\">ميميليت</link>"

#. STRINGS.ITEMS.FOOD.BUTTERFLYPLANTSEED.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.BUTTERFLYPLANTSEED.RECIPEDESC"
msgid "An inedible <link=\"BUTTERFLYPLANTSEED\">Mimillet</link> seed."
msgstr "بذرة <link=\"BUTTERFLYPLANTSEED\">ميميليت</link> غير صالحة للأكل."

#. STRINGS.ITEMS.FOOD.CARROT.DESC
msgctxt "STRINGS.ITEMS.FOOD.CARROT.DESC"
msgid "An edible tuber with an earthy, elegant flavor."
msgstr "درنة صالحة للأكل ذات نكهة ترابية وأنيقة."

#. STRINGS.ITEMS.FOOD.CARROT.NAME
msgctxt "STRINGS.ITEMS.FOOD.CARROT.NAME"
msgid "<link=\"CARROT\">Plume Squash</link>"
msgstr "<link=\"CARROT\">قرع الريش</link>"

#. STRINGS.ITEMS.FOOD.COLDWHEATBREAD.DESC
msgctxt "STRINGS.ITEMS.FOOD.COLDWHEATBREAD.DESC"
msgid "A simple bun baked from <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>.\n\nEach bite leaves a mild cooling sensation in one's mouth, even when the bun itself is warm."
msgstr "كعكة بسيطة مخبوزة من <link=\"COLDWHEATSEED\">حبوب قمح السلييت</link>.\n\nتترك كل قضمة إحساساً خفيفاً بالبرودة في الفم، حتى عندما تكون الكعكة نفسها دافئة."

#. STRINGS.ITEMS.FOOD.COLDWHEATBREAD.NAME
msgctxt "STRINGS.ITEMS.FOOD.COLDWHEATBREAD.NAME"
msgid "<link=\"COLDWHEATBREAD\">Frost Bun</link>"
msgstr "<link=\"COLDWHEATBREAD\">كعكة الصقيع</link>"

#. STRINGS.ITEMS.FOOD.COLDWHEATBREAD.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.COLDWHEATBREAD.RECIPEDESC"
msgid "A simple bun baked from <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>."
msgstr "كعكة بسيطة مخبوزة من <link=\"COLDWHEATSEED\">حبوب قمح السلييت</link>."

#. STRINGS.ITEMS.FOOD.COLDWHEATSEED.DESC
msgctxt "STRINGS.ITEMS.FOOD.COLDWHEATSEED.DESC"
msgid "An edible grain that leaves a cool taste on the tongue."
msgstr "حبوب صالحة للأكل تترك مذاقاً بارداً على اللسان."

#. STRINGS.ITEMS.FOOD.COLDWHEATSEED.NAME
msgctxt "STRINGS.ITEMS.FOOD.COLDWHEATSEED.NAME"
msgid "<link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>"
msgstr "<link=\"COLDWHEATSEED\">حبوب قمح السلييت</link>"

#. STRINGS.ITEMS.FOOD.COMPOST
msgctxt "STRINGS.ITEMS.FOOD.COMPOST"
msgid "Compost"
msgstr "سماد"

#. STRINGS.ITEMS.FOOD.COOKEDEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDEGG.DESC"
msgid "Fluffed and folded Egg innards.\n\nIt turns out you do, in fact, have to break a few eggs to make it."
msgstr "أحشاء بيض منفوشة ومطوية.\n\nاتضح أنك، في الواقع، يجب أن تكسر بضع بيضات لصنعها."

#. STRINGS.ITEMS.FOOD.COOKEDEGG.NAME
