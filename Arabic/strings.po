msgid "An asteroid field containing <link=\"SANDSTONE\">Sandstone</link>, <link=\"ALGAE\">Algae</link>, <link=\"CUPRITE\">Copper Ore</link> and <link=\"SAND\">Sand</link>.\n\n<link=\"EXOBASESDLC1\">Space mining</link> requires a rocket equipped with a <link=\"NOSECONEHARVEST\">Drillcone</link> and a cargo module."
msgstr "حقل كويكبات يحتوي على <link=\"SANDSTONE\">حجر رملي</link>، و<link=\"ALGAE\">طحالب</link>، و<link=\"CUPRITE\">خام النحاس</link>، و<link=\"SAND\">رمل</link>.\n\nيتطلب <link=\"EXOBASESDLC1\">التعدين الفضائي</link> صاروخاً مجهزاً بـ <link=\"NOSECONEHARVEST\">مخروط حفر</link> ووحدة شحن."

