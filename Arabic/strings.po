#. STRINGS.ITEMS.FOOD.FIELDRATION.NAME
msgctxt "STRINGS.ITEMS.FOOD.FIELDRATION.NAME"
msgid "<link=\"FIELDRATION\">Nutrient Bar</link>"
msgstr "<link=\"FIELDRATION\">لوح مغذيات</link>"

#. STRINGS.ITEMS.FOOD.FISHMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.FISHMEAT.DESC"
msgid "An uncooked fillet from a very dead <link=\"PACU\">Pacu</link>. Yum!"
msgstr "فيليه غير مطهو من <link=\"PACU\">باكو</link> ميت جداً. لذيذ!"

#. STRINGS.ITEMS.FOOD.FISHMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.FISHMEAT.NAME"
msgid "<link=\"FISHMEAT\">Pacu Fillet</link>"
msgstr "<link=\"FISHMEAT\">فيليه باكو</link>"

#. STRINGS.ITEMS.FOOD.FOODSPLAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.FOODSPLAT.DESC"
msgid "Food smeared on the wall from a recent Food Fight"
msgstr "طعام ملطخ على الجدار من معركة طعام حديثة"

#. STRINGS.ITEMS.FOOD.FOODSPLAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.FOODSPLAT.NAME"
msgid "Food Splatter"
msgstr "تلطخ الطعام"

#. STRINGS.ITEMS.FOOD.FORESTFORAGEPLANT.DESC
msgctxt "STRINGS.ITEMS.FOOD.FORESTFORAGEPLANT.DESC"
msgid "A seedless fruit with an unusual rubbery texture.\n\nIt cannot be replanted.\n\nHexalent fruit is much more calorie dense than Muckroot fruit."
msgstr "فاكهة بدون بذور ذات قوام مطاطي غير معتاد.\n\nلا يمكن إعادة زراعتها.\n\nفاكهة هيكسالينت أكثر كثافة بالسعرات الحرارية بكثير من فاكهة ماكروت."

#. STRINGS.ITEMS.FOOD.FORESTFORAGEPLANT.NAME
msgctxt "STRINGS.ITEMS.FOOD.FORESTFORAGEPLANT.NAME"
msgid "<link=\"FORESTFORAGEPLANT\">Hexalent Fruit</link>"
msgstr "<link=\"FORESTFORAGEPLANT\">فاكهة هيكسالينت</link>"

#. STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.DESC
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.DESC"
msgid "Pan-fried, solidified mudslop.\n\nThe inside is almost completely uncooked, despite the crunch on the outside."
msgstr "هرس طيني صلب ومقلي في المقلاة.\n\nالداخل غير مطهو تماماً تقريباً، على الرغم من القرمشة في الخارج."

#. STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.NAME
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.NAME"
msgid "<link=\"FRIEDMUSHBAR\">Mush Fry</link>"
msgstr "<link=\"FRIEDMUSHBAR\">هرس مقلي</link>"

#. STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.RECIPEDESC"
msgid "Pan-fried, solidified mudslop."
msgstr "هرس طيني صلب ومقلي في المقلاة."

#. STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.DESC
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.DESC"
msgid "A pan-fried dish made with a fruiting <link=\"MUSHROOM\">Dusk Cap</link>.\n\nIt has a thick, savory flavor with subtle earthy undertones."
msgstr "طبق مقلي في المقلاة مصنوع من ثمرة <link=\"MUSHROOM\">قبعة الغسق</link>.\n\nيتميز بنكهة غنية ولذيذة مع لمسات ترابية خفيفة."

#. STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.NAME
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.NAME"
msgid "<link=\"FRIEDMUSHROOM\">Fried Mushroom</link>"
msgstr "<link=\"FRIEDMUSHROOM\">فطر مقلي</link>"

#. STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.RECIPEDESC"
msgid "A pan-fried dish made with a fruiting <link=\"MUSHROOM\">Dusk Cap</link>."
msgstr "طبق مقلي في المقلاة مصنوع من ثمرة <link=\"MUSHROOM\">قبعة الغسق</link>."

#. STRINGS.ITEMS.FOOD.FRIESCARROT.DESC
msgctxt "STRINGS.ITEMS.FOOD.FRIESCARROT.DESC"
msgid "Irresistibly crunchy.\n\nBest eaten hot."
msgstr "مقرمشة بشكل لا يقاوم.\n\nتؤكل ساخنة للحصول على أفضل مذاق."

#. STRINGS.ITEMS.FOOD.FRIESCARROT.NAME
msgctxt "STRINGS.ITEMS.FOOD.FRIESCARROT.NAME"
msgid "<link=\"FRIESCARROT\">Squash Fries</link>"
msgstr "<link=\"FRIESCARROT\">مقليات القرع</link>"

#. STRINGS.ITEMS.FOOD.FRIESCARROT.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.FRIESCARROT.RECIPEDESC"
msgid "Crunchy sticks of <link=\"CARROT\">Plume Squash</link> deep-fried in <link=\"TALLOW\">Tallow</link>."
msgstr "أصابع مقرمشة من <link=\"CARROT\">قرع الريش</link> مقلية في <link=\"TALLOW\">شحم</link>."

#. STRINGS.ITEMS.FOOD.FRUITCAKE.DESC
msgctxt "STRINGS.ITEMS.FOOD.FRUITCAKE.DESC"
msgid "A mashed up <link=\"PRICKLEFRUIT\">Bristle Berry</link> sludge with an exceptionally long shelf life.\n\nIts aggressive, overbearing sweetness can leave the tongue feeling temporarily numb."
msgstr "خليط مهروس من <link=\"PRICKLEFRUIT\">توت بريستل</link> يتميز بعمر افتراضي طويل للغاية.\n\nحلاوته القوية والمفرطة قد تترك اللسان في حالة خدر مؤقت."

#. STRINGS.ITEMS.FOOD.FRUITCAKE.NAME
msgctxt "STRINGS.ITEMS.FOOD.FRUITCAKE.NAME"
msgid "<link=\"FRUITCAKE\">Berry Sludge</link>"
msgstr "<link=\"FRUITCAKE\">هريس التوت</link>"

#. STRINGS.ITEMS.FOOD.FRUITCAKE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.FRUITCAKE.RECIPEDESC"
msgid "A mashed up <link=\"PRICKLEFRUIT\">Bristle Berry</link> sludge with an exceptionally long shelf life."
msgstr "خليط مهروس من <link=\"PRICKLEFRUIT\">توت بريستل</link> يتميز بعمر افتراضي طويل للغاية."

#. STRINGS.ITEMS.FOOD.GAMMAMUSH.DESC
msgctxt "STRINGS.ITEMS.FOOD.GAMMAMUSH.DESC"
msgid "A disturbingly delicious mixture of irradiated dirt and water."
msgstr "خليط لذيذ ومثير للقلق من التربة والمياه المعرضة للإشعاع."

#. STRINGS.ITEMS.FOOD.GAMMAMUSH.NAME
msgctxt "STRINGS.ITEMS.FOOD.GAMMAMUSH.NAME"
msgid "<link=\"GAMMAMUSH\">Gamma Mush</link>"
msgstr "<link=\"GAMMAMUSH\">هرس غاما</link>"

#. STRINGS.ITEMS.FOOD.GAMMAMUSH.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.GAMMAMUSH.RECIPEDESC"
msgid "<link=\"FRIEDMUSHBAR\">Mush Fry</link> reheated in a <link=\"GAMMARAYOVEN\">Gamma Ray Oven</link>."
msgstr "<link=\"FRIEDMUSHBAR\">مقليات الهرس</link> يُعاد تسخينها في <link=\"GAMMARAYOVEN\">فرن أشعة غاما</link>."

#. STRINGS.ITEMS.FOOD.GARDENFOODPLANTFOOD.DESC
msgctxt "STRINGS.ITEMS.FOOD.GARDENFOODPLANTFOOD.DESC"
msgid "The sugary vegetable produced by <link=\"GARDENFOODPLANT\">Sweatcorn Stalks</link>.\n\nIt tastes a lot better deep-fried."
msgstr "الخضار السكرية التي تنتجها <link=\"GARDENFOODPLANT\">سيقان ذرة العرق</link>.\n\nمذاقها أفضل بكثير عند قليها."

#. STRINGS.ITEMS.FOOD.GARDENFOODPLANTFOOD.NAME
msgctxt "STRINGS.ITEMS.FOOD.GARDENFOODPLANTFOOD.NAME"
msgid "<link=\"GARDENFOODPLANTFOOD\">Sweatcorn</link>"
msgstr "<link=\"GARDENFOODPLANTFOOD\">ذرة العرق</link>"

#. STRINGS.ITEMS.FOOD.GARDENFORAGEPLANT.DESC
msgctxt "STRINGS.ITEMS.FOOD.GARDENFORAGEPLANT.DESC"
msgid "A seedless fruit that loses its flavor long before it is fully chewed.\n\nIt cannot be replanted.\n\nDigging up Buried Objects may uncover a <link=\"GARDENFORAGEPLANT\">Snac Fruit</link>."
msgstr "فاكهة بلا بذور تفقد نكهتها قبل مضغها بالكامل.\n\nلا يمكن إعادة زراعتها.\n\nقد يكشف حفر الكائنات المدفونة عن <link=\"GARDENFORAGEPLANT\">فاكهة سناك</link>."

#. STRINGS.ITEMS.FOOD.GARDENFORAGEPLANT.NAME
msgctxt "STRINGS.ITEMS.FOOD.GARDENFORAGEPLANT.NAME"
msgid "<link=\"GARDENFORAGEPLANT\">Snac Fruit</link>"
msgstr "<link=\"GARDENFORAGEPLANT\">فاكهة سناك</link>"

#. STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.DESC
msgctxt "STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.DESC"
msgid "The grilled bud of a <link=\"PRICKLEFRUIT\">Bristle Berry</link>.\n\nHeat unlocked an exquisite taste in the fruit, though the burnt spines leave something to be desired."
msgstr "برعم مشوي من <link=\"PRICKLEFRUIT\">توت بريستل</link>.\n\nأطلقت الحرارة مذاقاً رائعاً في الفاكهة، على الرغم من أن الأشواك المحترقة تترك شيئاً مرغوباً فيه."

#. STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.NAME
msgctxt "STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.NAME"
msgid "<link=\"GRILLEDPRICKLEFRUIT\">Gristle Berry</link>"
msgstr "<link=\"GRILLEDPRICKLEFRUIT\">توت غريستل</link>"

#. STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.RECIPEDESC"
msgid "The grilled bud of a <link=\"PRICKLEFRUIT\">Bristle Berry</link>."
msgstr "برعم مشوي من <link=\"PRICKLEFRUIT\">توت بريستل</link>."

#. STRINGS.ITEMS.FOOD.HARDSKINBERRY.DESC
msgctxt "STRINGS.ITEMS.FOOD.HARDSKINBERRY.DESC"
msgid "An edible fruit encased in a thorny husk."
msgstr "فاكهة صالحة للأكل مغلفة بقشرة شائكة."

#. STRINGS.ITEMS.FOOD.HARDSKINBERRY.NAME
msgctxt "STRINGS.ITEMS.FOOD.HARDSKINBERRY.NAME"
msgid "<link=\"HARDSKINBERRY\">Pikeapple</link>"
msgstr "<link=\"HARDSKINBERRY\">بايك أبل</link>"

#. STRINGS.ITEMS.FOOD.HATCHEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.HATCHEGG.DESC"
msgid "An egg laid by a <link=\"HATCH\">Hatch</link>.\n\nIf incubated, it will hatch into a <link=\"HATCH\">Hatchling</link>."
msgstr "بيضة وضعتها <link=\"HATCH\">هاتش</link>.\n\nإذا تم تحضينها، ستفقس لتصبح <link=\"HATCH\">هاتشلينج</link>."

#. STRINGS.ITEMS.FOOD.HATCHEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.HATCHEGG.NAME"
msgid "<link=\"HATCH\">Hatch Egg</link>"
msgstr "<link=\"HATCH\">بيضة هاتش</link>"

#. STRINGS.ITEMS.FOOD.HATCHEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.HATCHEGG.RECIPEDESC"
msgid "An egg laid by a <link=\"HATCH\">Hatch</link>."
msgstr "بيضة وضعتها <link=\"HATCH\">هاتش</link>."

#. STRINGS.ITEMS.FOOD.ICECAVESFORAGEPLANT.DESC
msgctxt "STRINGS.ITEMS.FOOD.ICECAVESFORAGEPLANT.DESC"
msgid "A cold seedless fruit that triggers mild brain freeze.\n\nIt cannot be replanted."
msgstr "فاكهة باردة بلا بذور تسبب تجمد الدماغ الخفيف.\n\nلا يمكن إعادة زراعتها."

#. STRINGS.ITEMS.FOOD.ICECAVESFORAGEPLANT.NAME
msgctxt "STRINGS.ITEMS.FOOD.ICECAVESFORAGEPLANT.NAME"
msgid "<link=\"ICECAVESFORAGEPLANT\">Sherberry</link>"
msgstr "<link=\"ICECAVESFORAGEPLANT\">شيربيري</link>"

#. STRINGS.ITEMS.FOOD.LETTUCE.DESC
msgctxt "STRINGS.ITEMS.FOOD.LETTUCE.DESC"
msgid "Crunchy, slightly salty leaves from a <link=\"SEALETTUCE\">Waterweed</link> plant."
msgstr "أوراق مقرمشة ومالحة قليلاً من نبات <link=\"SEALETTUCE\">عشبة الماء</link>."

#. STRINGS.ITEMS.FOOD.LETTUCE.NAME
msgctxt "STRINGS.ITEMS.FOOD.LETTUCE.NAME"
msgid "<link=\"LETTUCE\">Lettuce</link>"
msgstr "<link=\"LETTUCE\">خس</link>"

#. STRINGS.ITEMS.FOOD.LETTUCE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.LETTUCE.RECIPEDESC"
msgid "Edible roughage from a <link=\"SEALETTUCE\">Waterweed</link>."
msgstr "ألياف غذائية صالحة للأكل من <link=\"SEALETTUCE\">عشبة الماء</link>."

#. STRINGS.ITEMS.FOOD.LIGHTBUGEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.LIGHTBUGEGG.DESC"
msgid "An egg laid by a <link=\"LIGHTBUG\">Shine Bug</link>.\n\nIf incubated, it will hatch into a <link=\"LIGHTBUG\">Shine Nymph</link>."
msgstr "بيضة وضعتها <link=\"LIGHTBUG\">حشرة لامعة</link>.\n\nإذا تم تحضينها، ستفقس لتصبح <link=\"LIGHTBUG\">حورية لامعة</link>."

#. STRINGS.ITEMS.FOOD.LIGHTBUGEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.LIGHTBUGEGG.NAME"
msgid "<link=\"LIGHTBUG\">Shine Bug Egg</link>"
msgstr "<link=\"LIGHTBUG\">بيضة حشرة لامعة</link>"

#. STRINGS.ITEMS.FOOD.LIGHTBUGEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.LIGHTBUGEGG.RECIPEDESC"
msgid "An egg laid by a <link=\"LIGHTBUG\">Shine Bug</link>."
msgstr "بيضة وضعتها <link=\"LIGHTBUG\">حشرة لامعة</link>."

#. STRINGS.ITEMS.FOOD.MEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.MEAT.DESC"
msgid "Uncooked meat from a very dead critter. Yum!"
msgstr "لحم غير مطهو من مخلوق ميت تماماً. لذيذ!"

#. STRINGS.ITEMS.FOOD.MEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.MEAT.NAME"
msgid "<link=\"MEAT\">Meat</link>"
msgstr "<link=\"MEAT\">لحم</link>"

#. STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.DESC
msgctxt "STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.DESC"
msgid "<link=\"LETTUCE\">Lettuce</link> scrumptiously wilted in the <link=\"GAMMARAYOVEN\">Gamma Ray Oven</link>."
msgstr "<link=\"LETTUCE\">خس</link> ذابل بشكل شهي في <link=\"GAMMARAYOVEN\">فرن أشعة غاما</link>."

#. STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.NAME
msgctxt "STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.NAME"
msgid "<link=\"MICROWAVEDLETTUCE\">Microwaved Lettuce</link>"
msgstr "<link=\"MICROWAVEDLETTUCE\">خس مطهو بالميكروويف</link>"

#. STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.RECIPEDESC"
msgid "<link=\"LETTUCE\">Lettuce</link> scrumptiously wilted in the <link=\"GAMMARAYOVEN\">Gamma Ray Oven</link>."
msgstr "<link=\"LETTUCE\">خس</link> ذابل بشكل شهي في <link=\"GAMMARAYOVEN\">فرن أشعة غاما</link>."

#. STRINGS.ITEMS.FOOD.MUSHBAR.DESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHBAR.DESC"
msgid "An edible, putrefied mudslop.\n\nMush Bars are preferable to starvation, but only just barely."
msgstr "هرس طيني متعفن صالح للأكل.\n\nتُفضل بارات الهريس على المجاعة، ولكن بالكاد."

#. STRINGS.ITEMS.FOOD.MUSHBAR.NAME
msgctxt "STRINGS.ITEMS.FOOD.MUSHBAR.NAME"
msgid "<link=\"MUSHBAR\">Mush Bar</link>"
msgstr "<link=\"MUSHBAR\">بار الهريس</link>"

#. STRINGS.ITEMS.FOOD.MUSHBAR.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHBAR.RECIPEDESC"
msgid "An edible, putrefied mudslop.\n\n<link=\"MUSHBAR\">Mush Bar</link>s are preferable to starvation, but only just barely."
msgstr "هرس طيني متعفن صالح للأكل.\n\nتُفضل <link=\"MUSHBAR\">بارات الهريس</link> على المجاعة، ولكن بالكاد."

#. STRINGS.ITEMS.FOOD.MUSHROOM.DESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOM.DESC"
msgid "An edible, flavorless fungus that grew in the dark."
msgstr "فطر صالح للأكل وعديم النكهة نما في الظلام."

#. STRINGS.ITEMS.FOOD.MUSHROOM.NAME
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOM.NAME"
msgid "<link=\"MUSHROOM\">Mushroom</link>"
msgstr "<link=\"MUSHROOM\">فطر</link>"

#. STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"MUSHROOMWRAP\">Mushroom Wrap</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "حصة <link=\"MUSHROOMWRAP\">لفافة فطر</link> مجففة. يجب إعادة ترطيبها لكي تُعتبر <link=\"FOOD\">طعاماً</link>.\n\nالحصص الجافة ليس لها تاريخ انتهاء صلاحية."

#. STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DEHYDRATED.NAME"
msgid "<link=\"MUSHROOMWRAP\">Dried Mushroom Wrap</link>"
msgstr "<link=\"MUSHROOMWRAP\">لفافة فطر مجففة</link>"

#. STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DESC"
msgid "Flavorful <link=\"MUSHROOM\">Mushrooms</link> wrapped in <link=\"LETTUCE\">Lettuce</link>.\n\nIt has an earthy flavor punctuated by a refreshing crunch."
msgstr "<link=\"MUSHROOM\">فطر</link> لذيذ ملفوف في <link=\"LETTUCE\">خس</link>.\n\nيتمتع بنكهة ترابية تتخللها قرمشة منعشة."

#. STRINGS.ITEMS.FOOD.MUSHROOMWRAP.NAME
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOMWRAP.NAME"
msgid "<link=\"MUSHROOMWRAP\">Mushroom Wrap</link>"
msgstr "<link=\"MUSHROOMWRAP\">لفافة فطر</link>"

#. STRINGS.ITEMS.FOOD.MUSHROOMWRAP.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOMWRAP.RECIPEDESC"
msgid "Flavorful <link=\"MUSHROOM\">Mushrooms</link> wrapped in <link=\"LETTUCE\">Lettuce</link>."
msgstr "<link=\"MUSHROOM\">فطر</link> لذيذ ملفوف في <link=\"LETTUCE\">خس</link>."

#. STRINGS.ITEMS.FOOD.OILFLOATEREGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.OILFLOATEREGG.DESC"
msgid "An egg laid by a <link=\"OILFLOATER\">Slickster</link>.\n\nIf incubated, it will hatch into a <link=\"OILFLOATER\">Slickster Larva</link>."
msgstr "بيضة وضعتها <link=\"OILFLOATER\">سليكستر</link>.\n\nإذا تم تحضينها، ستفقس لتصبح <link=\"OILFLOATER\">يرقة سليكستر</link>."

#. STRINGS.ITEMS.FOOD.OILFLOATEREGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.OILFLOATEREGG.NAME"
msgid "<link=\"OILFLOATER\">Slickster Egg</link>"
msgstr "<link=\"OILFLOATER\">بيضة سليكستر</link>"

#. STRINGS.ITEMS.FOOD.OILFLOATEREGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.OILFLOATEREGG.RECIPEDESC"
msgid "An egg laid by a <link=\"OILFLOATER\">Slickster</link>."
msgstr "بيضة وضعتها <link=\"OILFLOATER\">سليكستر</link>."

#. STRINGS.ITEMS.FOOD.PANCAKES.DESC
msgctxt "STRINGS.ITEMS.FOOD.PANCAKES.DESC"
msgid "Sweet discs made from <link=\"RAWEGG\">Raw Egg</link> and <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>.\n\nThey're so thick!"
msgstr "أقراص حلوة مصنوعة من <link=\"RAWEGG\">بيضة خام</link> و<link=\"COLDWHEATSEED\">حبوب قمح السلييت</link>.\n\nإنها سميكة جداً!"

#. STRINGS.ITEMS.FOOD.PANCAKES.NAME
msgctxt "STRINGS.ITEMS.FOOD.PANCAKES.NAME"
msgid "<link=\"PANCAKES\">Soufflé Pancakes</link>"
msgstr "<link=\"PANCAKES\">فطائر سوفليه</link>"

#. STRINGS.ITEMS.FOOD.PANCAKES.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PANCAKES.RECIPEDESC"
msgid "Sweet discs made from <link=\"RAWEGG\">Raw Egg</link> and <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>."
msgstr "أقراص حلوة مصنوعة من <link=\"RAWEGG\">بيضة خام</link> و<link=\"COLDWHEATSEED\">حبوب قمح السلييت</link>."

#. STRINGS.ITEMS.FOOD.PASTA.DESC
msgctxt "STRINGS.ITEMS.FOOD.PASTA.DESC"
msgid "pasta made from egg and wheat"
msgstr "معكرونة مصنوعة من البيض والقمح"

#. STRINGS.ITEMS.FOOD.PASTA.NAME
msgctxt "STRINGS.ITEMS.FOOD.PASTA.NAME"
msgid "<link=\"PASTA\">Pasta</link>"
msgstr "<link=\"PASTA\">معكرونة</link>"

#. STRINGS.ITEMS.FOOD.PASTA.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PASTA.RECIPEDESC"
msgid "pasta made from egg and wheat"
msgstr "معكرونة مصنوعة من البيض والقمح"

#. STRINGS.ITEMS.FOOD.PEMMICAN.DESC
msgctxt "STRINGS.ITEMS.FOOD.PEMMICAN.DESC"
msgid "<link=\"MEAT\">Meat</link> and <link=\"TALLOW\">Tallow</link> pounded into a calorie-dense brick with an exceptionally long shelf life.\n\nSurvival never tasted so good."
msgstr "<link=\"MEAT\">لحم</link> و<link=\"TALLOW\">شحم</link> مهروسان في قالب كثيف السعرات الحرارية ذي عمر افتراضي طويل للغاية.\n\nلم يكن البقاء على قيد الحياة بمثل هذا المذاق الرائع من قبل."

#. STRINGS.ITEMS.FOOD.PEMMICAN.NAME
msgctxt "STRINGS.ITEMS.FOOD.PEMMICAN.NAME"
msgid "<link=\"PEMMICAN\">Pemmican</link>"
msgstr "<link=\"PEMMICAN\">بيميكان</link>"

#. STRINGS.ITEMS.FOOD.PEMMICAN.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PEMMICAN.RECIPEDESC"
msgid "<link=\"MEAT\">Meat</link> and <link=\"TALLOW\">Tallow</link> pounded into a nutrient-dense brick with an exceptionally long shelf life."
msgstr "<link=\"MEAT\">لحم</link> و<link=\"TALLOW\">شحم</link> مهروسان في قالب كثيف المغذيات ذي عمر افتراضي طويل للغاية."

#. STRINGS.ITEMS.FOOD.PICKLEDMEAL.DESC
msgctxt "STRINGS.ITEMS.FOOD.PICKLEDMEAL.DESC"
msgid "Meal Lice preserved in vinegar.\n\nIt's a rarely acquired taste."
msgstr "يرقات الطعام محفوظة في الخل.\n\nإنها وجبة نادرة الاستساغة."

#. STRINGS.ITEMS.FOOD.PICKLEDMEAL.NAME
msgctxt "STRINGS.ITEMS.FOOD.PICKLEDMEAL.NAME"
msgid "<link=\"PICKLEDMEAL\">Pickled Meal</link>"
msgstr "<link=\"PICKLEDMEAL\">وجبة مخللة</link>"

#. STRINGS.ITEMS.FOOD.PICKLEDMEAL.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PICKLEDMEAL.RECIPEDESC"
msgid "<link=\"BASICPLANTFOOD\">Meal Lice</link> regrettably preserved in vinegar."
msgstr "<link=\"BASICPLANTFOOD\">يرقات الطعام</link> محفوظة للأسف في الخل."

#. STRINGS.ITEMS.FOOD.PLANTMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.PLANTMEAT.DESC"
msgid "Planty plant meat from a plant. How nice!"
msgstr "لحم نباتي من نبات. يا للروعة!"

#. STRINGS.ITEMS.FOOD.PLANTMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.PLANTMEAT.NAME"
msgid "<link=\"PLANTMEAT\">Plant Meat</link>"
msgstr "<link=\"PLANTMEAT\">لحم نباتي</link>"

#. STRINGS.ITEMS.FOOD.POPCORN.DESC
msgctxt "STRINGS.ITEMS.FOOD.POPCORN.DESC"
msgid "<link=\"COLDWHEATSEED\">Sleet Wheat Grain</link> popped in a <link=\"GAMMARAYOVEN\">Gamma Ray Oven</link>.\n\nCompletely devoid of any fancy flavorings."
msgstr "<link=\"COLDWHEATSEED\">حبوب قمح السلييت</link> مفرقعة في <link=\"GAMMARAYOVEN\">فرن أشعة غاما</link>.\n\nخالية تماماً من أي نكهات إضافية."

#. STRINGS.ITEMS.FOOD.POPCORN.NAME
msgctxt "STRINGS.ITEMS.FOOD.POPCORN.NAME"
msgid "<link=\"POPCORN\">Popcorn</link>"
msgstr "<link=\"POPCORN\">فشار</link>"

#. STRINGS.ITEMS.FOOD.POPCORN.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.POPCORN.RECIPEDESC"
msgid "Gamma-radiated <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>."
msgstr "<link=\"COLDWHEATSEED\">حبوب قمح السلييت</link> معالجة بأشعة غاما."

#. STRINGS.ITEMS.FOOD.PREHISTORICPACUFILLET.DESC
msgctxt "STRINGS.ITEMS.FOOD.PREHISTORICPACUFILLET.DESC"
msgid "An uncooked fillet from a very dead <link=\"PREHISTORICPACU\">Jawbo</link>. It has a silky texture."
msgstr "فيليه غير مطهو من <link=\"PREHISTORICPACU\">جوبو</link> ميت تماماً. يتميز بقوام حريري."

#. STRINGS.ITEMS.FOOD.PREHISTORICPACUFILLET.NAME
msgctxt "STRINGS.ITEMS.FOOD.PREHISTORICPACUFILLET.NAME"
msgid "<link=\"PREHISTORICPACUFILLET\">Jawbo Fillet</link>"
msgstr "<link=\"PREHISTORICPACUFILLET\">فيليه جوبو</link>"

#. STRINGS.ITEMS.FOOD.PRICKLEFRUIT.DESC
msgctxt "STRINGS.ITEMS.FOOD.PRICKLEFRUIT.DESC"
msgid "A sweet, mostly pleasant-tasting fruit covered in prickly barbs."
msgstr "فاكهة حلوة ذات مذاق لطيف في الغالب، مغطاة بأشواك حادة."

#. STRINGS.ITEMS.FOOD.PRICKLEFRUIT.NAME
msgctxt "STRINGS.ITEMS.FOOD.PRICKLEFRUIT.NAME"
msgid "<link=\"PRICKLEFRUIT\">Bristle Berry</link>"
msgstr "<link=\"PRICKLEFRUIT\">توت بريستل</link>"

#. STRINGS.ITEMS.FOOD.PUFTEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.PUFTEGG.DESC"
msgid "An egg laid by a <link=\"PUFT\">Puft</link>.\n\nIf incubated, it will hatch into a <link=\"PUFT\">Puftlet</link>."
msgstr "بيضة وضعتها <link=\"PUFT\">بافت</link>.\n\nإذا تم تحضينها، ستفقس لتصبح <link=\"PUFT\">بافتليت</link>."

#. STRINGS.ITEMS.FOOD.PUFTEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.PUFTEGG.NAME"
msgid "<link=\"PUFT\">Puft Egg</link>"
msgstr "<link=\"PUFT\">بيضة بافت</link>"

#. STRINGS.ITEMS.FOOD.PUFTEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PUFTEGG.RECIPEDESC"
msgid "An egg laid by a <link=\"PUFT\">Puft</link>."
msgstr "بيضة وضعتها <link=\"PUFT\">بافت</link>."

#. STRINGS.ITEMS.FOOD.QUICHE.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"QUICHE\">Mushroom Quiche</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "حصة <link=\"QUICHE\">كيش فطر</link> مجففة. يجب إعادة ترطيبها لكي تُعتبر <link=\"FOOD\">طعاماً</link>.\n\nالحصص الجافة ليس لها تاريخ انتهاء صلاحية."

#. STRINGS.ITEMS.FOOD.QUICHE.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.DEHYDRATED.NAME"
msgid "<link=\"QUICHE\">Dried Mushroom Quiche</link>"
msgstr "<link=\"QUICHE\">كيش فطر مجفف</link>"

#. STRINGS.ITEMS.FOOD.QUICHE.DESC
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.DESC"
msgid "<link=\"COOKEDEGG\">Omelette</link>, <link=\"FRIEDMUSHROOM\">Fried Mushroom</link> and <link=\"LETTUCE\">Lettuce</link> piled onto a yummy crust.\n\nSomehow, it's both soggy <i>and</i> crispy."
msgstr "<link=\"COOKEDEGG\">عجة</link>، و<link=\"FRIEDMUSHROOM\">فطر مقلي</link> و<link=\"LETTUCE\">خس</link> مكدسة فوق قشرة لذيذة.\n\nبطريقة ما، هي طرية <i>و</i> مقرمشة في آن واحد."

#. STRINGS.ITEMS.FOOD.QUICHE.NAME
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.NAME"
msgid "<link=\"QUICHE\">Mushroom Quiche</link>"
msgstr "<link=\"QUICHE\">كيش الفطر</link>"

#. STRINGS.ITEMS.FOOD.QUICHE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.RECIPEDESC"
msgid "<link=\"COOKEDEGG\">Omelette</link>, <link=\"FRIEDMUSHROOM\">Fried Mushroom</link> and <link=\"LETTUCE\">Lettuce</link> piled onto a yummy crust."
msgstr "<link=\"COOKEDEGG\">أومليت</link>، و<link=\"FRIEDMUSHROOM\">فطر مقلي</link> و<link=\"LETTUCE\">خس</link> مكدسة فوق قشرة لذيذة."

#. STRINGS.ITEMS.FOOD.RAWEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.RAWEGG.DESC"
msgid "A raw Egg that has been cracked open for use in <link=\"FOOD\">Food</link> preparation.\n\nIt will never hatch."
msgstr "بيضة نيئة تم كسرها لاستخدامها في تحضير <link=\"FOOD\">الطعام</link>.\n\nلن تفقس أبداً."

#. STRINGS.ITEMS.FOOD.RAWEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.RAWEGG.NAME"
msgid "<link=\"RAWEGG\">Raw Egg</link>"
msgstr "<link=\"RAWEGG\">بيضة نيئة</link>"

#. STRINGS.ITEMS.FOOD.RAWEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.RAWEGG.RECIPEDESC"
msgid "A raw egg that has been cracked open for use in <link=\"FOOD\">Food</link> preparation."
msgstr "بيضة نيئة تم كسرها لاستخدامها في تحضير <link=\"FOOD\">الطعام</link>."

#. STRINGS.ITEMS.FOOD.ROTPILE.DESC
msgctxt "STRINGS.ITEMS.FOOD.ROTPILE.DESC"
msgid "An inedible glop of former foodstuff.\n\n<link=\"COMPOST\">Rot Pile</link>s break down into <link=\"TOXICSAND\">Polluted Dirt</link> over time."
msgstr "كتلة غير صالحة للأكل من بقايا الطعام.\n\nتتحلل <link=\"COMPOST\">كومة العفن</link> إلى <link=\"TOXICSAND\">تربة ملوثة</link> بمرور الوقت."

#. STRINGS.ITEMS.FOOD.ROTPILE.NAME
msgctxt "STRINGS.ITEMS.FOOD.ROTPILE.NAME"
msgid "<link=\"COMPOST\">Rot Pile</link>"
msgstr "<link=\"COMPOST\">كومة العفن</link>"

#. STRINGS.ITEMS.FOOD.SALSA.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.SALSA.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"SALSA\">Stuffed Berry</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "حصة <link=\"SALSA\">توت محشو</link> مجففة. يجب إعادة ترطيبها لكي تُعتبر <link=\"FOOD\">طعاماً</link>.\n\nالحصص الجافة ليس لها تاريخ انتهاء صلاحية."

#. STRINGS.ITEMS.FOOD.SALSA.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.SALSA.DEHYDRATED.NAME"
msgid "<link=\"SALSA\">Dried Stuffed Berry</link>"
msgstr "<link=\"SALSA\">توت محشو مجفف</link>"

#. STRINGS.ITEMS.FOOD.SALSA.DESC
msgctxt "STRINGS.ITEMS.FOOD.SALSA.DESC"
msgid "A baked <link=\"PRICKLEFRUIT\">Bristle Berry</link> stuffed with delectable spices and vibrantly flavored."
msgstr "<link=\"PRICKLEFRUIT\">توت بريستل</link> مخبوز ومحشو بتوابل لذيذة وذو نكهة نابضة بالحياة."

#. STRINGS.ITEMS.FOOD.SALSA.NAME
msgctxt "STRINGS.ITEMS.FOOD.SALSA.NAME"
msgid "<link=\"SALSA\">Stuffed Berry</link>"
msgstr "<link=\"SALSA\">توت محشو</link>"

#. STRINGS.ITEMS.FOOD.SALSA.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SALSA.RECIPEDESC"
msgid "A baked <link=\"PRICKLEFRUIT\">Bristle Berry</link> stuffed with delectable spices and vibrantly flavored."
msgstr "<link=\"PRICKLEFRUIT\">توت بريستل</link> مخبوز ومحشو بتوابل لذيذة وذو نكهة نابضة بالحياة."

#. STRINGS.ITEMS.FOOD.SHELLFISHMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.SHELLFISHMEAT.DESC"
msgid "An uncooked chunk of very dead <link=\"CRABFRESHWATER\">Sanishell</link>. Yum!"
msgstr "قطعة غير مطبوخة من <link=\"CRABFRESHWATER\">سانشيل</link> ميتة جداً. لذيذ!"

#. STRINGS.ITEMS.FOOD.SHELLFISHMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.SHELLFISHMEAT.NAME"
msgid "<link=\"SHELLFISHMEAT\">Raw Shellfish</link>"
msgstr "<link=\"SHELLFISHMEAT\">محار نيء</link>"

#. STRINGS.ITEMS.FOOD.SMOKEDDINOSAURMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDDINOSAURMEAT.DESC"
msgid "A cooked stack of tough meat that's been marinated and slow-smoked to tender perfection."
msgstr "كومة مطبوخة من اللحم القاسي تم تتبيلها وتدخينها ببطء حتى تصل إلى درجة مثالية من الطراوة."

#. STRINGS.ITEMS.FOOD.SMOKEDDINOSAURMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDDINOSAURMEAT.NAME"
msgid "<link=\"SMOKEDDINOSAURMEAT\">Tender Brisket</link>"
msgstr "<link=\"SMOKEDDINOSAURMEAT\">لحم الصدر الطري</link>"

#. STRINGS.ITEMS.FOOD.SMOKEDDINOSAURMEAT.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDDINOSAURMEAT.RECIPEDESC"
msgid "A stack of tender, slow-smoked meat."
msgstr "كومة من اللحم الطري المدخن ببطء."

#. STRINGS.ITEMS.FOOD.SMOKEDFISH.DESC
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDFISH.DESC"
msgid "A buttery smoked fish fillet.\n\nIt flakes nicely when pulled apart with a fork."
msgstr "فيليه سمك مدخن زبدي.\n\nيتفتت بشكل جيد عند سحبه بشوكة."

#. STRINGS.ITEMS.FOOD.SMOKEDFISH.NAME
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDFISH.NAME"
msgid "<link=\"SMOKEDFISH\">Smoked Fish</link>"
msgstr "<link=\"SMOKEDFISH\">سمك مدخن</link>"

#. STRINGS.ITEMS.FOOD.SMOKEDFISH.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDFISH.RECIPEDESC"
msgid "A buttery smoked fish fillet."
msgstr "فيليه سمك مدخن زبدي."

#. STRINGS.ITEMS.FOOD.SMOKEDVEGETABLES.DESC
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDVEGETABLES.DESC"
msgid "Crisp vegetables stuffed with herbs and smoked for hours."
msgstr "خضروات منعشة محشوة بالأعشاب ومدخنة لساعات."

#. STRINGS.ITEMS.FOOD.SMOKEDVEGETABLES.NAME
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDVEGETABLES.NAME"
msgid "<link=\"SMOKEDVEGETABLES\">Veggie Poppers</link>"
msgstr "<link=\"SMOKEDVEGETABLES\">مقرمشات الخضار</link>"

#. STRINGS.ITEMS.FOOD.SMOKEDVEGETABLES.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SMOKEDVEGETABLES.RECIPEDESC"
msgid "Crisp vegetables stuffed with herbs."
msgstr "خضروات منعشة محشوة بالأعشاب."

#. STRINGS.ITEMS.FOOD.SPICEBREAD.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.SPICEBREAD.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"SPICEBREAD\">Pepper Bread</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "حصة <link=\"SPICEBREAD\">خبز الفلفل</link> مجففة. يجب إعادة ترطيبها لكي تُعتبر <link=\"FOOD\">طعاماً</link>.\n\nالحصص الجافة ليس لها تاريخ انتهاء صلاحية."

#. STRINGS.ITEMS.FOOD.SPICEBREAD.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.SPICEBREAD.DEHYDRATED.NAME"
msgid "<link=\"SPICEBREAD\">Dried Pepper Bread</link>"
msgstr "<link=\"SPICEBREAD\">خبز الفلفل المجفف</link>"

#. STRINGS.ITEMS.FOOD.SPICEBREAD.DESC
msgctxt "STRINGS.ITEMS.FOOD.SPICEBREAD.DESC"
msgid "A loaf of bread, lightly spiced with <link=\"SPICENUT\">Pincha Peppernut</link> for a mild bite.\n\nThere's a simple joy to be had in pulling it apart in one's fingers."
msgstr "رغيف خبز، متبل بخفة بـ <link=\"SPICENUT\">جوزة فلفل بينتشا</link> لإعطائه نكهة لاذعة خفيفة.\n\nهناك متعة بسيطة في تقطيعه بالأصابع."

#. STRINGS.ITEMS.FOOD.SPICEBREAD.NAME
msgctxt "STRINGS.ITEMS.FOOD.SPICEBREAD.NAME"
msgid "<link=\"SPICEBREAD\">Pepper Bread</link>"
msgstr "<link=\"SPICEBREAD\">خبز الفلفل</link>"

#. STRINGS.ITEMS.FOOD.SPICEBREAD.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SPICEBREAD.RECIPEDESC"
msgid "A loaf of bread, lightly spiced with <link=\"SPICENUT\">Pincha Peppernut</link> for a mild bite."
msgstr "رغيف خبز، متبل قليلاً بـ <link=\"SPICENUT\">جوزة فلفل بينتشا</link> لإضفاء نكهة لاذعة خفيفة."

#. STRINGS.ITEMS.FOOD.SPICENUT.DESC
msgctxt "STRINGS.ITEMS.FOOD.SPICENUT.DESC"
msgid "The flavorful nut of a <link=\"SPICEVINE\">Pincha Pepperplant</link>.\n\nThe bitter outer rind hides a rich, peppery core that is useful in cooking."
msgstr "جوزة لذيذة من <link=\"SPICEVINE\">نبات فلفل بينتشا</link>.\n\nتخفي القشرة الخارجية المرة لباً غنياً ولاذعاً مفيداً في الطهي."

#. STRINGS.ITEMS.FOOD.SPICENUT.NAME
msgctxt "STRINGS.ITEMS.FOOD.SPICENUT.NAME"
msgid "<link=\"SPICENUT\">Pincha Peppernut</link>"
msgstr "<link=\"SPICENUT\">جوزة فلفل بينتشا</link>"

#. STRINGS.ITEMS.FOOD.SPICYTOFU.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.SPICYTOFU.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"SPICYTOFU\">Spicy Tofu</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "حصة <link=\"SPICYTOFU\">توفو حار</link> مجففة. يجب إعادة ترطيبها لكي تُعتبر <link=\"FOOD\">طعاماً</link>.\n\nحصص الطعام الجافة ليس لها تاريخ انتهاء صلاحية."

#. STRINGS.ITEMS.FOOD.SPICYTOFU.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.SPICYTOFU.DEHYDRATED.NAME"
msgid "<link=\"SPICYTOFU\">Dried Spicy Tofu</link>"
msgstr "<link=\"SPICYTOFU\">توفو حار مجفف</link>"

#. STRINGS.ITEMS.FOOD.SPICYTOFU.DESC
msgctxt "STRINGS.ITEMS.FOOD.SPICYTOFU.DESC"
msgid "<link=\"TOFU\">Tofu</link> marinated in a flavorful <link=\"SPICENUT\">Pincha Peppernut</link> sauce.\n\nIt packs a delightful punch."
msgstr "<link=\"TOFU\">توفو</link> متبل في صلصة <link=\"SPICENUT\">جوزة فلفل بينتشا</link> اللذيذة.\n\nإنها تمنح نكهة قوية وممتعة."

#. STRINGS.ITEMS.FOOD.SPICYTOFU.NAME
msgctxt "STRINGS.ITEMS.FOOD.SPICYTOFU.NAME"
msgid "<link=\"SPICYTOFU\">Spicy Tofu</link>"
msgstr "<link=\"SPICYTOFU\">توفو حار</link>"

#. STRINGS.ITEMS.FOOD.SPICYTOFU.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SPICYTOFU.RECIPEDESC"
msgid "<link=\"TOFU\">Tofu</link> marinated in a flavorful <link=\"SPICENUT\">Pincha Peppernut</link> sauce."
msgstr "<link=\"TOFU\">توفو</link> متبل في صلصة <link=\"SPICENUT\">جوزة فلفل بينتشا</link> اللذيذة."

#. STRINGS.ITEMS.FOOD.SURFANDTURF.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.SURFANDTURF.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"SURFANDTURF\">Surf'n'Turf</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "حصة <link=\"SURFANDTURF\">طعام البر والبحر</link> مجففة. يجب إعادة ترطيبها لكي تُعتبر <link=\"FOOD\">طعاماً</link>.\n\nحصص الطعام الجافة ليس لها تاريخ انتهاء صلاحية."

#. STRINGS.ITEMS.FOOD.SURFANDTURF.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.SURFANDTURF.DEHYDRATED.NAME"
msgid "<link=\"SURFANDTURF\">Dried Surf'n'Turf</link>"
msgstr "<link=\"SURFANDTURF\">طعام البر والبحر مجفف</link>"

#. STRINGS.ITEMS.FOOD.SURFANDTURF.DESC
msgctxt "STRINGS.ITEMS.FOOD.SURFANDTURF.DESC"
msgid "A bit of <link=\"MEAT\">Meat</link> from the land and <link=\"COOKEDFISH\">Cooked Seafood</link> from the sea.\n\nIt's hearty and satisfying."
msgstr "القليل من <link=\"MEAT\">لحم</link> من البر و<link=\"COOKEDFISH\">مأكولات بحرية مطهية</link> من البحر.\n\nإنها وجبة مشبعة ومرضية."

#. STRINGS.ITEMS.FOOD.SURFANDTURF.NAME
msgctxt "STRINGS.ITEMS.FOOD.SURFANDTURF.NAME"
msgid "<link=\"SURFANDTURF\">Surf'n'Turf</link>"
msgstr "<link=\"SURFANDTURF\">طعام البر والبحر</link>"

#. STRINGS.ITEMS.FOOD.SURFANDTURF.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SURFANDTURF.RECIPEDESC"
msgid "A bit of <link=\"MEAT\">Meat</link> from the land and <link=\"COOKEDFISH\">Cooked Seafood</link> from the sea."
msgstr "القليل من <link=\"MEAT\">لحم</link> من البر و<link=\"COOKEDFISH\">مأكولات بحرية مطهية</link> من البحر."

#. STRINGS.ITEMS.FOOD.SUSHI.DESC
msgctxt "STRINGS.ITEMS.FOOD.SUSHI.DESC"
msgid "Raw <link=\"FISHMEAT\">Pacu Fillet</link> wrapped with fresh <link=\"LETTUCE\">Lettuce</link>.\n\nWhile the salt of the lettuce may initially overpower the flavor, a keen palate can discern the subtle sweetness of the fillet beneath."
msgstr "<link=\"FISHMEAT\">فيليه باكو</link> نيء ملفوف بـ <link=\"LETTUCE\">خس</link> طازج.\n\nبينما قد يطغى ملح الخس على النكهة في البداية، يمكن للذواقة تمييز الحلاوة الخفيفة للفيليه تحتها."

#. STRINGS.ITEMS.FOOD.SUSHI.NAME
msgctxt "STRINGS.ITEMS.FOOD.SUSHI.NAME"
msgid "<link=\"SUSHI\">Sushi</link>"
msgstr "<link=\"SUSHI\">سوشي</link>"

#. STRINGS.ITEMS.FOOD.SUSHI.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SUSHI.RECIPEDESC"
msgid "Raw <link=\"FISHMEAT\">Pacu Fillet</link> wrapped with fresh <link=\"LETTUCE\">Lettuce</link>."
msgstr "<link=\"FISHMEAT\">فيليه باكو</link> نيء ملفوف بـ <link=\"LETTUCE\">خس</link> طازج."

#. STRINGS.ITEMS.FOOD.SWAMPDELIGHTS.DESC
msgctxt "STRINGS.ITEMS.FOOD.SWAMPDELIGHTS.DESC"
msgid "Dried gelatinous cubes from a <link=\"SWAMPFRUIT\">Bog Jelly</link>.\n\nEach cube has a wonderfully chewy texture and is lightly coated in a delicate powder."
msgstr "مكعبات هلامية مجففة من <link=\"SWAMPFRUIT\">هلام المستنقع</link>.\n\nكل مكعب له قوام مطاطي رائع ومغطى بطبقة خفيفة من مسحوق دقيق."

#. STRINGS.ITEMS.FOOD.SWAMPDELIGHTS.NAME
