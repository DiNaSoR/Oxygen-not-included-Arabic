msgid "<link=\"WORMSUPERFOOD\">Grubfruit Preserve</link>"
msgstr "<link=\"WORMSUPERFOOD\">مربى غراب الفاكهة</link>"

#. STRINGS.ITEMS.FOOD.WORMSUPERFOOD.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.WORMSUPERFOOD.RECIPEDESC"
msgid "A long lasting <link=\"WORMSUPERFRUIT\">Grubfruit</link> jam preserved in <link=\"SUCROSE\">Sucrose</link>."
msgstr "مربى <link=\"WORMSUPERFRUIT\">غراب فاكهة</link> طويل الأمد محفوظ في <link=\"SUCROSE\">سكروز</link>."

