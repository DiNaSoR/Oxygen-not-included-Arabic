msgctxt "STRINGS.BUILDINGS.PREFABS.FLUSHTOILET.EFFECT"
msgid "Gives Duplicants a place to relieve themselves.\n\nSpreads very few <link=\"DISEASE\">Germs</link>."
msgstr "تمنح المكررين مكاناً لتخفيف حاجتهم.\n\nتنشر عدداً قليلاً جداً من <link=\"DISEASE\">الجراثيم</link>."

#. STRINGS.BUILDINGS.PREFABS.FLUSHTOILET.FACADES.BLUE_BABYTEARS.DESC
