msgctxt "STRINGS.ITEMS.FOOD.WORMBASICFOOD.DESC"
msgid "Slow roasted <link=\"WORMBASICFRUIT\">Spindly Grubfruit</link>.\n\nIt has a smoky aroma and tastes of coziness."
msgstr "<link=\"WORMBASICFRUIT\">غراب فروت دقيق</link> محمص ببطء.\n\nله رائحة دخانية ومذاق يبعث على الراحة."

