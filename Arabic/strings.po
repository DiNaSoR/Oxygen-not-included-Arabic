msgctxt "STRINGS.ROOMS.TYPES.NEUTRAL.NAME"
msgid "Miscellaneous Room"
msgstr "غرفة متنوعة"

#. STRINGS.ROOMS.TYPES.NEUTRAL.TOOLTIP
msgctxt "STRINGS.ROOMS.TYPES.NEUTRAL.TOOLTIP"
msgid "This area has walls and doors but no dedicated use"
msgstr "تحتوي هذه المنطقة على جدران وأبواب ولكن ليس لها استخدام مخصص"

#. STRINGS.ROOMS.TYPES.PARK.DESCRIPTION
msgctxt "STRINGS.ROOMS.TYPES.PARK.DESCRIPTION"
msgid "A little greenery goes a long way.\n\nPassing through natural spaces throughout the day will raise the Morale of Duplicants."
msgstr "القليل من المساحات الخضراء يقطع شوطاً طويلاً.\n\nالمرور عبر المساحات الطبيعية طوال اليوم سيرفع معنويات المكررين."

#. STRINGS.ROOMS.TYPES.PARK.EFFECT
msgctxt "STRINGS.ROOMS.TYPES.PARK.EFFECT"
msgid "- Morale bonus"
msgstr "- مكافأة معنويات"

#. STRINGS.ROOMS.TYPES.PARK.NAME
