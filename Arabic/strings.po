msgstr "شاشة إلكترونية"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY3.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY3.DESC"
msgid "An electronic display projecting the blueprint of a strange device.\n\nPerhaps these displays were used to entice visitors."
msgstr "شاشة إلكترونية تعرض مخطط جهاز غريب.\n\nربما استُخدمت هذه الشاشات لجذب الزوار."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY3.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY3.NAME"
msgid "Electronic Display"
msgstr "شاشة إلكترونية"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYGLOBEDROORS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYGLOBEDROORS.DESC"
msgid "A filing cabinet for storing hard copy employee records.\n\nThe contents have been shredded."
msgstr "خزانة ملفات لتخزين سجلات الموظفين الورقية.\n\nتم تمزيق المحتويات."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYGLOBEDROORS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYGLOBEDROORS.NAME"
msgid "Filing Cabinet"
msgstr "خزانة ملفات"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYLAMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYLAMP.DESC"
msgid "A long light fixture that hangs from the ceiling.\n\nIt does not appear to function."
msgstr "تركيبة إضاءة طويلة تتدلى من السقف.\n\nلا يبدو أنها تعمل."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYLAMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYLAMP.NAME"
msgid "Light Fixture"
msgstr "تركيبة إضاءة"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYPAINTING.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYPAINTING.DESC"
msgid "A painting featuring a copse of fir trees and a magnificent mountain range on the horizon.\n\nThe air in the room prickles with the sensation that I'm not meant to be here."
msgstr "لوحة فنية تصور مجموعة من أشجار التنوب وسلسلة جبلية رائعة في الأفق.\n\nيخز الهواء في الغرفة بإحساس أنني لست مقصوداً بالتواجد هنا."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYPAINTING.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYPAINTING.NAME"
msgid "Landscape Portrait"
msgstr "صورة طبيعية"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYSTATUE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYSTATUE.DESC"
msgid "A large, modern sculpture that sits in the center of the lobby.\n\nIt's an artistic cross between an hourglass shape and a double helix."
msgstr "منحوتة حديثة كبيرة تقع في وسط الردهة.\n\nإنها مزيج فني بين شكل الساعة الرملية واللولب المزدوج."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYSTATUE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYSTATUE.NAME"
msgid "Gravitas Monument"
msgstr "نصب غرافيتاس التذكاري"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYTABLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYTABLE.DESC"
msgid "A low coffee table that may have once held old science magazines."
msgstr "طاولة قهوة منخفضة ربما كانت تحمل يوماً ما مجلات علمية قديمة."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYTABLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYTABLE.NAME"
msgid "Coffee Table"
msgstr "طاولة قهوة"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYTALLPLANT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYTALLPLANT.DESC"
msgid "It's survived the vacuum of space by virtue of being plastic."
msgstr "لقد نجا من فراغ الفضاء بفضل كونه مصنوعاً من البلاستيك."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYTALLPLANT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYTALLPLANT.NAME"
msgid "Office Plant"
msgstr "نبات مكتبي"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYWALLDEGREE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYWALLDEGREE.DESC"
msgid "Certification in Applied Physics, awarded in recognition of one \"Jacquelyn A. Stern\"."
msgstr "شهادة في الفيزياء التطبيقية، مُنحت تقديراً لـ \"جاكلين أ. ستيرن\"."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYWALLDEGREE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYWALLDEGREE.NAME"
msgid "Doctorate Degree"
msgstr "شهادة دكتوراه"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMMIRROR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMMIRROR.DESC"
msgid "A one-way mirror and shelf.\n\nThe skincare products still smell faintly of shea butter."
msgstr "مرآة ذات اتجاه واحد ورف.\n\nلا تزال منتجات العناية بالبشرة تفوح منها رائحة زبدة الشيا الخافتة."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMMIRROR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMMIRROR.NAME"
msgid "Mirror"
msgstr "مرآة"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMSINK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMSINK.DESC"
msgid "A handwashing station that looks suspiciously under-utilized.\n\nIt was once part of a bulk office order."
msgstr "محطة غسل يدين تبدو غير مستغلة بشكل مريب.\n\nكانت في السابق جزءاً من طلبية مكتبية كبيرة."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMSINK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMSINK.NAME"
msgid "Enamel Sink"
msgstr "مغسلة مينا"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMTOILETPAPERHOLDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMTOILETPAPERHOLDER.DESC"
msgid "It holds one roll of sanitary paper.\n\nThe sheets are single-ply."
msgstr "تحمل لفة واحدة من الورق الصحي.\n\nالأوراق ذات طبقة واحدة."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMTOILETPAPERHOLDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASBATHROOMTOILETPAPERHOLDER.NAME"
msgid "Toilet Paper Holder"
msgstr "حامل ورق المرحاض"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGLIGHT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGLIGHT.DESC"
msgid "A flush mount ceiling light that no longer functions.\n\nThere's dust inside."
msgstr "مصباح سقف مدمج لم يعد يعمل.\n\nيوجد غبار بالداخل."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGLIGHT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGLIGHT.NAME"
msgid "Light Fixture"
msgstr "تجهيزة إضاءة"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGROBOT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGROBOT.DESC"
msgid "Non-functioning robotic arms that once assisted lab technicians."
msgstr "أذرع آلية غير عاملة كانت تساعد فنيي المختبر في السابق."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGROBOT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGROBOT.NAME"
msgid "Ceiling Robot"
msgstr "روبوت سقف"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCLOCKSQUARE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCLOCKSQUARE.DESC"
msgid "A square wall clock.\n\nIt's quite damaged."
msgstr "ساعة حائط مربعة.\n\nإنها متضررة للغاية."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCLOCKSQUARE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCLOCKSQUARE.NAME"
msgid "Clock"
msgstr "ساعة"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCREATUREPOSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCREATUREPOSTER.DESC"
msgid "An anatomical illustration of the very first <link=\"HATCH\">Hatch</link> ever produced.\n\nWhile the ratio of egg sac to brain may appear outlandish, it is in fact to scale."
msgstr "رسم تشريحي لأول <link=\"HATCH\">هاتش</link> تم إنتاجه على الإطلاق.\n\nعلى الرغم من أن نسبة كيس البيض إلى الدماغ قد تبدو غريبة، إلا أنها في الواقع مطابقة للمقياس."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCREATUREPOSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCREATUREPOSTER.NAME"
msgid "Anatomy Poster"
msgstr "ملصق تشريح"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDECORATIVEWINDOW.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDECORATIVEWINDOW.DESC"
msgid "A tall, thin window which once pointed to a courtyard."
msgstr "نافذة طويلة ورفيعة كانت تطل ذات يوم على فناء."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDECORATIVEWINDOW.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDECORATIVEWINDOW.NAME"
msgid "Window"
msgstr "نافذة"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESK.DESC"
msgid "The unkempt workspace of a long-departed scientist who expected to return."
msgstr "مساحة عمل غير مرتبة لعالم رحل منذ فترة طويلة وكان يتوقع العودة."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESK.NAME"
msgid "Biophysics Research Desk"
msgstr "مكتب أبحاث الفيزياء الحيوية"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESKPODIUM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESKPODIUM.DESC"
msgid "A clutter-proof desk to minimize distractions.\n\nThere appears to be something stored in the computer."
msgstr "مكتب مقاوم للفوضى لتقليل المشتتات.\n\nيبدو أن هناك شيئاً مخزناً في الحاسوب."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESKPODIUM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESKPODIUM.NAME"
msgid "Computer Podium"
msgstr "منصة حاسوب"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDISPLAY4.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDISPLAY4.DESC"
