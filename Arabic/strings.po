#. STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DESC"
msgid "Dew Drippers produce <link=\"DEWDRIP\">Dewdrips</link> that can be crushed into <link=\"MILK\">Brackene</link>."
msgstr "تنتج قطارات الندى <link=\"DEWDRIP\">قطرات الندى</link> التي يمكن سحقها لتحويلها إلى <link=\"MILK\">براكين</link>."

#. STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.DOMESTICATEDDESC"
msgid "This plant produces <link=\"MILK\">Brackene</link>."
msgstr "هذا النبات ينتج <link=\"MILK\">براكين</link>."

#. STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DEWDRIPPERPLANT.NAME"
msgid "<link=\"DEWDRIPPERPLANT\">Dew Dripper</link>"
msgstr "<link=\"DEWDRIPPERPLANT\">قطارة الندى</link>"

#. STRINGS.CREATURES.SPECIES.DIESELMOO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIESELMOO.DESC"
msgid "Husky Moos are extraterrestrial critters that feed on <link=\"PLANTFIBER\">Plant Husk</link> and <link=\"GASGRASS\">Gas Grass</link>, and excrete <link=\"CARBONDIOXIDE\">Carbon Dioxide</link>.\n\nWhen domesticated and fed, they can be milked for <link=\"REFINEDLIPID\">Biodiesel</link>."
msgstr "مخلوقات مو هاسكي هي مخلوقات فضائية تتغذى على <link=\"PLANTFIBER\">قشور النبات</link> و<link=\"GASGRASS\">عشب الغاز</link>، وتفرز <link=\"CARBONDIOXIDE\">ثاني أكسيد الكربون</link>.\n\nعند استئناسها وإطعامها، يمكن حلبها للحصول على <link=\"REFINEDLIPID\">وقود حيوي</link>."

#. STRINGS.CREATURES.SPECIES.DIESELMOO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIESELMOO.NAME"
msgid "<link=\"DIESELMOO\">Husky Moo</link>"
msgstr "<link=\"DIESELMOO\">مو هاسكي</link>"

#. STRINGS.CREATURES.SPECIES.DINOFERN.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DINOFERN.DESC"
msgid "Megafronds produce <link=\"FERNFOOD\">Megafrond Grain</link>, an ancient grain that can be processed into <link=\"FOOD\">Food</link>."
msgstr "تنتج الميغافروند <link=\"FERNFOOD\">حبوب الميغافروند</link>، وهي حبوب قديمة يمكن معالجتها لتحويلها إلى <link=\"FOOD\">طعام</link>."

#. STRINGS.CREATURES.SPECIES.DINOFERN.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.DINOFERN.DOMESTICATEDDESC"
msgid "This plant produces <link=\"FERNFOOD\">Megafrond Grain</link>."
msgstr "هذا النبات ينتج <link=\"FERNFOOD\">حبوب الميغافروند</link>."

#. STRINGS.CREATURES.SPECIES.DINOFERN.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DINOFERN.NAME"
msgid "<link=\"DINOFERN\">Megafrond</link>"
msgstr "<link=\"DINOFERN\">ميغافروند</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.DESC"
msgid "A crawly little Sweetle Larva.\n\nIn time, it will mature into an adult <link=\"DIVERGENTBEETLE\">Sweetle</link>."
msgstr "يرقة سويتيل صغيرة زاحفة.\n\nمع مرور الوقت، ستنضج لتصبح <link=\"DIVERGENTBEETLE\">سويتيل</link> بالغة."

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.BABY.NAME"
msgid "<link=\"DIVERGENTBEETLE\">Sweetle Larva</link>"
msgstr "<link=\"DIVERGENTBEETLE\">يرقة سويتيل</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.DESC"
msgid "Sweetles are nonhostile critters that excrete large amounts of <link=\"SUCROSE\">Sucrose</link>.\n\nThey are closely related to the <link=\"DIVERGENTWORM\">Grubgrub</link> and exhibit similar, albeit less effective farming behaviors."
msgstr "السويتيل هي مخلوقات غير عدائية تفرز كميات كبيرة من <link=\"SUCROSE\">السكروز</link>.\n\nوهي مرتبطة ارتباطاً وثيقاً بـ <link=\"DIVERGENTWORM\">الغروبغروب</link> وتظهر سلوكيات زراعية مماثلة، وإن كانت أقل فعالية."

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.EGG_NAME"
msgid "<link=\"DIVERGENTBEETLE\">Sweetle Egg</link>"
msgstr "<link=\"DIVERGENTBEETLE\">بيضة سويتيل</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_BEETLE.NAME"
msgid "<link=\"DIVERGENTBEETLE\">Sweetle</link>"
msgstr "<link=\"DIVERGENTBEETLE\">سويتيل</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.DESC"
msgid "A squirmy little Grubgrub Wormling.\n\nIn time, it will mature into an adult <link=\"WORM\">Grubgrub</link> and drastically grow in size."
msgstr "يرقة غروبغروب صغيرة متلوية.\n\nمع مرور الوقت، ستنضج لتصبح <link=\"WORM\">غروبغروب</link> بالغة ويزداد حجمها بشكل كبير."

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.BABY.NAME"
msgid "<link=\"DIVERGENTWORM\">Grubgrub Wormling</link>"
msgstr "<link=\"DIVERGENTWORM\">يرقة غروبغروب</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.DESC"
msgid "Grubgrubs form symbiotic relationships with plants, especially <link=\"WORMPLANT\">Grubfruit Plants</link>, and instinctually tend to them.\n\nGrubgrubs are closely related to <link=\"DIVERGENTBEETLE\">Sweetles</link>."
msgstr "تشكل الغروبغروب علاقات تكافلية مع النباتات، وخاصة <link=\"WORMPLANT\">نباتات فاكهة اليرقات</link>، وتعتني بها غريزياً.\n\nالغروبغروب مرتبطة ارتباطاً وثيقاً بـ <link=\"DIVERGENTBEETLE\">السويتيل</link>."

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.EGG_NAME"
msgid "<link=\"DIVERGENTWORM\">Grubgrub Egg</link>"
msgstr "<link=\"DIVERGENTWORM\">بيضة غروبغروب</link>"

#. STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DIVERGENT.VARIANT_WORM.NAME"
msgid "<link=\"DIVERGENTWORM\">Grubgrub</link>"
msgstr "<link=\"DIVERGENTWORM\">غروبغروب</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.BABY.DESC"
msgid "A little, bug-eyed Drecklet.\n\nIn time it will mature into a fully grown <link=\"DRECKO\">Drecko</link>."
msgstr "دريكليت صغير جاحظ العينين.\n\nمع مرور الوقت سينضج ليصبح <link=\"DRECKO\">دريكو</link> كامل النمو."

#. STRINGS.CREATURES.SPECIES.DRECKO.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.BABY.NAME"
msgid "<link=\"DRECKO\">Drecklet</link>"
msgstr "<link=\"DRECKO\">دريكليت</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.DESC"
msgid "Dreckos are nonhostile critters that graze on <link=\"SPICEVINE\">Pincha Pepperplants</link>, <link=\"SWAMPLILY\">Balm Lily</link> or <link=\"BASICSINGLEHARVESTPLANT\">Mealwood Plants</link>.\n\nTheir backsides are covered in thick woolly fibers that only grow in <link=\"HYDROGEN\">Hydrogen</link> climates."
msgstr "الدريكو هي مخلوقات غير عدائية ترعى على <link=\"SPICEVINE\">نباتات فلفل بينتشا</link>، أو <link=\"SWAMPLILY\">زنبق البلسم</link>، أو <link=\"BASICSINGLEHARVESTPLANT\">نباتات الميلوود</link>.\n\nتغطى ظهورها بألياف صوفية سميكة لا تنمو إلا في مناخات <link=\"HYDROGEN\">الهيدروجين</link>."

#. STRINGS.CREATURES.SPECIES.DRECKO.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.EGG_NAME"
msgid "<link=\"DRECKO\">Drecko Egg</link>"
msgstr "<link=\"DRECKO\">بيضة دريكو</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.NAME"
msgid "<link=\"DRECKO\">Drecko</link>"
msgstr "<link=\"DRECKO\">دريكو</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.DESC"
msgid "A bug-eyed little Glossy Drecklet.\n\nIn time it will mature into an adult Drecko morph, the <link=\"DRECKOPLASTIC\">Glossy Drecko</link>."
msgstr "دريكليت لامع صغير جاحظ العينين.\n\nمع مرور الوقت سينضج ليصبح دريكو متحولاً بالغاً، وهو <link=\"DRECKOPLASTIC\">الدريكو اللامع</link>."

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.BABY.NAME"
msgid "<link=\"DRECKOPLASTIC\">Glossy Drecklet</link>"
msgstr "<link=\"DRECKOPLASTIC\">دريكليت لامع</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.DESC
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.DESC"
msgid "Glossy Dreckos are nonhostile critters that graze on live <link=\"BASICSINGLEHARVESTPLANT\">Mealwood Plants</link> and <link=\"PRICKLEFLOWER\">Bristle Blossoms</link>.\n\nTheir backsides are covered in bioplastic scales that only grow in <link=\"HYDROGEN\">Hydrogen Gas</link> climates."
msgstr "دريكو اللامع هي مخلوقات غير عدائية تتغذى على <link=\"BASICSINGLEHARVESTPLANT\">نباتات الميلوود</link> و<link=\"PRICKLEFLOWER\">زهور الشوك</link> الحية.\n\nتتغطى ظهورها بحراشف بلاستيكية حيوية لا تنمو إلا في مناخات <link=\"HYDROGEN\">غاز الهيدروجين</link>."

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.EGG_NAME"
msgid "<link=\"DRECKOPLASTIC\">Glossy Drecko Egg</link>"
msgstr "<link=\"DRECKOPLASTIC\">بيضة دريكو لامع</link>"

#. STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.NAME
msgctxt "STRINGS.CREATURES.SPECIES.DRECKO.VARIANT_PLASTIC.NAME"
msgid "<link=\"DRECKOPLASTIC\">Glossy Drecko</link>"
msgstr "<link=\"DRECKOPLASTIC\">دريكو لامع</link>"

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.DESC"
msgid "Sporechids have an eerily alluring appearance to mask the fact that they host particularly nasty strain of brain fungus."
msgstr "تتمتع نباتات سبوركيد بمظهر جذاب بشكل مخيف لإخفاء حقيقة أنها تستضيف سلالة سيئة بشكل خاص من فطر الدماغ."

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link> but produces high quantities of <link=\"ZOMBIESPORES\">Zombie Spores</link>."
msgstr "هذا النبات يحسن <link=\"DECOR\">الديكور</link> المحيط ولكنه ينتج كميات كبيرة من <link=\"ZOMBIESPORES\">أبواغ الزومبي</link>."

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "مكافأة النمو"

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.NAME"
msgid "<link=\"EVILFLOWER\">Sporechid</link>"
msgstr "<link=\"EVILFLOWER\">سبوركيد</link>"

#. STRINGS.CREATURES.SPECIES.EVILFLOWER.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.EVILFLOWER.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "عقوبة الذبول"

#. STRINGS.CREATURES.SPECIES.FILTERPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.FILTERPLANT.DESC"
msgid "Hydrocacti act as natural <link=\"WATER\">Water</link> filters when given access to <link=\"SAND\">Sand</link>."
msgstr "تعمل نباتات هيدروكاكتوس كفلاتر طبيعية لـ <link=\"WATER\">الماء</link> عند منحها إمكانية الوصول إلى <link=\"SAND\">الرمل</link>."

#. STRINGS.CREATURES.SPECIES.FILTERPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.FILTERPLANT.DOMESTICATEDDESC"
msgid "This plant uses <link=\"SAND\">Sand</link> to convert <link=\"DIRTYWATER\">Polluted Water</link> into <link=\"WATER\">Water</link>."
msgstr "يستخدم هذا النبات <link=\"SAND\">الرمل</link> لتحويل <link=\"DIRTYWATER\">المياه الملوثة</link> إلى <link=\"WATER\">ماء</link>."

#. STRINGS.CREATURES.SPECIES.FILTERPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.FILTERPLANT.NAME"
msgid "<link=\"FILTERPLANT\">Hydrocactus</link>"
msgstr "<link=\"FILTERPLANT\">هيدروكاكتوس</link>"

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.DESC"
msgid "Lura plants are carnivorous plants that trap flying critters, such as <link=\"MOSQUITO\">Gnits</link>.\n\nTheir digestive processes produce harvestable <link=\"AMBER\">Amber</link>."
msgstr "نباتات لورا هي نباتات آكلة للحوم تحبس المخلوقات الطائرة، مثل <link=\"MOSQUITO\">الغنيت</link>.\n\nتنتج عمليات الهضم الخاصة بها <link=\"AMBER\">كهرمان</link> قابل للحصاد."

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.DOMESTICATEDDESC"
msgid "This plant produces <link=\"NATURALRESIN\">Resin</link>."
msgstr "ينتج هذا النبات <link=\"NATURALRESIN\">راتنج</link>."

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.HUNGRY
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.HUNGRY"
msgid "Hungry"
msgstr "جائع"

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.NAME"
msgid "<link=\"FLYTRAPPLANT\">Lura Plant</link>"
msgstr "<link=\"FLYTRAPPLANT\">نبات لورا</link>"

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.PLANT_HUNGER_REQUIREMENT
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.PLANT_HUNGER_REQUIREMENT"
msgid "Carnivorous Diet"
msgstr "نظام غذائي آكل للحوم"

#. STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.VICTIM_IDENTIFIER
msgctxt "STRINGS.CREATURES.SPECIES.FLYTRAPPLANT.VICTIM_IDENTIFIER"
msgid "Airborne Critters"
msgstr "مخلوقات محمولة جواً"

#. STRINGS.CREATURES.SPECIES.FORESTFORAGEPLANTPLANTED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.FORESTFORAGEPLANTPLANTED.DESC"
msgid "Hexalents are incapable of propagating but can be harvested for a single, calorie dense <link=\"FOOD\">Food</link> serving."
msgstr "نباتات هيكسالينت غير قادرة على التكاثر ولكن يمكن حصادها للحصول على حصة واحدة من <link=\"FOOD\">طعام</link> كثيفة السعرات الحرارية."

#. STRINGS.CREATURES.SPECIES.FORESTFORAGEPLANTPLANTED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.FORESTFORAGEPLANTPLANTED.NAME"
msgid "<link=\"FORESTFORAGEPLANTPLANTED\">Hexalent</link>"
msgstr "<link=\"FORESTFORAGEPLANTPLANTED\">هيكسالينت</link>"

#. STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.DESC"
msgid "Ring Rosebushes are <link=\"DECOR\">Decorative</link> <link=\"PLANTS\">Plants</link> that add a touch of whimsy wherever they are planted."
msgstr "شجيرات الورد الحلقية هي <link=\"DECOR\">نباتات</link> <link=\"PLANTS\">تزيينية</link> تضفي لمسة من الغرابة أينما تمت زراعتها."

#. STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "هذا النبات يحسن <link=\"DECOR\">الديكور</link> المحيط."

#. STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "مكافأة النمو"

#. STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.NAME"
msgid "<link=\"GARDENDECORPLANT\">Ring Rosebush</link>"
msgstr "<link=\"GARDENDECORPLANT\">شجيرة الورد الحلقية</link>"

#. STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.GARDENDECORPLANT.WILT_PENALTY"
