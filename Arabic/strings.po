msgstr "تبطئ تحلل الأطعمة القابلة للتلف."

#. STRINGS.ITEMS.SPICES.PRESERVING_SPICE.NAME
msgctxt "STRINGS.ITEMS.SPICES.PRESERVING_SPICE.NAME"
msgid "<link=\"PRESERVINGSPICE\">Freshener Spice</link>"
msgstr "<link=\"PRESERVINGSPICE\">توابل الانتعاش</link>"

#. STRINGS.ITEMS.SPICES.STRENGTH_SPICE.DESC
msgctxt "STRINGS.ITEMS.SPICES.STRENGTH_SPICE.DESC"
msgid "Strengthens even the weakest of muscles."
msgstr "تقوي حتى أضعف العضلات."

#. STRINGS.ITEMS.SPICES.STRENGTH_SPICE.NAME
msgctxt "STRINGS.ITEMS.SPICES.STRENGTH_SPICE.NAME"
msgid "<link=\"STRENGTHSPICE\">Brawny Spice</link>"
msgstr "<link=\"STRENGTHSPICE\">توابل القوة</link>"

#. STRINGS.ITEMS.TALLOWLUBRICATIONSTICK.DESC
msgctxt "STRINGS.ITEMS.TALLOWLUBRICATIONSTICK.DESC"
msgid "Provides a small amount of extra-silky lubricating <link=\"LUBRICATINGOIL\">Gear Oil</link>.\n\nCan be produced at the <link=\"APOTHECARY\">Apothecary</link>."
msgstr "توفر كمية صغيرة من <link=\"LUBRICATINGOIL\">زيت التروس</link> المزلق فائق النعومة.\n\nيمكن إنتاجه في <link=\"APOTHECARY\">الصيدلية</link>."

#. STRINGS.ITEMS.TALLOWLUBRICATIONSTICK.NAME
