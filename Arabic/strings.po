msgstr "<link=\"FLUSHTOILET\">مرحاض النقاط الاحتفالية</link>"

#. STRINGS.BUILDINGS.PREFABS.FLUSHTOILET.FACADES.POLKA_DARKPURPLERESIN.DESC
