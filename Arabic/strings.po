msgid "<link=\"JUNGLEGASPLANT\">Palmera Tree</link>"
msgstr "<link=\"JUNGLEGASPLANT\">شجرة بالميرا</link>"

#. STRINGS.CREATURES.SPECIES.KELPPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.KELPPLANT.DESC"
msgid "Seakombs consume <link=\"TOXICSAND\">Polluted Dirt</link>.\n\nTheir leaves can be processed to extract <link=\"PHYTOOIL\">Phyto Oil</link>."
msgstr "تستهلك السيكومب <link=\"TOXICSAND\">تربة ملوثة</link>.\n\nيمكن معالجة أوراقها لاستخراج <link=\"PHYTOOIL\">زيت نباتي</link>."

#. STRINGS.CREATURES.SPECIES.KELPPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.KELPPLANT.DOMESTICATEDDESC"
msgid "This plant produces <link=\"KELP\">Seakomb Leaf</link>."
msgstr "هذا النبات ينتج <link=\"KELP\">ورقة سيكومب</link>."

