msgstr "على اليمين"

#. STRINGS.BUILDINGS.PREFABS.EGGCRACKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGCRACKER.DESC"
msgid "Raw eggs are an ingredient in certain high quality food recipes."
msgstr "البيض النيء هو أحد مكونات وصفات الطعام عالية الجودة."

#. STRINGS.BUILDINGS.PREFABS.EGGCRACKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGCRACKER.EFFECT"
msgid "Converts viable <link=\"CREATURES\">Critter</link> eggs into cooking ingredients.\n\nCracked Eggs cannot hatch.\n\nDuplicants will not crack eggs unless tasks are queued."
msgstr "يحول بيض <link=\"CREATURES\">المخلوقات</link> القابل للحياة إلى مكونات طهي.\n\nلا يمكن للبيض المكسور أن يفقس.\n\nلن يقوم المكررون بكسر البيض ما لم يتم وضع المهام في قائمة الانتظار."

#. STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.BEAKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.BEAKER.DESC"
msgid "A practical exercise in physics."
msgstr "تمرين عملي في الفيزياء."

#. STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.BEAKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.BEAKER.NAME"
msgid "<link=\"EGGCRACKER\">Beaker Cracker</link>"
msgstr "<link=\"EGGCRACKER\">كسارة البيض المخبرية</link>"

#. STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.DEFAULT_EGGCRACKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.DEFAULT_EGGCRACKER.DESC"
msgid "It cracks eggs."
msgstr "إنها تكسر البيض."

#. STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.DEFAULT_EGGCRACKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.DEFAULT_EGGCRACKER.NAME"
msgid "<link=\"EGGCRACKER\">Egg Cracker</link>"
msgstr "<link=\"EGGCRACKER\">كسارة البيض</link>"

#. STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.FLOWER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.FLOWER.DESC"
msgid "Now with EZ-clean petals."
msgstr "الآن مع بتلات سهلة التنظيف."

#. STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.FLOWER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.FLOWER.NAME"
msgid "<link=\"EGGCRACKER\">Blossom Cracker</link>"
msgstr "<link=\"EGGCRACKER\">كسارة الزهور</link>"

#. STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.HANDS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.HANDS.DESC"
msgid "Just like Mi-Ma used to have."
msgstr "تماماً مثل تلك التي كانت تمتلكها مي-ما."

#. STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.HANDS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGCRACKER.FACADES.HANDS.NAME"
msgid "<link=\"EGGCRACKER\">Handy Cracker</link>"
msgstr "<link=\"EGGCRACKER\">كسارة يدوية</link>"

#. STRINGS.BUILDINGS.PREFABS.EGGCRACKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGCRACKER.NAME"
msgid "<link=\"EGGCRACKER\">Egg Cracker</link>"
msgstr "<link=\"EGGCRACKER\">كسارة البيض</link>"

#. STRINGS.BUILDINGS.PREFABS.EGGCRACKER.RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGCRACKER.RECIPE_DESCRIPTION"
msgid "Turns {0} into {1}."
msgstr "تحول {0} إلى {1}."

#. STRINGS.BUILDINGS.PREFABS.EGGCRACKER.RESULT_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGCRACKER.RESULT_DESCRIPTION"
msgid "Cracked {0}"
msgstr "{0} مكسور"

#. STRINGS.BUILDINGS.PREFABS.EGGINCUBATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGINCUBATOR.DESC"
msgid "Incubators can maintain the ideal internal conditions for several species of critter egg."
msgstr "يمكن للحاضنات الحفاظ على الظروف الداخلية المثالية للعديد من أنواع بيض المخلوقات."

#. STRINGS.BUILDINGS.PREFABS.EGGINCUBATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGINCUBATOR.EFFECT"
msgid "Incubates <link=\"CREATURES\">Critter</link> eggs until ready to hatch.\n\nAssigned Duplicants must possess the <link=\"RANCHING1\">Critter Ranching</link> skill."
msgstr "تحضن بيض <link=\"CREATURES\">المخلوقات</link> حتى يصبح جاهزاً للفقس.\n\nيجب أن يمتلك المكررون المعينون مهارة <link=\"RANCHING1\">تربية المخلوقات</link>."

#. STRINGS.BUILDINGS.PREFABS.EGGINCUBATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EGGINCUBATOR.NAME"
msgid "<link=\"EGGINCUBATOR\">Incubator</link>"
msgstr "<link=\"EGGINCUBATOR\">حاضنة</link>"

#. STRINGS.BUILDINGS.PREFABS.ELECTROBANKCHARGER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ELECTROBANKCHARGER.DESC"
msgid "Bionic Duplicants rely on a steady supply of power to function."
msgstr "يعتمد المكررون البيونيون على إمداد ثابت من الطاقة ليعملوا."

#. STRINGS.BUILDINGS.PREFABS.ELECTROBANKCHARGER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ELECTROBANKCHARGER.EFFECT"
msgid "Converts empty <link=\"ELECTROBANK\">Eco Power Banks</link> into fully charged units ready for reuse."
msgstr "تحول <link=\"ELECTROBANK\">بنوك الطاقة البيئية</link> الفارغة إلى وحدات مشحونة بالكامل وجاهزة لإعادة الاستخدام."

#. STRINGS.BUILDINGS.PREFABS.ELECTROBANKCHARGER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ELECTROBANKCHARGER.NAME"
msgid "<link=\"ELECTROBANKCHARGER\">Power Bank Charger</link>"
msgstr "<link=\"ELECTROBANKCHARGER\">شاحن بنك الطاقة</link>"

#. STRINGS.BUILDINGS.PREFABS.ELECTROLYZER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ELECTROLYZER.DESC"
msgid "Water goes in one end, life sustaining oxygen comes out the other."
msgstr "يدخل الماء من طرف، ويخرج الأكسجين الداعم للحياة من الطرف الآخر."

#. STRINGS.BUILDINGS.PREFABS.ELECTROLYZER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ELECTROLYZER.EFFECT"
msgid "Converts <link=\"WATER\">Water</link> into <link=\"OXYGEN\">Oxygen</link> and <link=\"HYDROGEN\">Hydrogen Gas</link>.\n\nBecomes idle when the area reaches maximum pressure capacity."
msgstr "يحول <link=\"WATER\">الماء</link> إلى <link=\"OXYGEN\">أكسجين</link> و<link=\"HYDROGEN\">غاز الهيدروجين</link>.\n\nيصبح خاملاً عندما تصل المنطقة إلى سعة الضغط القصوى."

#. STRINGS.BUILDINGS.PREFABS.ELECTROLYZER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ELECTROLYZER.NAME"
msgid "<link=\"ELECTROLYZER\">Electrolyzer</link>"
msgstr "<link=\"ELECTROLYZER\">محلل كهربائي</link>"

#. STRINGS.BUILDINGS.PREFABS.ESCAPEPOD.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ESCAPEPOD.DESC"
msgid "Delivers a Duplicant from a stranded rocket to the nearest Planetoid."
msgstr "ينقل مكرراً من صاروخ تقطعت به السبل إلى أقرب كويكب."

#. STRINGS.BUILDINGS.PREFABS.ESCAPEPOD.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ESCAPEPOD.NAME"
msgid "<link=\"ESCAPEPOD\">Escape Pod</link>"
msgstr "<link=\"ESCAPEPOD\">كبسولة الهروب</link>"

#. STRINGS.BUILDINGS.PREFABS.ESPRESSOMACHINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ESPRESSOMACHINE.DESC"
msgid "A shot of espresso helps Duplicants relax after a long day."
msgstr "يساعد كوب من الإسبريسو المكررين على الاسترخاء بعد يوم طويل."

#. STRINGS.BUILDINGS.PREFABS.ESPRESSOMACHINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ESPRESSOMACHINE.EFFECT"
msgid "Provides refreshment for Duplicants on their breaks.\n\nIncreases Duplicant <link=\"MORALE\">Morale</link>."
msgstr "يوفر الانتعاش للمكررين أثناء فترات راحتهم.\n\nيزيد من <link=\"MORALE\">معنويات</link> المكرر."

#. STRINGS.BUILDINGS.PREFABS.ESPRESSOMACHINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ESPRESSOMACHINE.NAME"
msgid "<link=\"ESPRESSOMACHINE\">Espresso Machine</link>"
msgstr "<link=\"ESPRESSOMACHINE\">آلة الإسبريسو</link>"

#. STRINGS.BUILDINGS.PREFABS.ETHANOLDISTILLERY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ETHANOLDISTILLERY.DESC"
msgid "Ethanol distillers convert <link=\"WOOD\">Wood</link> into burnable <link=\"ETHANOL\">Ethanol</link> fuel."
msgstr "تقوم مقطرة الإيثانول بتحويل <link=\"WOOD\">الخشب</link> إلى وقود <link=\"ETHANOL\">الإيثانول</link> القابل للاحتراق."

#. STRINGS.BUILDINGS.PREFABS.ETHANOLDISTILLERY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ETHANOLDISTILLERY.EFFECT"
msgid "Refines <link=\"WOOD\">Wood</link> into <link=\"ETHANOL\">Ethanol</link>."
msgstr "تكرير <link=\"WOOD\">الخشب</link> إلى <link=\"ETHANOL\">إيثانول</link>."

#. STRINGS.BUILDINGS.PREFABS.ETHANOLDISTILLERY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ETHANOLDISTILLERY.NAME"
msgid "<link=\"ETHANOLDISTILLERY\">Ethanol Distiller</link>"
msgstr "<link=\"ETHANOLDISTILLERY\">مقطرة الإيثانول</link>"

#. STRINGS.BUILDINGS.PREFABS.EXOBASEHEADQUARTERS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXOBASEHEADQUARTERS.DESC"
msgid "A quick and easy substitute, though it'll never live up to the original."
msgstr "بديل سريع وسهل، على الرغم من أنه لن يرقى أبداً إلى مستوى الأصل."

#. STRINGS.BUILDINGS.PREFABS.EXOBASEHEADQUARTERS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.EXOBASEHEADQUARTERS.EFFECT"
msgid "A portable bioprinter that produces new Duplicants or care packages containing resources.\n\nOnly one Printing Pod or Mini-Pod is permitted per Planetoid."
msgstr "طابعة حيوية محمولة تنتج مكررين جدداً أو حزم رعاية تحتوي على موارد.\n\nيُسمح بوجود كبسولة طباعة واحدة أو كبسولة طباعة مصغرة فقط لكل كوكب."

#. STRINGS.BUILDINGS.PREFABS.EXOBASEHEADQUARTERS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXOBASEHEADQUARTERS.NAME"
msgid "<link=\"EXOBASEHEADQUARTERS\">Mini-Pod</link>"
msgstr "<link=\"EXOBASEHEADQUARTERS\">كبسولة طباعة مصغرة</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.DESC"
msgid "Drywall can be used in conjunction with tiles to build airtight rooms on the surface."
msgstr "يمكن استخدام الجدار الجاف بالتزامن مع البلاطات لبناء غرف محكمة الإغلاق على السطح."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.EFFECT"
msgid "Prevents <link=\"ELEMENTSGAS\">Gas</link> and <link=\"ELEMENTSLIQUID\">Liquid</link> loss in space.\n\nBuilds an insulating backwall behind buildings."
msgstr "يمنع فقدان <link=\"ELEMENTSGAS\">الغاز</link> و<link=\"ELEMENTSLIQUID\">السائل</link> في الفضاء.\n\nيبني جداراً خلفياً عازلاً خلف المباني."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.AQUATICMOSAIC.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.AQUATICMOSAIC.DESC"
msgid "A multi-hued blue wallpaper."
msgstr "ورق حائط أزرق متعدد الألوان."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.AQUATICMOSAIC.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.AQUATICMOSAIC.NAME"
msgid "<link=\"EXTERIORWALL\">Aquatic Mosaic</link>"
msgstr "<link=\"EXTERIORWALL\">فسيفساء مائية</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BALM_LILY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BALM_LILY.DESC"
msgid "A mellow floral wallpaper."
msgstr "ورق حائط زهري هادئ."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BALM_LILY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BALM_LILY.NAME"
msgid "<link=\"EXTERIORWALL\">Balm Lily Print</link>"
msgstr "<link=\"EXTERIORWALL\">طبعة زنبق البلسم</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_BLUE_COBALT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.BASIC_BLUE_COBALT.DESC"
