msgctxt "STRINGS.ELEMENTS.STATE.SOLID"
msgid "Solid"
msgstr "صلب"

#. STRINGS.ELEMENTS.STATE.VACUUM
msgctxt "STRINGS.ELEMENTS.STATE.VACUUM"
msgid "None"
msgstr "لا شيء"

#. STRINGS.ELEMENTS.STEAM.DESC
msgctxt "STRINGS.ELEMENTS.STEAM.DESC"
msgid "(H<sub>2</sub>O) Steam is <link=\"WATER\">Water</link> that has been heated into a scalding <link=\"ELEMENTSGAS\">Gas</link>."
msgstr "<sub>2</sub>و) البخار هو <link=\"WATER\">مياه</link> تم تسخينها لتصبح <link=\"ELEMENTSGAS\">غازاً</link> حارقاً."

#. STRINGS.ELEMENTS.STEAM.NAME
msgctxt "STRINGS.ELEMENTS.STEAM.NAME"
msgid "<link=\"STEAM\">Steam</link>"
msgstr "<link=\"STEAM\">بخار</link>"

#. STRINGS.ELEMENTS.STEEL.DESC
msgctxt "STRINGS.ELEMENTS.STEEL.DESC"
msgid "Steel is a <link=\"REFINEDMETAL\">Metal Alloy</link> composed of iron and carbon."
msgstr "الفولاذ هو <link=\"REFINEDMETAL\">سبيكة معدنية</link> تتكون من الحديد والكربون."

#. STRINGS.ELEMENTS.STEEL.NAME
msgctxt "STRINGS.ELEMENTS.STEEL.NAME"
msgid "<link=\"STEEL\">Steel</link>"
msgstr "<link=\"STEEL\">فولاذ</link>"

#. STRINGS.ELEMENTS.STEELGAS.DESC
msgctxt "STRINGS.ELEMENTS.STEELGAS.DESC"
msgid "Steel Gas is a superheated <link=\"RAWMETAL\">Metal</link> <link=\"ELEMENTSGAS\">Gas</link> composed of iron and carbon."
msgstr "غاز الفولاذ هو <link=\"RAWMETAL\">معدن</link> <link=\"ELEMENTSGAS\">غازي</link> فائق التسخين يتكون من الحديد والكربون."

#. STRINGS.ELEMENTS.STEELGAS.NAME
msgctxt "STRINGS.ELEMENTS.STEELGAS.NAME"
msgid "<link=\"STEELGAS\">Steel Gas</link>"
msgstr "<link=\"STEELGAS\">غاز الفولاذ</link>"

#. STRINGS.ELEMENTS.SUCROSE.DESC
msgctxt "STRINGS.ELEMENTS.SUCROSE.DESC"
msgid "(C<sub>12</sub>H<sub>22</sub>O<sub>11</sub>) Sucrose is the raw form of sugar.\n\nIt can be used for cooking higher-quality <link=\"FOOD\">Food</link>."
msgstr "(ج<sub>12</sub>ح<sub>22</sub>و<sub>11</sub>) السكروز هو الشكل الخام للسكر.\n\nيمكن استخدامه لطهي <link=\"FOOD\">طعام</link> عالي الجودة."

#. STRINGS.ELEMENTS.SUCROSE.NAME
msgctxt "STRINGS.ELEMENTS.SUCROSE.NAME"
msgid "<link=\"SUCROSE\">Sucrose</link>"
msgstr "<link=\"SUCROSE\">سكروز</link>"

#. STRINGS.ELEMENTS.SUGARWATER.DESC
msgctxt "STRINGS.ELEMENTS.SUGARWATER.DESC"
msgid "Nectar is a natural, lightly concentrated solution of <link=\"SUCROSE\">Sucrose</link> dissolved in <link=\"WATER\">Water</link>."
msgstr "الرحيق هو محلول طبيعي مركز قليلاً من <link=\"SUCROSE\">السكروز</link> المذاب في <link=\"WATER\">المياه</link>."

#. STRINGS.ELEMENTS.SUGARWATER.NAME
msgctxt "STRINGS.ELEMENTS.SUGARWATER.NAME"
msgid "<link=\"SUGARWATER\">Nectar</link>"
msgstr "<link=\"SUGARWATER\">رحيق</link>"

#. STRINGS.ELEMENTS.SULFUR.DESC
msgctxt "STRINGS.ELEMENTS.SULFUR.DESC"
msgid "(S) Sulfur is a common chemical element and byproduct of <link=\"METHANE\">Natural Gas</link> production.\n\nThis selection is in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(س) الكبريت عنصر كيميائي شائع وناتج ثانوي لإنتاج <link=\"METHANE\">الغاز الطبيعي</link>.\n\nهذا الاختيار في حالة <link=\"ELEMENTSSOLID\">صلبة</link>."

#. STRINGS.ELEMENTS.SULFUR.NAME
msgctxt "STRINGS.ELEMENTS.SULFUR.NAME"
msgid "<link=\"SULFUR\">Sulfur</link>"
msgstr "<link=\"SULFUR\">كبريت</link>"

#. STRINGS.ELEMENTS.SULFURGAS.DESC
msgctxt "STRINGS.ELEMENTS.SULFURGAS.DESC"
msgid "(S) Sulfur is a common chemical element and byproduct of <link=\"METHANE\">Natural Gas</link> production.\n\nThis selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(س) الكبريت عنصر كيميائي شائع وناتج ثانوي لإنتاج <link=\"METHANE\">الغاز الطبيعي</link>.\n\nهذا الاختيار في حالة <link=\"ELEMENTSGAS\">غازية</link>."

#. STRINGS.ELEMENTS.SULFURGAS.NAME
msgctxt "STRINGS.ELEMENTS.SULFURGAS.NAME"
msgid "<link=\"SULFURGAS\">Sulfur Gas</link>"
msgstr "<link=\"SULFURGAS\">غاز الكبريت</link>"

#. STRINGS.ELEMENTS.SUPERCOOLANT.DESC
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANT.DESC"
msgid "Super Coolant is an industrial-grade coolant that utilizes the unusual energy states of <link=\"FULLERENE\">Fullerene</link>.\n\nThis selection is in a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "سائل التبريد الفائق هو سائل تبريد من الدرجة الصناعية يستخدم حالات الطاقة غير العادية لـ <link=\"FULLERENE\">الفوليرين</link>.\n\nهذا الاختيار في حالة <link=\"ELEMENTSLIQUID\">سائلة</link>."

#. STRINGS.ELEMENTS.SUPERCOOLANT.NAME
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANT.NAME"
msgid "<link=\"SUPERCOOLANT\">Super Coolant</link>"
msgstr "<link=\"SUPERCOOLANT\">سائل التبريد الفائق</link>"

#. STRINGS.ELEMENTS.SUPERCOOLANTGAS.DESC
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANTGAS.DESC"
msgid "Super Coolant is an industrial-grade <link=\"FULLERENE\">Fullerene</link> coolant.\n\nThis selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "سائل التبريد الفائق هو سائل تبريد من الدرجة الصناعية يعتمد على <link=\"FULLERENE\">الفوليرين</link>.\n\nهذا الاختيار في حالة <link=\"ELEMENTSGAS\">غازية</link>."

#. STRINGS.ELEMENTS.SUPERCOOLANTGAS.NAME
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANTGAS.NAME"
msgid "<link=\"SUPERCOOLANTGAS\">Super Coolant Gas</link>"
msgstr "<link=\"SUPERCOOLANTGAS\">غاز سائل التبريد الفائق</link>"

#. STRINGS.ELEMENTS.SUPERINSULATOR.DESC
msgctxt "STRINGS.ELEMENTS.SUPERINSULATOR.DESC"
msgid "Insulite reduces <link=\"HEAT\">Heat Transfer</link> and is composed of recrystallized <link=\"KATAIRITE\">Abyssalite</link>."
msgstr "يقلل الإنسولايت من <link=\"HEAT\">انتقال الحرارة</link> ويتكون من <link=\"KATAIRITE\">أبيسالايت</link> مُعاد تبلوره."

#. STRINGS.ELEMENTS.SUPERINSULATOR.NAME
msgctxt "STRINGS.ELEMENTS.SUPERINSULATOR.NAME"
msgid "<link=\"SUPERINSULATOR\">Insulite</link>"
msgstr "<link=\"SUPERINSULATOR\">إنسولايت</link>"

#. STRINGS.ELEMENTS.SYNGAS.DESC
msgctxt "STRINGS.ELEMENTS.SYNGAS.DESC"
msgid "Synthesis Gas is an artificial, unbreathable <link=\"ELEMENTSGAS\">Gas</link>.\n\nIt can be converted into an efficient fuel."
msgstr "غاز التخليق هو <link=\"ELEMENTSGAS\">غاز</link> اصطناعي غير قابل للتنفس.\n\nيمكن تحويله إلى وقود فعال."

#. STRINGS.ELEMENTS.SYNGAS.NAME
msgctxt "STRINGS.ELEMENTS.SYNGAS.NAME"
msgid "<link=\"SYNGAS\">Synthesis Gas</link>"
msgstr "<link=\"SYNGAS\">غاز التخليق</link>"

#. STRINGS.ELEMENTS.TALLOW.DESC
msgctxt "STRINGS.ELEMENTS.TALLOW.DESC"
msgid "A chunk of raw grease that can be used in <link=\"FOOD\">Food</link> production or industrial processes."
msgstr "قطعة من الشحم الخام يمكن استخدامها في إنتاج <link=\"FOOD\">الطعام</link> أو في العمليات الصناعية."

#. STRINGS.ELEMENTS.TALLOW.NAME
msgctxt "STRINGS.ELEMENTS.TALLOW.NAME"
msgid "<link=\"TALLOW\">Tallow</link>"
msgstr "<link=\"TALLOW\">شحم</link>"

#. STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.DESC
msgctxt "STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.DESC"
msgid "Thermium is an industrial metal alloy formulated to maximize <link=\"HEAT\">Heat Transfer</link> and thermal dispersion."
msgstr "الثيرميوم هو سبيكة معدنية صناعية تمت صياغتها لزيادة <link=\"HEAT\">انتقال الحرارة</link> والتشتت الحراري إلى أقصى حد."

#. STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.NAME
msgctxt "STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.NAME"
msgid "<link=\"TEMPCONDUCTORSOLID\">Thermium</link>"
msgstr "<link=\"TEMPCONDUCTORSOLID\">ثيرميوم</link>"

#. STRINGS.ELEMENTS.TESTELEMENT.DESC
msgctxt "STRINGS.ELEMENTS.TESTELEMENT.DESC"
msgid "((Fe,Mn)WO<sub>4</sub>) Wolframite is a dense Metallic element in a <link=\"ELEMENTSSOLID\">Solid</link> state.\n\nIt is a source of <link=\"TUNGSTEN\">Tungsten</link> and is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "((في,من)وو<sub>4</sub>) ولفراميت هو عنصر معدني كثيف في حالة <link=\"ELEMENTSSOLID\">صلبة</link>.\n\nإنه مصدر لـ <link=\"TUNGSTEN\">التنغستن</link> ومناسب لبناء أنظمة <link=\"POWER\">الطاقة</link>."

#. STRINGS.ELEMENTS.TESTELEMENT.NAME
msgctxt "STRINGS.ELEMENTS.TESTELEMENT.NAME"
msgid "<link=\"TESTELEMENT\">Test Element</link>"
msgstr "<link=\"TESTELEMENT\">عنصر اختبار</link>"

#. STRINGS.ELEMENTS.THERMALPROPERTIES
msgctxt "STRINGS.ELEMENTS.THERMALPROPERTIES"
msgid "\nSpecific Heat Capacity: {SPECIFIC_HEAT_CAPACITY}\nThermal Conductivity: {THERMAL_CONDUCTIVITY}"
msgstr "\nالسعة الحرارية النوعية: {SPECIFIC_HEAT_CAPACITY}\nالتوصيل الحراري: {THERMAL_CONDUCTIVITY}"

#. STRINGS.ELEMENTS.TOXICMUD.DESC
msgctxt "STRINGS.ELEMENTS.TOXICMUD.DESC"
msgid "A mixture of <link=\"TOXICSAND\">Polluted Dirt</link> and <link=\"DIRTYWATER\">Polluted Water</link>.\n\nCan be separated into its base elements using a <link=\"SLUDGEPRESS\">Sludge Press</link>."
msgstr "خليط من <link=\"TOXICSAND\">التربة الملوثة</link> و<link=\"DIRTYWATER\">المياه الملوثة</link>.\n\nيمكن فصله إلى عناصره الأساسية باستخدام <link=\"SLUDGEPRESS\">مكبس الأوحال</link>."

#. STRINGS.ELEMENTS.TOXICMUD.NAME
msgctxt "STRINGS.ELEMENTS.TOXICMUD.NAME"
msgid "<link=\"TOXICMUD\">Polluted Mud</link>"
msgstr "<link=\"TOXICMUD\">طين ملوث</link>"

#. STRINGS.ELEMENTS.TOXICSAND.DESC
msgctxt "STRINGS.ELEMENTS.TOXICSAND.DESC"
msgid "Polluted Dirt is unprocessed biological waste.\n\nIt emits <link=\"CONTAMINATEDOXYGEN\">Polluted Oxygen</link> over time."
msgstr "التربة الملوثة هي نفايات بيولوجية غير معالجة.\n\nإنها تبعث <link=\"CONTAMINATEDOXYGEN\">أكسجين ملوث</link> بمرور الوقت."

#. STRINGS.ELEMENTS.TOXICSAND.NAME
msgctxt "STRINGS.ELEMENTS.TOXICSAND.NAME"
msgid "<link=\"TOXICSAND\">Polluted Dirt</link>"
msgstr "<link=\"TOXICSAND\">تربة ملوثة</link>"

#. STRINGS.ELEMENTS.TUNGSTEN.DESC
msgctxt "STRINGS.ELEMENTS.TUNGSTEN.DESC"
msgid "(W) Tungsten is an extremely tough crystalline <link=\"RAWMETAL\">Metal</link>.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(و) التنغستن هو <link=\"RAWMETAL\">معدن</link> بلوري صلب للغاية.\n\nإنه مناسب لبناء أنظمة <link=\"POWER\">الطاقة</link>."

#. STRINGS.ELEMENTS.TUNGSTEN.NAME
msgctxt "STRINGS.ELEMENTS.TUNGSTEN.NAME"
msgid "<link=\"TUNGSTEN\">Tungsten</link>"
msgstr "<link=\"TUNGSTEN\">تنغستن</link>"

#. STRINGS.ELEMENTS.TUNGSTENDISELENIDE.DESC
msgctxt "STRINGS.ELEMENTS.TUNGSTENDISELENIDE.DESC"
msgid "(WSe<sub>2</sub>) Tungsten Diselenide is an inorganic <link=\"RAWMETAL\">Metal</link> compound with a crystalline structure.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(وسي<sub>2</sub>) ثنائي سيلينيد التنغستن هو مركب <link=\"RAWMETAL\">معدني</link> غير عضوي ذو بنية بلورية.\n\nإنه مناسب لبناء أنظمة <link=\"POWER\">الطاقة</link>."

#. STRINGS.ELEMENTS.TUNGSTENDISELENIDE.NAME
msgctxt "STRINGS.ELEMENTS.TUNGSTENDISELENIDE.NAME"
msgid "<link=\"TUNGSTENDISELENIDE\">Tungsten Diselenide</link>"
msgstr "<link=\"TUNGSTENDISELENIDE\">ثنائي سيلينيد التنغستن</link>"

#. STRINGS.ELEMENTS.TUNGSTENDISELENIDEGAS.DESC
msgctxt "STRINGS.ELEMENTS.TUNGSTENDISELENIDEGAS.DESC"
msgid "(WSe<sub>2</sub>) Tungsten Diselenide Gasis a superheated <link=\"RAWMETAL\">Metal</link> compound in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(وسي<sub>2</sub>) غاز ثنائي سيلينيد التنغستن هو مركب <link=\"RAWMETAL\">معدني</link> فائق التسخين في حالة <link=\"ELEMENTSGAS\">غازية</link>."

#. STRINGS.ELEMENTS.TUNGSTENDISELENIDEGAS.NAME
msgctxt "STRINGS.ELEMENTS.TUNGSTENDISELENIDEGAS.NAME"
msgid "<link=\"TUNGSTENDISELENIDEGAS\">Tungsten Diselenide Gas</link>"
msgstr "<link=\"TUNGSTENDISELENIDEGAS\">غاز ثنائي سيلينيد التنغستن</link>"

#. STRINGS.ELEMENTS.TUNGSTENGAS.DESC
msgctxt "STRINGS.ELEMENTS.TUNGSTENGAS.DESC"
msgid "(W) Tungsten is a superheated crystalline <link=\"RAWMETAL\">Metal</link>.\n\nThis selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(و) التنغستن هو <link=\"RAWMETAL\">معدن</link> بلوري فائق التسخين.\n\nهذا الاختيار في حالة <link=\"ELEMENTSGAS\">غازية</link>."

#. STRINGS.ELEMENTS.TUNGSTENGAS.NAME
msgctxt "STRINGS.ELEMENTS.TUNGSTENGAS.NAME"
msgid "<link=\"TUNGSTENGAS\">Tungsten Gas</link>"
msgstr "<link=\"TUNGSTENGAS\">غاز التنغستن</link>"

#. STRINGS.ELEMENTS.UNOBTANIUM.DESC
msgctxt "STRINGS.ELEMENTS.UNOBTANIUM.DESC"
msgid "(Nt) Neutronium is a mysterious and extremely resilient element.\n\nIt cannot be excavated by any Duplicant mining tool."
msgstr "(نت) النيوترونيوم هو عنصر غامض ومرن للغاية.\n\nلا يمكن التنقيب عنه بواسطة أي أداة تعدين للمكررين."

#. STRINGS.ELEMENTS.UNOBTANIUM.NAME
msgctxt "STRINGS.ELEMENTS.UNOBTANIUM.NAME"
msgid "<link=\"UNOBTANIUM\">Neutronium</link>"
msgstr "<link=\"UNOBTANIUM\">نيوترونيوم</link>"

#. STRINGS.ELEMENTS.URANIUMORE.DESC
msgctxt "STRINGS.ELEMENTS.URANIUMORE.DESC"
msgid "(U) Uranium Ore is a highly <link=\"RADIATION\">Radioactive</link> substance.\n\nIt can be refined into fuel for research reactors."
msgstr "(و) خام اليورانيوم مادة <link=\"RADIATION\">مشعة</link> للغاية.\n\nيمكن تكريره ليصبح وقوداً للمفاعلات البحثية."

#. STRINGS.ELEMENTS.URANIUMORE.NAME
msgctxt "STRINGS.ELEMENTS.URANIUMORE.NAME"
msgid "<link=\"URANIUMORE\">Uranium Ore</link>"
msgstr "<link=\"URANIUMORE\">خام اليورانيوم</link>"

#. STRINGS.ELEMENTS.VACUUM.DESC
msgctxt "STRINGS.ELEMENTS.VACUUM.DESC"
msgid "A vacuum is a space devoid of all matter."
msgstr "الفراغ هو مساحة خالية من كل المادة."

#. STRINGS.ELEMENTS.VACUUM.NAME
msgctxt "STRINGS.ELEMENTS.VACUUM.NAME"
msgid "<link=\"VACUUM\">Vacuum</link>"
msgstr "<link=\"VACUUM\">فراغ</link>"

#. STRINGS.ELEMENTS.VISCOGEL.DESC
msgctxt "STRINGS.ELEMENTS.VISCOGEL.DESC"
msgid "Visco-Gel Fluid is a <link=\"ELEMENTSLIQUID\">Liquid</link> polymer with high surface tension, preventing typical liquid flow and allowing for unusual configurations."
msgstr "سائل فيسكو-جيل هو بوليمر <link=\"ELEMENTSLIQUID\">سائل</link> ذو توتر سطحي عالٍ، يمنع التدفق السائل المعتاد ويسمح بتكوينات غير عادية."

#. STRINGS.ELEMENTS.VISCOGEL.NAME
msgctxt "STRINGS.ELEMENTS.VISCOGEL.NAME"
msgid "<link=\"VISCOGEL\">Visco-Gel Fluid</link>"
msgstr "<link=\"VISCOGEL\">سائل فيسكو-جيل</link>"

#. STRINGS.ELEMENTS.VOID.DESC
msgctxt "STRINGS.ELEMENTS.VOID.DESC"
msgid "Cold, infinite nothingness."
msgstr "عدم وجود بارد ولا نهائي."

#. STRINGS.ELEMENTS.VOID.NAME
msgctxt "STRINGS.ELEMENTS.VOID.NAME"
msgid "<link=\"VOID\">Void</link>"
msgstr "<link=\"VOID\">الفراغ</link>"

#. STRINGS.ELEMENTS.WATER.DESC
msgctxt "STRINGS.ELEMENTS.WATER.DESC"
msgid "(H<sub>2</sub>O) Clean <link=\"WATER\">Water</link>, suitable for consumption."
msgstr "(ح<sub>2</sub>و) مياه نظيفة <link=\"WATER\"></link>، صالحة للاستهلاك."

#. STRINGS.ELEMENTS.WATER.NAME
msgctxt "STRINGS.ELEMENTS.WATER.NAME"
msgid "<link=\"WATER\">Water</link>"
msgstr "<link=\"WATER\">مياه</link>"

#. STRINGS.ELEMENTS.WOLFRAMITE.DESC
msgctxt "STRINGS.ELEMENTS.WOLFRAMITE.DESC"
msgid "((Fe,Mn)WO<sub>4</sub>) Wolframite is a dense Metallic element in a <link=\"ELEMENTSSOLID\">Solid</link> state.\n\nIt is a source of <link=\"TUNGSTEN\">Tungsten</link> and is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "((في,من)وو<sub>4</sub>) الولفراميت هو عنصر معدني كثيف في حالة <link=\"ELEMENTSSOLID\">صلبة</link>.\n\nوهو مصدر لـ <link=\"TUNGSTEN\">التنغستن</link> ومناسب لبناء أنظمة <link=\"POWER\">الطاقة</link>."

#. STRINGS.ELEMENTS.WOLFRAMITE.NAME
msgctxt "STRINGS.ELEMENTS.WOLFRAMITE.NAME"
msgid "<link=\"WOLFRAMITE\">Wolframite</link>"
msgstr "<link=\"WOLFRAMITE\">ولفراميت</link>"

#. STRINGS.ELEMENTS.WOODLOG.DESC
msgctxt "STRINGS.ELEMENTS.WOODLOG.DESC"
msgid "Wood is a good source of <link=\"HEAT\">Heat</link> and <link=\"POWER\">Power</link>.\n\nIts insulation properties and positive <link=\"DECOR\">Decor</link> also make it a useful <b>Construction Material</b>."
msgstr "الخشب مصدر جيد لـ <link=\"HEAT\">الحرارة</link> و<link=\"POWER\">الطاقة</link>.\n\nخصائص العزل لديه و<link=\"DECOR\">الديكور</link> الإيجابي تجعله أيضاً <b>مادة بناء</b> مفيدة."

#. STRINGS.ELEMENTS.WOODLOG.NAME
msgctxt "STRINGS.ELEMENTS.WOODLOG.NAME"
msgid "<link=\"WOOD\">Wood</link>"
msgstr "<link=\"WOOD\">خشب</link>"

#. STRINGS.ELEMENTS.YELLOWCAKE.DESC
msgctxt "STRINGS.ELEMENTS.YELLOWCAKE.DESC"
msgid "(U<sub>3</sub>O<sub>8</sub>) Yellowcake is a byproduct of <link=\"URANIUM\">Uranium</link> mining.\n\nIt is useful in preparing fuel for <link=\"NUCLEARREACTOR\">Research Reactors</link>.\n\nNote: Do not eat."
msgstr "(و<sub>3</sub>و<sub>8</sub>) الكعكة الصفراء هي نتاج ثانوي لتعدين <link=\"URANIUM\">اليورانيوم</link>.\n\nوهي مفيدة في تحضير الوقود لـ <link=\"NUCLEARREACTOR\">المفاعلات البحثية</link>.\n\nملاحظة: لا تأكلها."

#. STRINGS.ELEMENTS.YELLOWCAKE.NAME
msgctxt "STRINGS.ELEMENTS.YELLOWCAKE.NAME"
msgid "<link=\"YELLOWCAKE\">Yellowcake</link>"
msgstr "<link=\"YELLOWCAKE\">الكعكة الصفراء</link>"

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.DESC"
msgid "Because breathing underwater is better than... not."
msgstr "لأن التنفس تحت الماء أفضل من... عدم القيام بذلك."

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.EFFECT
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.EFFECT"
msgid "Supplies Duplicants with <style=\"oxygen\">Oxygen</style> in underwater environments.\n\nMust be refilled with <link=\"OXYGEN\">Oxygen</link> at an <link=\"SUITLOCKER\">Atmo Suit Dock</link> when depleted."
msgstr "تزود المكررين بـ <style=\"oxygen\">أكسجين</style> في البيئات التي تقع تحت الماء.\n\nيجب إعادة تعبئتها بـ <link=\"OXYGEN\">أكسجين</link> في <link=\"SUITLOCKER\">رصيف بدلة أتمو</link> عند نفادها."

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.NAME"
msgid "<link=\"AQUASUIT\">Aqua Suit</link>"
msgstr "<link=\"AQUASUIT\">بدلة مائية</link>"

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.RECIPE_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.RECIPE_DESC"
msgid "Supplies Duplicants with <style=\"oxygen\">Oxygen</style> in underwater environments."
msgstr "تزود المكررين بـ <style=\"oxygen\">الأكسجين</style> في البيئات تحت المائية."

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_DESC"
msgid "A worn out <link=\"AQUASUIT\">Aqua Suit</link>.\n\nSuits can be repaired at a <link=\"CRAFTINGTABLE\">Crafting Station</link>."
msgstr "<link=\"AQUASUIT\">بدلة مائية</link> مهترئة.\n\nيمكن إصلاح البدلات في <link=\"CRAFTINGTABLE\">محطة تصنيع</link>."

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_NAME"
msgid "<link=\"AQUASUIT\">Worn Lead Suit</link>"
msgstr "<link=\"AQUASUIT\">بدلة رصاص مهترئة</link>"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.DESC"
msgid "Ensures my Duplicants can breathe easy, anytime, anywhere."
msgstr "تضمن أن مكرري يمكنهم التنفس بسهولة، في أي وقت، وفي أي مكان."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.EFFECT
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.EFFECT"
msgid "Supplies Duplicants with <link=\"OXYGEN\">Oxygen</link> in toxic and low breathability environments, and protects against extreme temperatures.\n\nMust be refilled with oxygen at an <link=\"SUITLOCKER\">Atmo Suit Dock</link> when depleted."
msgstr "تزود المكررين بـ <link=\"OXYGEN\">الأكسجين</link> في البيئات السامة وذات التنفس المنخفض، وتحمي من درجات الحرارة المتطرفة.\n\nيجب إعادة تعبئتها بالأكسجين عند <link=\"SUITLOCKER\">رصيف بدلة أتمو</link> عند نفادها."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.GENERICNAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.GENERICNAME"
msgid "Suit"
msgstr "بدلة"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.NAME"
msgid "<link=\"ATMOSUIT\">Atmo Suit</link>"
msgstr "<link=\"ATMOSUIT\">بدلة أتمو</link>"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.RECIPE_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.RECIPE_DESC"
msgid "Supplies Duplicants with <link=\"OXYGEN\">Oxygen</link> in toxic and low breathability environments."
msgstr "تزود المكررين بـ <link=\"OXYGEN\">الأكسجين</link> في البيئات السامة وذات التنفس المنخفض."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.REPAIR_WORN_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.REPAIR_WORN_DESC"
msgid "Restore a <link=\"ATMOSUIT\">Worn Atmo Suit</link> to working order."
msgstr "استعادة <link=\"ATMOSUIT\">بدلة أتمو مهترئة</link> إلى حالة العمل."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.REPAIR_WORN_RECIPE_NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.REPAIR_WORN_RECIPE_NAME"
msgid "Repair <link=\"ATMOSUIT\">Atmo Suit</link>"
msgstr "إصلاح <link=\"ATMOSUIT\">بدلة أتمو</link>"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.WORN_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.WORN_DESC"
msgid "A worn out <link=\"ATMOSUIT\">Atmo Suit</link>.\n\nSuits can be repaired at an <link=\"SUITFABRICATOR\">Exosuit Forge</link>."
msgstr "<link=\"ATMOSUIT\">بدلة أتمو</link> مهترئة.\n\nيمكن إصلاح البدلات في <link=\"SUITFABRICATOR\">مسبك البدلات الخارجية</link>."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.WORN_NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.WORN_NAME"
msgid "<link=\"ATMOSUIT\">Worn Atmo Suit</link>"
msgstr "<link=\"ATMOSUIT\">بدلة أتمو مهترئة</link>"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.DESC"
msgid "Default belt for atmo suits."
msgstr "حزام افتراضي لبدلات أتمو."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GOLD.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GOLD.DESC"
msgid "Better to be overdressed than underdressed."
msgstr "من الأفضل أن تكون مبالغاً في أناقتك على أن تكون أقل من المطلوب."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GOLD.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GOLD.NAME"
msgid "Gold Atmo Belt"
msgstr "حزام أتمو الذهبي"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GREY.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GREY.DESC"
msgid "Slick and understated space style."
msgstr "نمط فضاء أنيق وبسيط."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GREY.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GREY.NAME"
msgid "Slate Atmo Belt"
msgstr "حزام أتمو الأردوازي"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_NEON_PINK.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_NEON_PINK.DESC"
msgid "Visible from several planetoids away."
msgstr "مرئي من على بعد عدة كواكب صغيرة."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_NEON_PINK.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_NEON_PINK.NAME"
msgid "Neon Pink Atmo Belt"
msgstr "حزام أتمو الوردي النيون"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.CANTALOUPE.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.CANTALOUPE.DESC"
msgid "A tribute to the <i>cucumis melo cantalupensis</i>."
msgstr "تكريم لـ <i>شمام</i>."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.CANTALOUPE.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.CANTALOUPE.NAME"
msgid "Rocketmelon Atmo Belt"
msgstr "حزام أتمو روكيت ميلون"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.LIMONE.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.LIMONE.DESC"
msgid "This lime-hued belt really pulls an atmo suit together."
msgstr "هذا الحزام ذو لون الجير يضفي لمسة جمالية على بدلة الأتمو."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.LIMONE.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.LIMONE.NAME"
msgid "Citrus Atmo Belt"
msgstr "حزام أتمو الحمضي"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.PUFT.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.PUFT.DESC"
msgid "If critters wore belts...\nReleased for Klei Fest 2023."
msgstr "لو كانت المخلوقات ترتدي أحزمة...\nأُصدرت لمهرجان كلاي 2023."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.PUFT.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.PUFT.NAME"
msgid "Puft Atmo Belt"
msgstr "حزام أتمو بافت"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_BLUE.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_BLUE.DESC"
msgid "It's blue! It's shiny! It keeps atmo suit pants on!"
msgstr "إنه أزرق! إنه لامع! إنه يبقي بنطال بدلة الأتمو في مكانه!"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_BLUE.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_BLUE.NAME"
msgid "Blue Glitter Atmo Belt"
msgstr "حزام أتمو الأزرق اللامع"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_GREEN.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_GREEN.DESC"
msgid "It's green! It's shiny! It keeps atmo suit pants on!"
msgstr "إنه أخضر! إنه لامع! إنه يبقي بنطال بدلة الأتمو في مكانه!"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_GREEN.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_GREEN.NAME"
msgid "Green Glitter Atmo Belt"
msgstr "حزام أتمو الأخضر اللامع"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_LAVENDER.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_LAVENDER.DESC"
msgid "It's violet! It's shiny! It keeps atmo suit pants on!"
msgstr "إنه بنفسجي! إنه لامع! إنه يبقي بنطال بدلة الأتمو في مكانه!"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_LAVENDER.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_LAVENDER.NAME"
msgid "Violet Glitter Atmo Belt"
msgstr "حزام أتمو البنفسجي اللامع"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_RED.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_RED.DESC"
msgid "It's red! It's shiny! It keeps atmo suit pants on!"
msgstr "إنه أحمر! إنه لامع! إنه يبقي بنطال بدلة الأتمو في مكانه!"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_RED.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_RED.NAME"
msgid "Red Glitter Atmo Belt"
msgstr "حزام أتمو الأحمر اللامع"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.TWOTONE_BROWN.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.TWOTONE_BROWN.DESC"
msgid "Crafted from the tanned hide of a thick-skinned critter."
msgstr "مصنوع من جلد مدبوغ لمخلوق ذي بشرة سميكة."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.TWOTONE_BROWN.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.TWOTONE_BROWN.NAME"
msgid "Leather Atmo Belt"
msgstr "حزام أتمو الجلدي"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.TWOTONE_PURPLE.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.TWOTONE_PURPLE.DESC"
msgid "In the more pretentious space-fashion circles, it's known as \"aubergine.\""
msgstr "في أوساط موضة الفضاء الأكثر تظاهراً، يُعرف باسم \"الباذنجاني\"."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.TWOTONE_PURPLE.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.TWOTONE_PURPLE.NAME"
msgid "Eggplant Atmo Belt"
msgstr "حزام أتمو الباذنجاني"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.NAME"
msgid "Default Atmo Belt"
msgstr "حزام أتمو الافتراضي"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BODY.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BODY.DESC"
msgid "Default top and bottom of an atmo suit."
msgstr "الجزء العلوي والسفلي الافتراضي لبدلة أتمو."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BODY.FACADES.BASIC_NEON_PINK.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BODY.FACADES.BASIC_NEON_PINK.DESC"
msgid "The neck is a little snug."
msgstr "منطقة الرقبة ضيقة قليلاً."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BODY.FACADES.BASIC_NEON_PINK.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BODY.FACADES.BASIC_NEON_PINK.NAME"
msgid "Crisp Neon Pink Atmo Suit"
msgstr "بدلة أتمو وردية نيون منعشة"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BODY.FACADES.BASIC_PURPLE.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BODY.FACADES.BASIC_PURPLE.DESC"
msgid "It really emphasizes wide shoulders."
msgstr "إنها تبرز الأكتاف العريضة حقاً."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BODY.FACADES.BASIC_PURPLE.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BODY.FACADES.BASIC_PURPLE.NAME"
msgid "Crisp Eggplant Atmo Suit"
msgstr "بدلة أتمو بلون الباذنجان المنعش"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BODY.FACADES.CANTALOUPE.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BODY.FACADES.CANTALOUPE.DESC"
msgid "It starts to smell ripe pretty quickly."
