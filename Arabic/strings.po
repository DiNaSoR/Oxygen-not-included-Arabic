msgid "The fact that this was just a friendly game was not made clear to everyone involved."
msgstr "لم تكن حقيقة أن هذه مجرد لعبة ودية واضحة للجميع."

#. STRINGS.BLUEPRINTS.PERMIT_PAINTING_WIDE_ART_RHEX.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PAINTING_WIDE_ART_RHEX.NAME"
msgid "Hide and Seek"
msgstr "غميضة"

#. STRINGS.BLUEPRINTS.PERMIT_PANTS_EXTENDEDWAIST_BLUE_WHEEZEWORT.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PANTS_EXTENDEDWAIST_BLUE_WHEEZEWORT.DESC"
msgid "The built-in invisible elastic waistband supports deep belly breathing."
msgstr "يدعم حزام الخصر المطاطي غير المرئي المدمج التنفس العميق من البطن."

#. STRINGS.BLUEPRINTS.PERMIT_PANTS_EXTENDEDWAIST_BLUE_WHEEZEWORT.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PANTS_EXTENDEDWAIST_BLUE_WHEEZEWORT.NAME"
msgid "High-Waisted Wheezy Pants"
msgstr "سروال ويزي عالي الخصر"

#. STRINGS.BLUEPRINTS.PERMIT_PANTS_SNAPJACKET_BRINE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PANTS_SNAPJACKET_BRINE.DESC"
msgid "Most wearers consider these single-use."
msgstr "يعتبر معظم مرتديها أنها للاستخدام مرة واحدة."

#. STRINGS.BLUEPRINTS.PERMIT_PANTS_SNAPJACKET_BRINE.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PANTS_SNAPJACKET_BRINE.NAME"
msgid "Tear-Away Pants"
msgstr "سروال سريع التمزق"

#. STRINGS.BLUEPRINTS.PERMIT_PANTS_SUSPENDERS_FRASS.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PANTS_SUSPENDERS_FRASS.DESC"
msgid "The suspenders are made from reconstituted wood pulp. They're not stretchy."
msgstr "الحمالات مصنوعة من لب الخشب المعاد تشكيله. إنها غير قابلة للتمدد."

#. STRINGS.BLUEPRINTS.PERMIT_PANTS_SUSPENDERS_FRASS.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PANTS_SUSPENDERS_FRASS.NAME"
msgid "Arbor Hugger Pants"
msgstr "سروال معانق الأشجار"

#. STRINGS.BLUEPRINTS.PERMIT_PANTS_WADER_ALGAE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PANTS_WADER_ALGAE.DESC"
msgid "Hydrophobic high-waisted pants that also double as protective dinnerwear for messy eaters."
msgstr "سروال عالي الخصر طارد للماء يعمل أيضاً كملابس واقية أثناء تناول الطعام لمن يسكبون الطعام."

#. STRINGS.BLUEPRINTS.PERMIT_PANTS_WADER_ALGAE.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PANTS_WADER_ALGAE.NAME"
msgid "Fishing Waders"
msgstr "سروال صيد"

#. STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_ARCADE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_ARCADE.DESC"
msgid "It's playful, though it can't actually <i>be</i> played."
msgstr "إنها مرحة، على الرغم من أنه لا يمكن <i>لعبها</i> فعلياً."

#. STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_ARCADE.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_ARCADE.NAME"
msgid "<link=\"ITEMPEDESTAL\">Arcade Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">قاعدة ألعاب</link>"

#. STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_BATTERY.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_BATTERY.DESC"
msgid "Items displayed on this pedestal make a really \"power-full\" statement."
msgstr "العناصر المعروضة على هذه القاعدة تعطي انطباعاً \"مليئاً بالطاقة\"."

#. STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_BATTERY.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_BATTERY.NAME"
msgid "<link=\"ITEMPEDESTAL\">Power Bank Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">قاعدة بنك الطاقة</link>"

#. STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_COTTAGE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_COTTAGE.DESC"
msgid "A cozy spot to display cherished items."
msgstr "مكان مريح لعرض العناصر العزيزة."

#. STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_COTTAGE.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_COTTAGE.NAME"
msgid "<link=\"ITEMPEDESTAL\">Handcrafted Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">قاعدة مصنوعة يدوياً</link>"

#. STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_NEUTRONIUM.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_NEUTRONIUM.DESC"
msgid "This signet ring-style pedestal makes an opulent home for everything from crown jewels to knickknacks."
msgstr "هذه القاعدة ذات الطراز الخاتمي تجعل منزلاً فخماً لكل شيء بدءاً من جواهر التاج وحتى التحف الصغيرة."

#. STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_NEUTRONIUM.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_NEUTRONIUM.NAME"
msgid "<link=\"ITEMPEDESTAL\">Regal Neutronium Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">قاعدة نيوترونيوم ملكية</link>"

#. STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_SCREW_BRASS.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_SCREW_BRASS.DESC"
msgid "A display stand with a warm, brassy industrial aesthetic."
msgstr "منصة عرض ذات طابع صناعي نحاسي دافئ."

#. STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_SCREW_BRASS.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_SCREW_BRASS.NAME"
msgid "<link=\"ITEMPEDESTAL\">Brass Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">قاعدة نحاسية</link>"

#. STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_SCREW_CHROME.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_SCREW_CHROME.DESC"
msgid "A display stand with a cool, steely industrial aesthetic."
msgstr "منصة عرض ذات طابع صناعي فولاذي بارد."

#. STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_SCREW_CHROME.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PEDESTAL_SCREW_CHROME.NAME"
msgid "<link=\"ITEMPEDESTAL\">Chrome Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">قاعدة كرومية</link>"

#. STRINGS.BLUEPRINTS.PERMIT_PJ_BIOCIRCUIT_WILDBERRY.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_BIOCIRCUIT_WILDBERRY.DESC"
msgid "This plush onesie soothes workers who feel really wired."
msgstr "هذه البدلة المخملية المريحة تهدئ العمال الذين يشعرون بالتوتر الشديد."

#. STRINGS.BLUEPRINTS.PERMIT_PJ_BIOCIRCUIT_WILDBERRY.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_BIOCIRCUIT_WILDBERRY.NAME"
msgid "Bionic Jammies"
msgstr "بيجاما بيوني"

#. STRINGS.BLUEPRINTS.PERMIT_PJ_DINO.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_DINO.DESC"
msgid "Pajamas for the sleepy paleontology buffs in the colony."
msgstr "بيجاما لهواة علم الحفريات النعسانين في المستعمرة."

#. STRINGS.BLUEPRINTS.PERMIT_PJ_DINO.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_DINO.NAME"
msgid "Jurassic Jammies"
msgstr "بيجاما جوراسية"

#. STRINGS.BLUEPRINTS.PERMIT_PJ_DINO2.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_DINO2.DESC"
msgid "If all beds were part of a single bed mass, colony life would be one big slumber party."
msgstr "لو كانت كل الأسرّة جزءاً من كتلة سرير واحدة، لكانت حياة المستعمرة حفلة نوم كبيرة."

#. STRINGS.BLUEPRINTS.PERMIT_PJ_DINO2.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_DINO2.NAME"
msgid "Pangaea Jammies"
msgstr "بيجاما بانجيا"

#. STRINGS.BLUEPRINTS.PERMIT_PJ_DINO3.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_DINO3.DESC"
msgid "The label inside reads: \"If at first you can't fall asleep, tri, tri again.\""
msgstr "الملصق في الداخل يقول: \"إذا لم تستطع النوم في المرة الأولى، حاول وحاول مجدداً.\""

#. STRINGS.BLUEPRINTS.PERMIT_PJ_DINO3.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PJ_DINO3.NAME"
msgid "Triassic Jammies"
msgstr "بيجاما ترياسية"

#. STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_CYBERPUNK.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_CYBERPUNK.DESC"
msgid "It's seen things that Duplicants wouldn't believe."
msgstr "لقد رأت أشياء لن يصدقها المكررون."

#. STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_CYBERPUNK.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_CYBERPUNK.NAME"
msgid "<link=\"EXOBASEHEADQUARTERS\">Retro LED Mini-Pod</link>"
msgstr "<link=\"EXOBASEHEADQUARTERS\">كبسولة صغيرة بإضاءة ليد كلاسيكية</link>"

#. STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_DINO.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_DINO.DESC"
msgid "Before it was forgotten, it was revered."
msgstr "قبل أن تُنسى، كانت مُبجلة."

#. STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_DINO.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_DINO.NAME"
msgid "<link=\"EXOBASEHEADQUARTERS\">Forgotten Mini-Pod</link>"
msgstr "<link=\"EXOBASEHEADQUARTERS\">كبسولة صغيرة منسية</link>"

#. STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_ICE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_ICE.DESC"
msgid "It could run for a thousand cycles and still be cool to the touch."
msgstr "يمكنها العمل لألف دورة وتظل باردة عند اللمس."

#. STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_ICE.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_ICE.NAME"
msgid "<link=\"EXOBASEHEADQUARTERS\">Frosty Mini-Pod</link>"
msgstr "<link=\"EXOBASEHEADQUARTERS\">كبسولة فروستي المصغرة</link>"

#. STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_NEUTRONIUM.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_NEUTRONIUM.DESC"
msgid "A monument to the highfalutin' hopes and dreams of every spacefarer settling in on a new world."
msgstr "نصب تذكاري لآمال وأحلام كل مسافر فضائي يستقر في عالم جديد."

#. STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_NEUTRONIUM.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_PORTA_POD_Y_NEUTRONIUM.NAME"
msgid "<link=\"EXOBASEHEADQUARTERS\">Regal Neutronium Mini-Pod</link>"
msgstr "<link=\"EXOBASEHEADQUARTERS\">كبسولة نيوترونيوم صغيرة ملكية</link>"

#. STRINGS.BLUEPRINTS.PERMIT_RANCHERSTATION_COTTAGE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_RANCHERSTATION_COTTAGE.DESC"
msgid "Some ranchers believe that a woodsy aesthetic puts critters at ease."
msgstr "يعتقد بعض مربي المخلوقات أن الطابع الريفي يريح المخلوقات."

#. STRINGS.BLUEPRINTS.PERMIT_RANCHERSTATION_COTTAGE.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_RANCHERSTATION_COTTAGE.NAME"
msgid "<link=\"RANCHSTATION\">Rustic Grooming Station</link>"
msgstr "<link=\"RANCHSTATION\">محطة عناية ريفية</link>"

#. STRINGS.BLUEPRINTS.PERMIT_RANCHERSTATION_DINO.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_RANCHERSTATION_DINO.DESC"
msgid "These hardy plants survive on the small amounts of drool produced by happy critters during grooming sessions."
msgstr "تنمو هذه النباتات القوية على كميات صغيرة من اللعاب الذي تنتجه المخلوقات السعيدة أثناء جلسات العناية."

#. STRINGS.BLUEPRINTS.PERMIT_RANCHERSTATION_DINO.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_RANCHERSTATION_DINO.NAME"
msgid "<link=\"RANCHSTATION\">Overgrown Grooming Station</link>"
msgstr "<link=\"RANCHSTATION\">محطة عناية متضخمة</link>"

#. STRINGS.BLUEPRINTS.PERMIT_RANCHERSTATION_NEUTRONIUM.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_RANCHERSTATION_NEUTRONIUM.DESC"
msgid "Mirror, mirror, on the wall...who's the best-groomed of them all?"
msgstr "مرآتي، يا مرآتي على الجدار... من هو الأكثر أناقة بين الجميع؟"

#. STRINGS.BLUEPRINTS.PERMIT_RANCHERSTATION_NEUTRONIUM.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_RANCHERSTATION_NEUTRONIUM.NAME"
msgid "<link=\"RANCHSTATION\">Regal Neutronium Grooming Station</link>"
msgstr "<link=\"RANCHSTATION\">محطة تزيين النيوترونيوم الملكية</link>"

#. STRINGS.BLUEPRINTS.PERMIT_RESEARCH_CENTER_CYBERPUNK.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_RESEARCH_CENTER_CYBERPUNK.DESC"
msgid "Doin' research for the future, while diggin' the vibes of the past."
msgstr "إجراء أبحاث للمستقبل، بينما نستمتع بأجواء الماضي."

#. STRINGS.BLUEPRINTS.PERMIT_RESEARCH_CENTER_CYBERPUNK.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_RESEARCH_CENTER_CYBERPUNK.NAME"
msgid "<link=\"RESEARCHCENTER\">Retro LED Research Station</link>"
msgstr "<link=\"RESEARCHCENTER\">محطة أبحاث ذات ليد كلاسيكي</link>"

#. STRINGS.BLUEPRINTS.PERMIT_RESEARCH_CENTER2_CYBERPUNK.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_RESEARCH_CENTER2_CYBERPUNK.DESC"
msgid "Old-school cool, newfangled fact-finding."
msgstr "أناقة كلاسيكية، واكتشاف حقائق بأسلوب عصري."

#. STRINGS.BLUEPRINTS.PERMIT_RESEARCH_CENTER2_CYBERPUNK.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_RESEARCH_CENTER2_CYBERPUNK.NAME"
msgid "<link=\"ADVANCEDRESEARCHCENTER\">Retro LED Super Computer</link>"
msgstr "<link=\"ADVANCEDRESEARCHCENTER\">حاسوب فائق ذو ليد كلاسيكي</link>"

#. STRINGS.BLUEPRINTS.PERMIT_RESPECCER_NEUTRONIUM.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_RESPECCER_NEUTRONIUM.DESC"
msgid "Duplicants come out feeling very, very fancy, and knowing very, very little."
msgstr "يخرج المكررون وهم يشعرون بأنهم فاخرون جداً جداً، ويعرفون القليل جداً جداً."

#. STRINGS.BLUEPRINTS.PERMIT_RESPECCER_NEUTRONIUM.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_RESPECCER_NEUTRONIUM.NAME"
msgid "<link=\"RESETSKILLSSTATION\">Regal Neutronium Skill Scrubber</link>"
msgstr "<link=\"RESETSKILLSSTATION\">ماسحة مهارات النيوترونيوم الملكية</link>"

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_GULP.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_GULP.DESC"
msgid "The mighty Pacu refuses to explain its philosophy. It simply embodies it."
msgstr "سمكة الباكو العظيمة ترفض شرح فلسفتها. إنها تجسدها ببساطة."

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_GULP.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_GULP.NAME"
msgid "Stoic Trophy"
msgstr "تمثال الرواقي"

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_PACU.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_PACU.DESC"
msgid "Duplicants like to prank their friends by sticking their hands inside and pretending the sculpture has come to life."
msgstr "يحب المكررون مزاح أصدقائهم بوضع أيديهم في الداخل والتظاهر بأن التمثال قد دبت فيه الحياة."

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_PACU.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_PACU.NAME"
msgid "Chompionship Trophy"
msgstr "تمثال بطولة القضم"

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_PUFT.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_PUFT.DESC"
msgid "The face of truly blissful ignorance."
msgstr "وجه الجهل النعيم حقاً."

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_PUFT.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_PUFT.NAME"
msgid "Blank Slate"
msgstr "لوح فارغ"

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_WOOD_DEER.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_WOOD_DEER.DESC"
msgid "The sculptor used a tiny fleck of glass to mimic the mischievous glint of a Flox's eye."
msgstr "استخدم النحات ذرة صغيرة من الزجاج لمحاكاة البريق المشاكس في عين حيوان الفلوكس."

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_WOOD_DEER.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_ACTION_WOOD_DEER.NAME"
msgid "Sly Stare"
msgstr "نظرة ماكرة"

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_CUDDLEPIP.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_CUDDLEPIP.DESC"
msgid "Hindsight may be 20/20, but hind art is priceless."
msgstr "قد تكون الرؤية الخلفية واضحة، لكن الفن الخلفي لا يقدر بثمن."

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_CUDDLEPIP.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_CUDDLEPIP.NAME"
msgid "Pip Rump"
msgstr "مؤخرة البيب"

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_DRECKO.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_DRECKO.DESC"
msgid "The post-shearing version was considered too risque."
msgstr "اعتبرت النسخة التي تلت القص جريئة أكثر من اللازم."

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_DRECKO.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_DRECKO.NAME"
msgid "Drecko Rump"
msgstr "مؤخرة الدريكو"

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_PUFT.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_PUFT.DESC"
msgid "Occasionally emits a barely audible toot."
msgstr "تصدر أحياناً صوتاً خافتاً بالكاد يُسمع."

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_PUFT.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_PUFT.NAME"
msgid "Puft Rump"
msgstr "مؤخرة البوفت"

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_SHOVEVOLE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_SHOVEVOLE.DESC"
msgid "Behind every great critter, is that critter's great behind."
msgstr "خلف كل مخلوق عظيم، توجد مؤخرة ذلك المخلوق العظيمة."

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_SHOVEVOLE.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_AMAZING_REAR_SHOVEVOLE.NAME"
msgid "Vole Rump"
msgstr "مؤخرة الفول"

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_CRAP_LOW_ONE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_CRAP_LOW_ONE.DESC"
msgid "Was this piece carved by an artist, or gnawed on by a critter? No one knows."
msgstr "هل نُحتت هذه القطعة بواسطة فنان، أم قضمها أحد المخلوقات؟ لا أحد يعلم."

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_CRAP_LOW_ONE.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_CRAP_LOW_ONE.NAME"
msgid "Chipped Trunk"
msgstr "جذع مكسور"

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_OKAY_MID_ONE.DESC
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_OKAY_MID_ONE.DESC"
msgid "A realistic rendition of Sleet Wheat, also known as \"a mouth full of splinters just waiting to happen.\""
msgstr "تجسيد واقعي لقمح السلييت، المعروف أيضاً باسم \"فم مليء بالشظايا بانتظار حدوث كارثة\"."

#. STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_OKAY_MID_ONE.NAME
msgctxt "STRINGS.BLUEPRINTS.PERMIT_SCULPTURE_WOOD_OKAY_MID_ONE.NAME"
msgid "Wood Grain"
msgstr "تعريق الخشب"

