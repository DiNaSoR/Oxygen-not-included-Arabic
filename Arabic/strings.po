msgid "Natural resource harvested from certain <link=\"CREATURES\">Critters</link> and <link=\"PLANTS\">Plants</link>.\n\nUsed in construction or <link=\"HEAT\">Heat</link> production."
msgstr "مورد طبيعي يتم حصاده من بعض <link=\"CREATURES\">المخلوقات</link> و<link=\"PLANTS\">النباتات</link>.\n\nيُستخدم في البناء أو إنتاج <link=\"HEAT\">الحرارة</link>."

