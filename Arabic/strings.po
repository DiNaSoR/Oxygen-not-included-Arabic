#. STRINGS.CREATURES.SPECIES.ICEBELLY.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.BABY.DESC"
msgid "A floofy little Bammini.\n\nIn time it will mature into a fully grown <link=\"ICEBELLY\">Bammoth</link>."
msgstr "كائن باميني صغير وفروي.\n\nبمرور الوقت سينضج ليصبح <link=\"ICEBELLY\">باموث</link> كامل النمو."

#. STRINGS.CREATURES.SPECIES.ICEBELLY.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.BABY.NAME"
msgid "<link=\"ICEBELLY\">Bammini</link>"
msgstr "<link=\"ICEBELLY\">باميني</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.DESC"
msgid "Bammoths are lumbering, nonhostile creatures that subsist on <link=\"CARROT\">Plume Squash</link>, <link=\"BEANPLANTSEED\">Nosh Beans</link> and <link=\"FRIESCARROT\">Squash Fries</link>.\n\nTheir thick overcoats can be shorn for <link=\"BASICFABRIC\">Reed Fiber</link>."
msgstr "الباموث هي مخلوقات بطيئة وغير عدائية تقتات على <link=\"CARROT\">قرع الريش</link> و<link=\"BEANPLANTSEED\">فاصوليا نوش</link> و<link=\"FRIESCARROT\">مقليات القرع</link>.\n\nيمكن جز معاطفها السميكة للحصول على <link=\"BASICFABRIC\">ألياف القصب</link>."

#. STRINGS.CREATURES.SPECIES.ICEBELLY.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.EGG_NAME"
msgid "<link=\"ICEBELLY\">Bammoth Egg</link>"
msgstr "<link=\"ICEBELLY\">بيضة الباموث</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.NAME"
msgid "<link=\"ICEBELLY\">Bammoth</link>"
msgstr "<link=\"ICEBELLY\">باموث</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.BABY.DESC"
msgid "A haughty little Regal Bammini.\n\nIn time it will mature into a fully grown <link=\"GOLDBELLY\">Regal Bammoth</link>."
msgstr "باميني ملكي صغير ومتغطرس.\n\nمع مرور الوقت سينضج ليصبح <link=\"GOLDBELLY\">باموث ملكي</link> مكتمل النمو."

#. STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.BABY.NAME"
msgid "<link=\"GOLDBELLY\">Regal Bammini</link>"
msgstr "<link=\"GOLDBELLY\">باميني ملكي</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.DESC"
msgid "Regal Bammoths are nonhostile creatures that subsist on <link=\"CARROT\">Plume Squash</link> and <link=\"BEANPLANTSEED\">Nosh Beans</link>.\n\nTheir ornate crests grow only when they are fed <link=\"FRIESCARROT\">Squash Fries</link>."
msgstr "الباموث الملكي هي مخلوقات غير عدائية تقتات على <link=\"CARROT\">قرع الريش</link> و<link=\"BEANPLANTSEED\">فاصوليا نوش</link>.\n\nلا تنمو أعرافها المزخرفة إلا عندما تتغذى على <link=\"FRIESCARROT\">مقليات القرع</link>."

#. STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.EGG_NAME"
msgid "<link=\"GOLDBELLY\">Regal Bammoth Egg</link>"
msgstr "<link=\"GOLDBELLY\">بيضة الباموث الملكي</link>"

#. STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICEBELLY.VARIANT_GOLD.NAME"
msgid "<link=\"GOLDBELLY\">Regal Bammoth</link>"
msgstr "<link=\"GOLDBELLY\">باموث ملكي</link>"

#. STRINGS.CREATURES.SPECIES.ICECAVESFORAGEPLANTPLANTED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICECAVESFORAGEPLANTPLANTED.DESC"
msgid "Sherberries are incapable of propagating, but can be harvested for a single <link=\"FOOD\">Food</link> serving."
msgstr "ثمار الشيربيري غير قادرة على التكاثر، ولكن يمكن حصادها للحصول على حصة واحدة من <link=\"FOOD\">طعام</link>."

#. STRINGS.CREATURES.SPECIES.ICECAVESFORAGEPLANTPLANTED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.ICECAVESFORAGEPLANTPLANTED.NAME"
msgid "<link=\"ICECAVESFORAGEPLANTPLANTED\">Sherberry Plant</link>"
msgstr "<link=\"ICECAVESFORAGEPLANTPLANTED\">نبات شيربيري</link>"

#. STRINGS.CREATURES.SPECIES.ICEFLOWER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEFLOWER.DESC"
msgid "Idyllas are <link=\"DECOR\">Decorative</link> <link=\"PLANTS\">Plants</link> with soft, pompom-shaped blossoms.\n\nGazing dreamily at them has a positive effect on <link=\"MORALE\">Morale</link>."
msgstr "إيديلا هي <link=\"DECOR\">نباتات</link> <link=\"PLANTS\">تزيينية</link> ذات أزهار ناعمة تشبه كرات البوم بوم.\n\nالتأمل فيها بحلم له تأثير إيجابي على <link=\"MORALE\">المعنويات</link>."

#. STRINGS.CREATURES.SPECIES.ICEFLOWER.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.ICEFLOWER.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "هذا النبات يحسن <link=\"DECOR\">الديكور</link> المحيط."

