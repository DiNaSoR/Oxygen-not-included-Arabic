#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.REFINED_SUGAR.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.REFINED_SUGAR.DESC"
msgid "A seasoning that Duplicants can add to their <link=\"FOOD\">Food</link> to boost <link=\"MORALE\">Morale</link>.\n\nDuplicants will automatically use Refined Sugar while sitting at a <link=\"DININGTABLE\">Mess Table</link> during mealtime.\n\n<i>Only the finest grains are chosen.</i>"
msgstr "تتبيلة يمكن للمكررين إضافتها إلى <link=\"FOOD\">طعامهم</link> لتعزيز <link=\"MORALE\">المعنويات</link>.\n\nسيستخدم المكررون السكر المكرر تلقائياً أثناء الجلوس على <link=\"DININGTABLE\">طاولة الطعام</link> أثناء وقت الوجبة.\n\n<i>يتم اختيار أجود الحبيبات فقط.</i>"

#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.REFINED_SUGAR.NAME
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.REFINED_SUGAR.NAME"
msgid "Refined Sugar"
msgstr "سكر مكرر"

