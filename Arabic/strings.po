msgstr "تم عناق هذا المخلوق مؤخراً من قبل مكرر وهو يشعر بمودة إضافية\n\nأثناء وجوده في هذه الحالة، فإنه يعانق <style=\"KKeyword\">البيض</style> بشكل متكرر أكثر"

#. STRINGS.CREATURES.MODIFIERS.HUNT_FAILED.NAME
msgctxt "STRINGS.CREATURES.MODIFIERS.HUNT_FAILED.NAME"
