msgstr "<link=\"CRITTERTRAPPLANT\">مصيدة مخلوقات زحل</link>"

#. STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.PLANT_HUNGER_REQUIREMENT
msgctxt "STRINGS.CREATURES.SPECIES.CRITTERTRAPPLANT.PLANT_HUNGER_REQUIREMENT"
