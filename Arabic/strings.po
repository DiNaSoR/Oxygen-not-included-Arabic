msgstr "محيط تحت السطح"

#. STRINGS.WORLD_TRAITS.VOLCANOES.DESCRIPTION
msgctxt "STRINGS.WORLD_TRAITS.VOLCANOES.DESCRIPTION"
msgid "Several active <style=\"KKeyword\">Volcanoes</style> have been detected in this world"
msgstr "تم اكتشاف العديد من <style=\"KKeyword\">البراكين</style> النشطة في هذا العالم"

#. STRINGS.WORLD_TRAITS.VOLCANOES.NAME
msgctxt "STRINGS.WORLD_TRAITS.VOLCANOES.NAME"
msgid "Volcanic Activity"
msgstr "نشاط بركاني"

#. STRINGS.WORLDS.BADLANDS.DESCRIPTION
msgctxt "STRINGS.WORLDS.BADLANDS.DESCRIPTION"
msgid "A barren location with an overabundance of mineral resources.\n\n<smallcaps>The rocky terrain of The Badlands poses no immediate threats, but sparse resource availability will make expansion and technological progress challenging.</smallcaps>\n\n"
msgstr "موقع قاحل مع وفرة زائدة من الموارد المعدنية.\n\n<smallcaps>لا تشكل التضاريس الصخرية في الأراضي القاحلة أي تهديدات فورية، لكن ندرة الموارد ستجعل التوسع والتقدم التكنولوجي أمراً صعباً.</smallcaps>\n\n"

#. STRINGS.WORLDS.BADLANDS.NAME
msgctxt "STRINGS.WORLDS.BADLANDS.NAME"
msgid "The Badlands"
msgstr "الأراضي القاحلة"

#. STRINGS.WORLDS.BIGEMPTY.DESCRIPTION
msgctxt "STRINGS.WORLDS.BIGEMPTY.DESCRIPTION"
msgid "A big ol' biome-free spacerock for claustrophobic devs."
msgstr "صخرة فضاء كبيرة وخالية من المناطق الحيوية للمطورين الذين يعانون من رهاب الأماكن المغلقة."

#. STRINGS.WORLDS.BIGEMPTY.NAME
msgctxt "STRINGS.WORLDS.BIGEMPTY.NAME"
msgid "Big Empty FOR DEVS"
msgstr "فراغ كبير للمطورين"

#. STRINGS.WORLDS.CERESBASEGAME.DESCRIPTION
msgctxt "STRINGS.WORLDS.CERESBASEGAME.DESCRIPTION"
msgid "A frosty location with sub-zero temperatures throughout.\n\n<smallcaps>Duplicants who work in Ceres's sub-zero temperatures will need to wear or build warming equipment. Abundant natural fuel sources could lead to a well-powered colony.</smallcaps>"
msgstr "موقع متجمد مع درجات حرارة تحت الصفر في كل مكان.\n\n<smallcaps>سيحتاج المكررون الذين يعملون في درجات حرارة سيريس التي تحت الصفر إلى ارتداء أو بناء معدات تدفئة. يمكن أن تؤدي مصادر الوقود الطبيعية الوفيرة إلى مستعمرة تعمل بالطاقة بشكل جيد.</smallcaps>"

#. STRINGS.WORLDS.CERESBASEGAME.NAME
msgctxt "STRINGS.WORLDS.CERESBASEGAME.NAME"
msgid "Ceres"
msgstr "سيريس"

#. STRINGS.WORLDS.CERESBASEGAMESHATTERED.DESCRIPTION
msgctxt "STRINGS.WORLDS.CERESBASEGAMESHATTERED.DESCRIPTION"
msgid "The heavily damaged remnants of a frosty location with sub-zero temperatures throughout.\n\n<smallcaps>Exploring the rubble of Blasted Ceres's sub-zero temperatures is particularly challenging, yet natural fuel sources provide a valuable payoff.</smallcaps>"
msgstr "بقايا مدمرة بشدة لموقع متجمد مع درجات حرارة تحت الصفر في كل مكان.\n\n<smallcaps>يعد استكشاف أنقاض درجات حرارة سيريس المدمرة التي تحت الصفر أمراً صعباً بشكل خاص، ومع ذلك توفر مصادر الوقود الطبيعية عائداً قيماً.</smallcaps>"

#. STRINGS.WORLDS.CERESBASEGAMESHATTERED.NAME
msgctxt "STRINGS.WORLDS.CERESBASEGAMESHATTERED.NAME"
msgid "Blasted Ceres"
msgstr "سيريس المدمرة"

