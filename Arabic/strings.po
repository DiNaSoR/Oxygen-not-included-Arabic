msgctxt "STRINGS.ITEMS.FOOD.COOKEDMEAT.DESC"
msgid "The cooked meat of a defeated critter.\n\nIt has a delightful smoky aftertaste."
msgstr "اللحم المطهو لمخلوق مهزوم.\n\nيتمتع بمذاق مدخن لذيذ."

#. STRINGS.ITEMS.FOOD.COOKEDMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.COOKEDMEAT.NAME"
