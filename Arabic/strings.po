msgstr "كومة مقرمشة من <link=\"BEANPLANTSEED\">فاصوليا نوش</link> مقلية في <link=\"TALLOW\">شحم</link>."

#. STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.DESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.DESC"
msgid "A crispy deep-fried critter claw."
msgstr "مخلب مخلوق مقلي ومقرمش."

#. STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.NAME
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.NAME"
msgid "<link=\"DEEPFRIEDSHELLFISH\">Shellfish Tempura</link>"
msgstr "<link=\"DEEPFRIEDSHELLFISH\">تمبورا المحار</link>"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.RECIPEDESC"
msgid "A tender chunk of battered <link=\"SHELLFISHMEAT\">Raw Shellfish</link> deep-fried in <link=\"TALLOW\">Tallow</link>."
msgstr "قطعة طرية من <link=\"SHELLFISHMEAT\">محار نيء</link> مغطاة بالعجين ومقلية في <link=\"TALLOW\">شحم</link>."

#. STRINGS.ITEMS.FOOD.DINOSAURMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.DINOSAURMEAT.DESC"
msgid "Uncooked meat from a very dead critter.\n\nIt's inedible until cooked in the <link=\"SMOKER\">Smoker</link>."
msgstr "لحم غير مطهو من مخلوق ميت جداً.\n\nإنه غير صالح للأكل حتى يتم طهيه في <link=\"SMOKER\">المدخن</link>."

#. STRINGS.ITEMS.FOOD.DINOSAURMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.DINOSAURMEAT.NAME"
msgid "<link=\"DINOSAURMEAT\">Tough Meat</link>"
msgstr "<link=\"DINOSAURMEAT\">لحم قاسي</link>"

#. STRINGS.ITEMS.FOOD.DRECKOEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.DRECKOEGG.DESC"
