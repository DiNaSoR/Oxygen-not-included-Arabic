#. STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.TABLE_SALT.DESC
msgctxt "STRINGS.ITEMS.INDUSTRIAL_PRODUCTS.TABLE_SALT.DESC"
msgid "A seasoning that Duplicants can add to their <link=\"FOOD\">Food</link> to boost <link=\"MORALE\">Morale</link>.\n\nDuplicants will automatically use Table Salt while sitting at a <link=\"DININGTABLE\">Mess Table</link> during mealtime.\n\n<i>Only the finest grains are chosen.</i>"
msgstr "توابل يمكن للمكررين إضافتها إلى <link=\"FOOD\">طعامهم</link> لتعزيز <link=\"MORALE\">المعنويات</link>.\n\nسيستخدم المكررون ملح الطعام تلقائيًا أثناء الجلوس على <link=\"DININGTABLE\">طاولة طعام</link> في وقت الوجبة.\n\n<i>يتم اختيار أجود الحبيبات فقط.</i>"

