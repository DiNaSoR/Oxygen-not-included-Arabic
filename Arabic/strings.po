msgid "Radbolts"
msgstr "مسامير إشعاعية"

#. STRINGS.ITEMS.RAILGUNPAYLOAD.DESC
msgctxt "STRINGS.ITEMS.RAILGUNPAYLOAD.DESC"
msgid "Contains resources packed for interstellar shipping.\n\nCan be launched by a <link=\"RAILGUN\">Interplanetary Launcher</link> or unpacked with a <link=\"RAILGUNPAYLOADOPENER\">Payload Opener</link>."
msgstr "تحتوي على موارد معبأة للشحن بين الكواكب.\n\nيمكن إطلاقها بواسطة <link=\"RAILGUN\">قاذفة بين الكواكب</link> أو تفريغها باستخدام <link=\"RAILGUNPAYLOADOPENER\">فتاحة حمولة</link>."

#. STRINGS.ITEMS.RAILGUNPAYLOAD.NAME
msgctxt "STRINGS.ITEMS.RAILGUNPAYLOAD.NAME"
