#. STRINGS.BUILDINGS.PREFABS.POIDLC2SHOWROOMDOOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.POIDLC2SHOWROOMDOOR.EFFECT"
msgid "Large double doors identical to those you might find at the main entrance to a large facility."
msgstr "أبواب مزدوجة كبيرة مطابقة لتلك التي قد تجدها عند المدخل الرئيسي لمنشأة كبيرة."

#. STRINGS.BUILDINGS.PREFABS.POIDLC2SHOWROOMDOOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.POIDLC2SHOWROOMDOOR.NAME"
msgid "Showroom Doors"
msgstr "أبواب صالة العرض"

#. STRINGS.BUILDINGS.PREFABS.POIDOORINTERNAL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.POIDOORINTERNAL.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.POIDOORINTERNAL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.POIDOORINTERNAL.EFFECT"
msgid "A strong door with a sophisticated genetic lock."
msgstr "باب قوي مزود بقفل جيني متطور."

#. STRINGS.BUILDINGS.PREFABS.POIDOORINTERNAL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.POIDOORINTERNAL.NAME"
msgid "Security Door"
msgstr "باب أمني"

#. STRINGS.BUILDINGS.PREFABS.POIFACILITYDOOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.POIFACILITYDOOR.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.POIFACILITYDOOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.POIFACILITYDOOR.EFFECT"
msgid "Large double doors that were once the main entrance to a large facility."
msgstr "أبواب مزدوجة كبيرة كانت يوماً ما المدخل الرئيسي لمنشأة كبيرة."

#. STRINGS.BUILDINGS.PREFABS.POIFACILITYDOOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.POIFACILITYDOOR.NAME"
msgid "Lobby Doors"
msgstr "أبواب الردهة"

#. STRINGS.BUILDINGS.PREFABS.POLYMERIZER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.POLYMERIZER.DESC"
msgid "Plastic can be used to craft unique buildings and goods."
msgstr "يمكن استخدام البلاستيك لصناعة مبانٍ وسلع فريدة."

#. STRINGS.BUILDINGS.PREFABS.POLYMERIZER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.POLYMERIZER.EFFECT"
msgid "Converts <link=\"PLASTIFIABLELIQUID\">Plastic Monomers</link> into raw <link=\"POLYPROPYLENE\">Plastic</link>."
msgstr "يحول <link=\"PLASTIFIABLELIQUID\">مونومرات البلاستيك</link> إلى <link=\"POLYPROPYLENE\">بلاستيك</link> خام."

#. STRINGS.BUILDINGS.PREFABS.POLYMERIZER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.POLYMERIZER.NAME"
msgid "<link=\"POLYMERIZER\">Polymer Press</link>"
msgstr "<link=\"POLYMERIZER\">مكبس البوليمر</link>\""

#. STRINGS.BUILDINGS.PREFABS.POWERCONTROLSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERCONTROLSTATION.DESC"
msgid "Only one Duplicant may be assigned to a station at a time."
msgstr "يمكن لمكرر واحد فقط أن يتم تعيينه في المحطة في كل مرة."

#. STRINGS.BUILDINGS.PREFABS.POWERCONTROLSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERCONTROLSTATION.EFFECT"
msgid "Produces <link=\"POWERSTATIONTOOLS\">Microchip</link> to increase the <link=\"POWER\">Power</link> output of generators.\n\nAssigned Duplicants must possess the <link=\"TECHNICALS2\">Tune Up</link> trait."
msgstr "ينتج <link=\"POWERSTATIONTOOLS\">رقاقة دقيقة</link> لزيادة مخرج <link=\"POWER\">الطاقة</link> للمولدات.\n\nيجب أن يمتلك المكررون المعينون سمة <link=\"TECHNICALS2\">الضبط</link>."

#. STRINGS.BUILDINGS.PREFABS.POWERCONTROLSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERCONTROLSTATION.NAME"
msgid "<link=\"POWERCONTROLSTATION\">Power Control Station</link>"
msgstr "<link=\"POWERCONTROLSTATION\">محطة التحكم بالطاقة</link>"

#. STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMER.DESC"
msgid "It's a power transformer, but larger."
msgstr "إنه محول طاقة، لكنه أكبر حجماً."

#. STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMER.EFFECT"
msgid "Limits <link=\"POWER\">Power</link> flowing through the Transformer to 4 kW.\n\nConnect <link=\"BATTERY\">Batteries</link> on the large side to act as a valve and prevent <link=\"WIRE\">Wires</link> from drawing more than 4 kW.\n\nCan be rotated before construction."
msgstr "يحدد <link=\"POWER\">الطاقة</link> المتدفقة عبر المحول إلى 4 كيلوواط.\n\nقم بتوصيل <link=\"BATTERY\">البطاريات</link> على الجانب الكبير لتعمل كصمام وتمنع <link=\"WIRE\">الأسلاك</link> من سحب أكثر من 4 كيلوواط.\n\nيمكن تدويره قبل البناء."

#. STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMER.NAME"
msgid "<link=\"POWERTRANSFORMER\">Large Power Transformer</link>"
msgstr "<link=\"POWERTRANSFORMER\">محول طاقة كبير</link>"

#. STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMERSMALL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMERSMALL.DESC"
msgid "Limiting the power drawn by wires prevents them from incurring overload damage."
msgstr "يمنع تحديد الطاقة المسحوبة بواسطة الأسلاك تعرضها لأضرار التحميل الزائد."

#. STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMERSMALL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMERSMALL.EFFECT"
msgid "Limits <link=\"POWER\">Power</link> flowing through the Transformer to 1000 W.\n\nConnect <link=\"BATTERY\">Batteries</link> on the large side to act as a valve and prevent <link=\"WIRE\">Wires</link> from drawing more than 1000 W.\n\nCan be rotated before construction."
msgstr "يحدد <link=\"POWER\">الطاقة</link> المتدفقة عبر المحول إلى 1000 واط.\n\nقم بتوصيل <link=\"BATTERY\">البطاريات</link> على الجانب الكبير لتعمل كصمام وتمنع <link=\"WIRE\">الأسلاك</link> من سحب أكثر من 1000 واط.\n\nيمكن تدويره قبل البناء."

#. STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMERSMALL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMERSMALL.NAME"
msgid "<link=\"POWERTRANSFORMERSMALL\">Power Transformer</link>"
msgstr "<link=\"POWERTRANSFORMERSMALL\">محول طاقة</link>"

#. STRINGS.BUILDINGS.PREFABS.PRESSUREDOOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSUREDOOR.DESC"
msgid "Mechanized airlocks open and close more quickly than other types of door."
msgstr "تفتح وتغلق الأبواب الهوائية الآلية بسرعة أكبر من أنواع الأبواب الأخرى."

#. STRINGS.BUILDINGS.PREFABS.PRESSUREDOOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSUREDOOR.EFFECT"
msgid "Blocks <link=\"ELEMENTSLIQUID\">Liquid</link> and <link=\"ELEMENTSGAS\">Gas</link> flow, maintaining pressure between areas.\n\nFunctions as a <link=\"MANUALPRESSUREDOOR\">Manual Airlock</link> when no <link=\"POWER\">Power</link> is available.\n\nWild <link=\"CREATURES\">Critters</link> cannot pass through doors."
msgstr "يمنع تدفق <link=\"ELEMENTSLIQUID\">السائل</link> و<link=\"ELEMENTSGAS\">الغاز</link>، مما يحافظ على الضغط بين المناطق.\n\nيعمل كـ <link=\"MANUALPRESSUREDOOR\">قفل هوائي يدوي</link> عند عدم توفر <link=\"POWER\">طاقة</link>.\n\nلا يمكن لـ <link=\"CREATURES\">المخلوقات</link> البرية المرور عبر الأبواب."

#. STRINGS.BUILDINGS.PREFABS.PRESSUREDOOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSUREDOOR.NAME"
msgid "<link=\"PRESSUREDOOR\">Mechanized Airlock</link>"
msgstr "<link=\"PRESSUREDOOR\">قفل هوائي آلي</link>"

#. STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHGAS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHGAS.DESC"
msgid "An atmo switch shuts off power when the air pressure surrounding it surpasses the set threshold."
msgstr "يقوم مفتاح الأتمو بقطع الطاقة عندما يتجاوز ضغط الهواء المحيط به الحد المحدد."

#. STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHGAS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHGAS.EFFECT"
msgid "Automatically turns <link=\"POWER\">Power</link> on or off using ambient <link=\"PRESSURE\">Gas Pressure</link> .\n\nDoes not affect circuitry preceding the switch."
msgstr "يقوم بتشغيل أو إيقاف <link=\"POWER\">الطاقة</link> تلقائياً باستخدام <link=\"PRESSURE\">ضغط الغاز</link> المحيط.\n\nلا يؤثر على الدوائر التي تسبق المفتاح."

#. STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHGAS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHGAS.NAME"
msgid "<link=\"PRESSURESWITCHGAS\">Atmo Switch</link>"
msgstr "<link=\"PRESSURESWITCHGAS\">مفتاح أتمو</link>"

#. STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHLIQUID.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHLIQUID.DESC"
msgid "A hydro switch shuts off power when the liquid pressure surrounding it surpasses the set threshold."
msgstr "يقوم مفتاح مائي بقطع الطاقة عندما يتجاوز ضغط السائل المحيط به الحد المحدد."

#. STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHLIQUID.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHLIQUID.EFFECT"
msgid "Automatically turns <link=\"POWER\">Power</link> on or off using ambient <link=\"PRESSURE\">Liquid Pressure</link>.\n\nDoes not affect circuitry preceding the switch.\n\nMust be submerged in <link=\"ELEMENTSLIQUID\">Liquid</link>."
msgstr "يقوم بتشغيل أو إيقاف <link=\"POWER\">الطاقة</link> تلقائياً باستخدام <link=\"PRESSURE\">ضغط السائل</link> المحيط.\n\nلا يؤثر على الدوائر التي تسبق المفتاح.\n\nيجب أن يكون مغموراً في <link=\"ELEMENTSLIQUID\">سائل</link>."

#. STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHLIQUID.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHLIQUID.NAME"
msgid "<link=\"PRESSURESWITCHLIQUID\">Hydro Switch</link>"
msgstr "<link=\"PRESSURESWITCHLIQUID\">مفتاح مائي</link>"

#. STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERA.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERA.DESC"
msgid "A poster promoting a local tourist attraction.\n\nActual scenery may vary."
msgstr "ملصق يروج لمعلم سياحي محلي.\n\nقد يختلف المشهد الفعلي."

#. STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERA.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERA.NAME"
msgid "Travel Poster"
msgstr "ملصق سفر"

#. STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERB.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERB.DESC"
msgid "A poster promoting local wildlife.\n\nThe first in an unfinished series."
msgstr "ملصق يروج للحياة البرية المحلية.\n\nالأول في سلسلة غير مكتملة."

#. STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERB.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERB.NAME"
msgid "Travel Poster"
msgstr "ملصق سفر"

#. STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERLARGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERLARGE.DESC"
msgid "A sound-absorbing panel that makes small-space living more bearable.\n\nThe artwork features a  power source."
msgstr "لوحة ممتصة للصوت تجعل العيش في المساحات الصغيرة أكثر احتمالاً.\n\nيحتوي العمل الفني على مصدر طاقة."

#. STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERLARGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERLARGE.NAME"
msgid "Acoustic Art Panel"
msgstr "لوحة فنية صوتية"

#. STRINGS.BUILDINGS.PREFABS.PROPCLOCK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCLOCK.DESC"
msgid "A simple wall clock.\n\nIt is no longer ticking."
msgstr "ساعة حائط بسيطة.\n\nلم تعد تدق."

#. STRINGS.BUILDINGS.PREFABS.PROPCLOCK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCLOCK.NAME"
msgid "Clock"
msgstr "ساعة"

#. STRINGS.BUILDINGS.PREFABS.PROPCLOTHESHANGER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCLOTHESHANGER.DESC"
msgid "Holds one <link=\"WARMVEST\">Warm Coat</link>.\n\nIt'd be silly not to use it."
msgstr "تحمل <link=\"WARMVEST\">معطفاً دافئاً</link> واحداً.\n\nسيكون من السخف عدم استخدامه."

#. STRINGS.BUILDINGS.PREFABS.PROPCLOTHESHANGER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCLOTHESHANGER.NAME"
msgid "Coat Rack"
msgstr "رف معاطف"

#. STRINGS.BUILDINGS.PREFABS.PROPDESK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDESK.DESC"
msgid "An intact office desk, decorated with several personal belongings and a barely functioning computer."
msgstr "مكتب عمل سليم، مزين ببعض المتعلقات الشخصية وحاسوب بالكاد يعمل."

#. STRINGS.BUILDINGS.PREFABS.PROPDESK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDESK.NAME"
msgid "Computer Desk"
msgstr "مكتب حاسوب"

#. STRINGS.BUILDINGS.PREFABS.PROPDLC2DISPLAY1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDLC2DISPLAY1.DESC"
msgid "An electronic display projecting the blueprint of an engineering project.\n\nIt looks like a pump of some kind."
msgstr "شاشة إلكترونية تعرض مخططاً لمشروع هندسي.\n\nتبدو كمضخة من نوع ما."

#. STRINGS.BUILDINGS.PREFABS.PROPDLC2DISPLAY1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDLC2DISPLAY1.NAME"
msgid "Electronic Display"
msgstr "شاشة إلكترونية"

#. STRINGS.BUILDINGS.PREFABS.PROPDLC2GEOTHERMALCART.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDLC2GEOTHERMALCART.DESC"
msgid "Maintenance equipment that once flushed debris out of complex mechanisms.\n\nOne of the wheels is squeaky."
msgstr "معدات صيانة كانت تستخدم قديماً لطرد الحطام من الآليات المعقدة.\n\nإحدى العجلات تصدر صريراً."

#. STRINGS.BUILDINGS.PREFABS.PROPDLC2GEOTHERMALCART.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDLC2GEOTHERMALCART.NAME"
msgid "Service Cart"
msgstr "عربة خدمة"

#. STRINGS.BUILDINGS.PREFABS.PROPELEVATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPELEVATOR.DESC"
msgid "Out of service.\n\nThe buttons inside indicate it went down more than a dozen floors at one point in time."
msgstr "خارج الخدمة.\n\nتشير الأزرار الموجودة بالداخل إلى أنه كان ينزل لأكثر من اثني عشر طابقاً في وقت ما."

#. STRINGS.BUILDINGS.PREFABS.PROPELEVATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPELEVATOR.NAME"
msgid "Broken Elevator"
msgstr "مصعد معطل"

#. STRINGS.BUILDINGS.PREFABS.PROPEXOSETLOCKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSETLOCKER.DESC"
msgid "A locker made with ultra-lightweight textiles.\n\nIt contains an assortment of personal effects."
msgstr "خزانة مصنوعة من منسوجات خفيفة الوزن للغاية.\n\nتحتوي على مجموعة من المتعلقات الشخصية."

#. STRINGS.BUILDINGS.PREFABS.PROPEXOSETLOCKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSETLOCKER.NAME"
msgid "Off-site Locker"
msgstr "خزانة خارجية"

#. STRINGS.BUILDINGS.PREFABS.PROPEXOSHELFLONG.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSHELFLONG.DESC"
msgid "A shelf made out of flat-packed pieces that can be assembled in various ways.\n\nThis is the long way."
msgstr "رف مصنوع من قطع مسطحة يمكن تجميعها بطرق مختلفة.\n\nهذه هي الطريقة الطويلة."

#. STRINGS.BUILDINGS.PREFABS.PROPEXOSHELFLONG.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSHELFLONG.NAME"
msgid "Long Prefab Shelf"
msgstr "رف جاهز طويل"

#. STRINGS.BUILDINGS.PREFABS.PROPEXOSHELSHORT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSHELSHORT.DESC"
msgid "A shelf made out of flat-packed pieces that can be assembled in various ways.\n\nIt looks nice, actually."
msgstr "رف مصنوع من قطع مسطحة يمكن تجميعها بطرق مختلفة.\n\nيبدو جميلاً في الواقع."

#. STRINGS.BUILDINGS.PREFABS.PROPEXOSHELSHORT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSHELSHORT.NAME"
msgid "Prefab Shelf"
msgstr "رف جاهز"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHAIR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHAIR.DESC"
msgid "A chair where visitors can comfortably wait before their appointments."
msgstr "كرسي حيث يمكن للزوار الانتظار براحة قبل مواعيدهم."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHAIR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHAIR.NAME"
msgid "Lobby Chair"
msgstr "كرسي ردهة"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHANDELIER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHANDELIER.DESC"
msgid "A large chandelier that hangs from the ceiling.\n\nIt does not appear to function."
msgstr "ثريا كبيرة تتدلى من السقف.\n\nلا يبدو أنها تعمل."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHANDELIER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHANDELIER.NAME"
msgid "Chandelier"
msgstr "ثريا"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYCOUCH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCOUCH.DESC"
msgid "A couch where visitors can comfortably wait before their appointments."
msgstr "أريكة حيث يمكن للزوار الانتظار براحة قبل مواعيدهم."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYCOUCH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCOUCH.NAME"
msgid "Lobby Couch"
msgstr "أريكة ردهة"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYDESK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDESK.DESC"
msgid "A spotless desk filled with impeccably organized office supplies.\n\nA photo peeks out from beneath the desk pad, depicting two beaming young women in caps and gowns.\n\nThe photo is quite old."
msgstr "مكتب نظيف مليء بلوازم مكتبية منظمة بشكل لا تشوبه شائبة.\n\nتظهر صورة من تحت وسادة المكتب، تصور شابتين مبتسمتين ترتديان قبعات وثياب تخرج.\n\nالصورة قديمة جداً."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYDESK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDESK.NAME"
