msgstr "<link=\"STORAGELOCKER\">صندوق تخزين</link>"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.DESC"
msgid "Smart storage bins can automate resource organization based on type and mass."
msgstr "يمكن لصناديق التخزين الذكية أتمتة تنظيم الموارد بناءً على النوع والكتلة."

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.EFFECT"
msgid "Stores the <link=\"ELEMENTSSOLID\">Solid Materials</link> of your choosing.\n\nSends a <b><style=\"logic_on\">Green Signal</style></b> when bin is full."
msgstr "تخزن <link=\"ELEMENTSSOLID\">المواد الصلبة</link> التي تختارها.\n\nترسل <b><style=\"logic_on\">إشارة خضراء</style></b> عندما يكون الصندوق ممتلئاً."

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.LOGIC_PORT"
msgid "Full/Not Full"
msgstr "ممتلئ/غير ممتلئ"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when full"
msgstr "ترسل <b><style=\"logic_on\">إشارة خضراء</style></b> عندما يكون ممتلئاً"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "بخلاف ذلك، ترسل <b><style=\"logic_off\">إشارة حمراء</style></b>"

#. STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGELOCKERSMART.NAME"
msgid "<link=\"STORAGELOCKERSMART\">Smart Storage Bin</link>"
msgstr "<link=\"STORAGELOCKERSMART\">صندوق تخزين ذكي</link>"

#. STRINGS.BUILDINGS.PREFABS.STORAGETILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGETILE.DESC"
msgid "Storage tiles keep selected non-edible solids out of the way."
msgstr "تعمل بلاطات التخزين على إبقاء المواد الصلبة غير القابلة للأكل المختارة بعيداً عن الطريق."

#. STRINGS.BUILDINGS.PREFABS.STORAGETILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGETILE.EFFECT"
msgid "Used to build the walls and floors of rooms.\n\nProvides built-in storage for small spaces."
msgstr "تُستخدم لبناء جدران وأرضيات الغرف.\n\nتوفر تخزيناً مدمجاً للمساحات الصغيرة."

#. STRINGS.BUILDINGS.PREFABS.STORAGETILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.STORAGETILE.NAME"
msgid "<link=\"STORAGETILE\">Storage Tile</link>"
msgstr "<link=\"STORAGETILE\">بلاطة تخزين</link>"

#. STRINGS.BUILDINGS.PREFABS.SUBLIMATIONSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SUBLIMATIONSTATION.DESC"
msgid "Sublimation is the sublime process by which solids convert directly into gas."
msgstr "التسامي هو العملية السامية التي تتحول بها المواد الصلبة مباشرة إلى غاز."

#. STRINGS.BUILDINGS.PREFABS.SUBLIMATIONSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SUBLIMATIONSTATION.EFFECT"
msgid "Speeds up the conversion of <link=\"TOXICSAND\">Polluted Dirt</link> into <link=\"CONTAMINATEDOXYGEN\">Polluted Oxygen</link>.\n\nBecomes idle when the area reaches maximum pressure capacity."
msgstr "تسرع من تحويل <link=\"TOXICSAND\">التربة الملوثة</link> إلى <link=\"CONTAMINATEDOXYGEN\">أكسجين ملوث</link>.\n\nتصبح خاملة عندما تصل المنطقة إلى سعة الضغط القصوى."

#. STRINGS.BUILDINGS.PREFABS.SUBLIMATIONSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SUBLIMATIONSTATION.NAME"
msgid "<link=\"SUBLIMATIONSTATION\">Sublimation Station</link>"
msgstr "<link=\"SUBLIMATIONSTATION\">محطة التسامي</link>"

#. STRINGS.BUILDINGS.PREFABS.SUGARENGINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SUGARENGINE.DESC"
msgid "Not the most stylish way to travel space, but certainly the tastiest."
msgstr "ليست الطريقة الأكثر أناقة للسفر في الفضاء، لكنها بالتأكيد الألذ."

#. STRINGS.BUILDINGS.PREFABS.SUGARENGINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SUGARENGINE.EFFECT"
msgid "Burns <link=\"SUCROSE\">Sucrose</link> to propel rockets for short range space exploration.\n\nSugar Engines have higher height restrictions than <link=\"CO2ENGINE\">Carbon Dioxide Engines</link>, but move slower.\n\nEngine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>, and requires a <link=\"OXIDIZERTANKCLUSTER\">Large Solid Oxidizer Tank</link>. \n\nOnce the engine has been built, more rocket modules can be added."
msgstr "تحرق <link=\"SUCROSE\">السكروز</link> لدفع الصواريخ لاستكشاف الفضاء قصير المدى.\n\nتتمتع محركات السكر بقيود ارتفاع أعلى من <link=\"CO2ENGINE\">محركات ثاني أكسيد الكربون</link>، لكنها تتحرك ببطء أكبر.\n\nيجب بناء المحرك عبر <link=\"LAUNCHPAD\">منصة الصاروخ</link>، ويتطلب <link=\"OXIDIZERTANKCLUSTER\">خزان مؤكسد صلب كبير</link>.\n\nبمجرد بناء المحرك، يمكن إضافة المزيد من وحدات الصاروخ."

#. STRINGS.BUILDINGS.PREFABS.SUGARENGINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SUGARENGINE.NAME"
msgid "<link=\"SUGARENGINE\">Sugar Engine</link>"
msgstr "<link=\"SUGARENGINE\">محرك السكر</link>"

#. STRINGS.BUILDINGS.PREFABS.SUITFABRICATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITFABRICATOR.DESC"
msgid "Exosuits can be filled with oxygen to allow Duplicants to safely enter hazardous areas."
msgstr "يمكن ملء البدلات الخارجية بالأكسجين للسماح للمكررين بدخول المناطق الخطرة بأمان."

#. STRINGS.BUILDINGS.PREFABS.SUITFABRICATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITFABRICATOR.EFFECT"
msgid "Forges protective <link=\"EQUIPMENT\">Exosuits</link> for Duplicants to wear.\n\nDuplicants will not fabricate items unless recipes are queued."
msgstr "تصنع <link=\"EQUIPMENT\">بدلات خارجية</link> واقية ليرتديها المكررون.\n\nلن يقوم المكررون بتصنيع العناصر ما لم يتم وضع الوصفات في قائمة الانتظار."

#. STRINGS.BUILDINGS.PREFABS.SUITFABRICATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITFABRICATOR.NAME"
msgid "<link=\"SUITFABRICATOR\">Exosuit Forge</link>"
msgstr "<link=\"SUITFABRICATOR\">مسبك البدلات الخارجية</link>"

#. STRINGS.BUILDINGS.PREFABS.SUITLOCKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITLOCKER.DESC"
msgid "An atmo suit dock will empty atmo suits of waste, but only one suit can charge at a time."
msgstr "سيقوم رصيف بدلة أتمو بتفريغ بدلات أتمو من النفايات، ولكن يمكن لبدلة واحدة فقط الشحن في كل مرة."

#. STRINGS.BUILDINGS.PREFABS.SUITLOCKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITLOCKER.EFFECT"
msgid "Stores <link=\"ATMOSUIT\">Atmo Suits</link> and refuels them with <link=\"OXYGEN\">Oxygen</link>.\n\nEmpties suits of <link=\"DIRTYWATER\">Polluted Water</link>.\n\nBuild next to an <link=\"SUITMARKER\">Atmo Suit Checkpoint</link> to make Duplicants change into suits when passing by."
msgstr "تخزن <link=\"ATMOSUIT\">بدلات أتمو</link> وتعيد تزويدها بـ <link=\"OXYGEN\">الأكسجين</link>.\n\nتفرغ البدلات من <link=\"DIRTYWATER\">المياه الملوثة</link>.\n\nابنِ بجوار <link=\"SUITMARKER\">نقطة تفتيش بدلة أتمو</link> لجعل المكررين يغيرون ملابسهم إلى بدلات عند المرور."

#. STRINGS.BUILDINGS.PREFABS.SUITLOCKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITLOCKER.NAME"
msgid "<link=\"SUITLOCKER\">Atmo Suit Dock</link>"
msgstr "<link=\"SUITLOCKER\">رصيف بدلة أتمو</link>"

#. STRINGS.BUILDINGS.PREFABS.SUITMARKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITMARKER.DESC"
msgid "A checkpoint must have a correlating dock built on the opposite side its arrow faces."
msgstr "يجب أن تحتوي نقطة التفتيش على رصيف مطابق مبني على الجانب المقابل الذي يواجهه سهمها."

#. STRINGS.BUILDINGS.PREFABS.SUITMARKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITMARKER.EFFECT"
msgid "Marks a threshold where Duplicants must change into or out of <link=\"ATMOSUIT\">Atmo Suits</link>.\n\nMust be built next to an <link=\"SUITLOCKER\">Atmo Suit Dock</link>.\n\nCan be rotated before construction."
msgstr "تحدد عتبة حيث يجب على المكررين تغيير ملابسهم إلى أو من <link=\"ATMOSUIT\">بدلات أتمو</link>.\n\nيجب بناؤها بجوار <link=\"SUITLOCKER\">رصيف بدلة أتمو</link>.\n\nيمكن تدويرها قبل البناء."

#. STRINGS.BUILDINGS.PREFABS.SUITMARKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SUITMARKER.NAME"
msgid "<link=\"SUITMARKER\">Atmo Suit Checkpoint</link>"
msgstr "<link=\"SUITMARKER\">نقطة تفتيش بدلة أتمو</link>"

#. STRINGS.BUILDINGS.PREFABS.SUNLAMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SUNLAMP.DESC"
msgid "An artificial ray of sunshine."
msgstr "شعاع اصطناعي من ضوء الشمس."

#. STRINGS.BUILDINGS.PREFABS.SUNLAMP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SUNLAMP.EFFECT"
msgid "Gives off <link=\"LIGHT\">Sunlight</link> level Lux.\n\nCan be paired with <link=\"BEACHCHAIR\">Beach Chairs</link>."
msgstr "يصدر مستوى لوكس من <link=\"LIGHT\">ضوء الشمس</link>.\n\nيمكن إقرانه بـ <link=\"BEACHCHAIR\">كراسي الشاطئ</link>."

#. STRINGS.BUILDINGS.PREFABS.SUNLAMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SUNLAMP.NAME"
msgid "<link=\"SUNLAMP\">Sun Lamp</link>"
msgstr "<link=\"SUNLAMP\">مصباح شمسي</link>"

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.DESC"
msgid "Rare materials can be procured through rocket missions into space."
msgstr "يمكن الحصول على مواد نادرة من خلال مهام الصواريخ إلى الفضاء."

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.EFFECT"
msgid "Processes <link=\"RAREMATERIALS\">Rare Materials</link> into advanced industrial goods.\n\nRare materials can be retrieved from space missions.\n\nDuplicants will not fabricate items unless recipes are queued."
msgstr "تعالج <link=\"RAREMATERIALS\">المواد النادرة</link> وتحولها إلى سلع صناعية متقدمة.\n\nيمكن استرداد المواد النادرة من مهام الفضاء.\n\nلن يقوم المكررون بتصنيع العناصر ما لم يتم وضع الوصفات في قائمة الانتظار."

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.FULLERENE_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.FULLERENE_RECIPE_DESCRIPTION"
msgid "Fullerene is a <link=\"ELEMENTSSOLID\">Solid Material</link> used in the production of <link=\"SUPERCOOLANT\">Super Coolant</link>."
msgstr "الفوليرين هو <link=\"ELEMENTSSOLID\">مادة صلبة</link> تُستخدم في إنتاج <link=\"SUPERCOOLANT\">سائل التبريد الفائق</link>."

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.HARDPLASTIC_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.HARDPLASTIC_RECIPE_DESCRIPTION"
msgid "Plastium is a highly heat-resistant, plastic-like <link=\"ELEMENTSSOLID\">Solid Material</link> used for space buildings."
msgstr "بلاستيوم هي <link=\"ELEMENTSSOLID\">مادة صلبة</link> شبيهة بالبلاستيك ومقاومة للحرارة العالية، تُستخدم في مباني الفضاء."

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.NAME"
msgid "<link=\"SUPERMATERIALREFINERY\">Molecular Forge</link>"
msgstr "<link=\"SUPERMATERIALREFINERY\">المطرق الجزيئي</link>"

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.SELF_CHARGING_POWERBANK_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.SELF_CHARGING_POWERBANK_RECIPE_DESCRIPTION"
msgid "Atomic Power Banks are portable, self-charging units used for isolated <link=\"POWER\">Power</link> grids."
msgstr "بنوك الطاقة الذرية هي وحدات محمولة ذاتية الشحن تُستخدم لشبكات <link=\"POWER\">الطاقة</link> المعزولة."

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.SUPERCOOLANT_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.SUPERCOOLANT_RECIPE_DESCRIPTION"
msgid "Super Coolant is an industrial-grade <link=\"FULLERENE\">Fullerene</link> coolant."
msgstr "سائل التبريد الفائق هو سائل تبريد من <link=\"FULLERENE\">الفوليرين</link> ذو جودة صناعية."

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.SUPERINSULATOR_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.SUPERINSULATOR_RECIPE_DESCRIPTION"
msgid "Insulite reduces <link=\"HEAT\">Heat Transfer</link> and is composed of recrystallized <link=\"KATAIRITE\">Abyssalite</link>."
msgstr "يقلل الإنسولايت من <link=\"HEAT\">انتقال الحرارة</link> ويتكون من <link=\"KATAIRITE\">أبيسالايت</link> مُعاد تبلوره."

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.TEMPCONDUCTORSOLID_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.TEMPCONDUCTORSOLID_RECIPE_DESCRIPTION"
msgid "Thermium is an industrial metal alloy formulated to maximize <link=\"HEAT\">Heat Transfer</link> and thermal dispersion."
msgstr "ثيرميوم هو سبيكة معدنية صناعية مُصاغة لزيادة <link=\"HEAT\">انتقال الحرارة</link> والتشتت الحراري إلى أقصى حد."

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.VISCOGEL_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.VISCOGEL_RECIPE_DESCRIPTION"
msgid "Visco-Gel Fluid is a <link=\"ELEMENTSLIQUID\">Liquid</link> polymer with high surface tension."
msgstr "سائل فيسكو-جيل هو بوليمر <link=\"ELEMENTSLIQUID\">سائل</link> ذو توتر سطحي عالٍ."

#. STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.YELLOWCAKE_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.SUPERMATERIALREFINERY.YELLOWCAKE_RECIPE_DESCRIPTION"
msgid "Yellowcake is a <link=\"ELEMENTSSOLID\">Solid Material</link> used in uranium enrichment."
msgstr "الكعكة الصفراء هي <link=\"ELEMENTSSOLID\">مادة صلبة</link> تُستخدم في تخصيب اليورانيوم."

#. STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.DESC"
msgid "The cute little face comes pre-installed."
msgstr "الوجه الصغير اللطيف يأتي مثبتاً مسبقاً."

#. STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.EFFECT"
msgid "Deploys an automated <link=\"SWEEPBOT\">Sweepy Bot</link> to sweep up <link=\"ELEMENTSSOLID\">Solid</link> debris and <link=\"ELEMENTSLIQUID\">Liquid</link> spills.\n\nDock stores <link=\"ELEMENTSLIQUID\">Liquids</link> and <link=\"ELEMENTSSOLID\">Solids</link> gathered by the Sweepy.\n\nUses <link=\"POWER\">Power</link> to recharge the Sweepy.\n\nDuplicants will empty Dock storage into available storage bins."
msgstr "ينشر روبوت كنس آلياً <link=\"SWEEPBOT\">سويبي</link> لكنس الحطام <link=\"ELEMENTSSOLID\">الصلب</link> وانسكابات <link=\"ELEMENTSLIQUID\">السوائل</link>.\n\nيخزن الرصيف <link=\"ELEMENTSLIQUID\">السوائل</link> و<link=\"ELEMENTSSOLID\">المواد الصلبة</link> التي يجمعها سويبي.\n\nيستخدم <link=\"POWER\">الطاقة</link> لإعادة شحن سويبي.\n\nسيقوم المكررون بتفريغ تخزين الرصيف في صناديق التخزين المتاحة."

#. STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.NAME"
msgid "<link=\"SWEEPBOTSTATION\">Sweepy's Dock</link>"
msgstr "<link=\"SWEEPBOTSTATION\">رصيف سويبي</link>"

#. STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.NAMEDSTATION
msgctxt "STRINGS.BUILDINGS.PREFABS.SWEEPBOTSTATION.NAMEDSTATION"
msgid "{0}'s Dock"
msgstr "رصيف {0}"

#. STRINGS.BUILDINGS.PREFABS.SWITCH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.DESC"
msgid "Switches can only affect buildings that come after them on a circuit."
msgstr "لا يمكن للمفاتيح التأثير إلا على المباني التي تأتي بعدها في الدائرة الكهربائية."

#. STRINGS.BUILDINGS.PREFABS.SWITCH.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.EFFECT"
msgid "Turns <link=\"POWER\">Power</link> on or off.\n\nDoes not affect circuitry preceding the switch."
msgstr "يقوم بتشغيل أو إيقاف <link=\"POWER\">الطاقة</link>.\n\nلا يؤثر على الدوائر التي تسبق المفتاح."

#. STRINGS.BUILDINGS.PREFABS.SWITCH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.NAME"
msgid "<link=\"SWITCH\">Switch</link>"
msgstr "<link=\"SWITCH\">مفتاح</link>"

#. STRINGS.BUILDINGS.PREFABS.SWITCH.SIDESCREEN_TITLE
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.SIDESCREEN_TITLE"
msgid "Switch"
msgstr "مفتاح"

#. STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_OFF
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_OFF"
msgid "Turn Off"
msgstr "إيقاف التشغيل"

#. STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_OFF_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_OFF_TOOLTIP"
msgid "Turn Off {Hotkey}"
msgstr "إيقاف التشغيل {Hotkey}"

#. STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_ON
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_ON"
msgid "Turn On"
msgstr "تشغيل"

#. STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_ON_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.SWITCH.TURN_ON_TOOLTIP"
msgid "Turn On {Hotkey}"
msgstr "تشغيل {Hotkey}"

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.DESC"
msgid "You never know who you'll meet on the other line."
msgstr "لا تعرف أبداً من ستقابل على الطرف الآخر من الخط."

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT"
msgid "Can be used by one Duplicant to chat with themselves or with other Duplicants in different locations.\n\nChatting increases Duplicant <link=\"MORALE\">Morale</link>."
msgstr "يمكن استخدامه من قبل مكرر واحد للدردشة مع نفسه أو مع مكررين آخرين في مواقع مختلفة.\n\nالدردشة تزيد من <link=\"MORALE\">معنويات</link> المكرر."

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_BABBLE
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_BABBLE"
msgid "{attrib}: {amount} (No One)"
msgstr "{attrib}: {amount} (لا أحد)"

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_BABBLE_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_BABBLE_TOOLTIP"
msgid "Duplicants will gain {amount} {attrib} if they chat only with themselves."
msgstr "سيكتسب المكررون {amount} {attrib} إذا تحدثوا مع أنفسهم فقط."

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_CHAT
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_CHAT"
msgid "{attrib}: {amount} (At least one Duplicant)"
msgstr "{attrib}: {amount} (مكرر واحد على الأقل)"

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_CHAT_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_CHAT_TOOLTIP"
msgid "Duplicants will gain {amount} {attrib} if they chat with at least one other Duplicant."
msgstr "سيكتسب المكررون {amount} {attrib} إذا تحدثوا مع مكرر واحد آخر على الأقل."

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_LONG_DISTANCE
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_LONG_DISTANCE"
msgid "{attrib}: {amount} (At least one Duplicant across space)"
msgstr "{attrib}: {amount} (مكرر واحد على الأقل عبر الفضاء)"

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_LONG_DISTANCE_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.EFFECT_LONG_DISTANCE_TOOLTIP"
msgid "Duplicants will gain {amount} {attrib} if they chat with at least one other Duplicant across space."
msgstr "سيكتسب المكررون {amount} {attrib} إذا تحدثوا مع مكرر واحد آخر على الأقل عبر الفضاء."

#. STRINGS.BUILDINGS.PREFABS.TELEPHONE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPHONE.NAME"
msgid "<link=\"TELEPHONE\">Party Line Phone</link>"
msgstr "<link=\"TELEPHONE\">هاتف الخط الجماعي</link>"

#. STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.DESC"
msgid "Duplicants are just atoms as far as the pad's concerned."
msgstr "المكررون مجرد ذرات بالنسبة للمنصة."

#. STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.EFFECT"
msgid "Instantly transports Duplicants and items to another portal with the same portal code."
msgstr "ينقل المكررين والعناصر فورياً إلى بوابة أخرى تحمل نفس رمز البوابة."

#. STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.LOGIC_PORT"
msgid "Portal Code Input"
msgstr "مدخل رمز البوابة"

#. STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.LOGIC_PORT_ACTIVE"
msgid "1"
msgstr "1"

#. STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.LOGIC_PORT_INACTIVE"
msgid "0"
msgstr "0"

#. STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TELEPORTALPAD.NAME"
msgid "Teleporter Pad"
msgstr "منصة النقل الآني"

#. STRINGS.BUILDINGS.PREFABS.TELESCOPE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TELESCOPE.DESC"
msgid "Telescopes are necessary for learning starmaps and conducting rocket missions."
msgstr "التلسكوبات ضرورية لتعلم خرائط النجوم وإجراء مهام الصواريخ."

#. STRINGS.BUILDINGS.PREFABS.TELESCOPE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TELESCOPE.EFFECT"
msgid "Maps Starmap destinations for space exploration.\n\nAssigned Duplicants must possess the <link=\"RESEARCHING2\">Field Research</link> skill.\n\nBuilding must be exposed to space to function."
msgstr "يحدد وجهات خريطة النجوم لاستكشاف الفضاء.\n\nيجب أن يمتلك المكررون المعينون مهارة <link=\"RESEARCHING2\">البحث الميداني</link>.\n\nيجب أن يكون المبنى مكشوفاً للفضاء ليعمل."

#. STRINGS.BUILDINGS.PREFABS.TELESCOPE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TELESCOPE.NAME"
msgid "<link=\"TELESCOPE\">Telescope</link>"
msgstr "<link=\"TELESCOPE\">تلسكوب</link>"

#. STRINGS.BUILDINGS.PREFABS.TELESCOPE.REQUIREMENT_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.TELESCOPE.REQUIREMENT_TOOLTIP"
msgid "A steady {0} supply is required to sustain working Duplicants."
msgstr "مطلوب إمداد ثابت من {0} للحفاظ على عمل المكررين."

#. STRINGS.BUILDINGS.PREFABS.TEMPERATURECONTROLLEDSWITCH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPERATURECONTROLLEDSWITCH.DESC"
msgid "Automated switches can be used to manage circuits in areas where Duplicants cannot enter."
msgstr "يمكن استخدام المفاتيح الآلية لإدارة الدوائر في المناطق التي لا يمكن للمكررين دخولها."

#. STRINGS.BUILDINGS.PREFABS.TEMPERATURECONTROLLEDSWITCH.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPERATURECONTROLLEDSWITCH.EFFECT"
msgid "Automatically turns <link=\"POWER\">Power</link> on or off using ambient <link=\"HEAT\">Temperature</link>.\n\nDoes not affect circuitry preceding the switch."
msgstr "يقوم بتشغيل أو إيقاف <link=\"POWER\">الطاقة</link> آلياً باستخدام <link=\"HEAT\">درجة الحرارة</link> المحيطة.\n\nلا يؤثر على الدوائر التي تسبق المفتاح."

#. STRINGS.BUILDINGS.PREFABS.TEMPERATURECONTROLLEDSWITCH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPERATURECONTROLLEDSWITCH.NAME"
msgid "<link=\"TEMPERATURECONTROLLEDSWITCH\">Thermo Switch</link>"
msgstr "<link=\"TEMPERATURECONTROLLEDSWITCH\">مفتاح حراري</link>"

#. STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.DESC"
msgid "Infinite possibilities, with a complimentary side of meteor showers."
msgstr "احتمالات لا نهائية، مع جانب مجاني من زخات النيازك."

#. STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.EFFECT"
msgid "A powerful mechanism capable of tearing through the fabric of reality."
msgstr "آلية قوية قادرة على التمزق عبر نسيج الواقع."

#. STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.NAME"
msgid "Temporal Tear Opener"
msgstr "فاتح التمزق الزمني"

#. STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.SIDESCREEN.TEXT
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.SIDESCREEN.TEXT"
msgid "Fire!"
msgstr "أطلق!"

#. STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.SIDESCREEN.TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.TEMPORALTEAROPENER.SIDESCREEN.TOOLTIP"
msgid "The big red button."
msgstr "الزر الأحمر الكبير."

#. STRINGS.BUILDINGS.PREFABS.THERMALBLOCK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.THERMALBLOCK.DESC"
msgid "The thermal properties of construction materials determine their heat retention."
msgstr "تحدد الخصائص الحرارية لمواد البناء قدرتها على الاحتفاظ بالحرارة."

#. STRINGS.BUILDINGS.PREFABS.THERMALBLOCK.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.THERMALBLOCK.EFFECT"
msgid "Accelerates or buffers <link=\"HEAT\">Heat</link> dispersal based on the construction material used.\n\nHas a small area of effect."
msgstr "يسرع أو يخفف من تشتت <link=\"HEAT\">الحرارة</link> بناءً على مادة البناء المستخدمة.\n\nله منطقة تأثير صغيرة."

#. STRINGS.BUILDINGS.PREFABS.THERMALBLOCK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.THERMALBLOCK.NAME"
msgid "<link=\"THERMALBLOCK\">Tempshift Plate</link>"
msgstr "<link=\"THERMALBLOCK\">لوح تبديل الحرارة</link>"

#. STRINGS.BUILDINGS.PREFABS.TILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TILE.DESC"
msgid "Tile can be used to bridge gaps and get to unreachable areas."
msgstr "يمكن استخدام البلاط لسد الفجوات والوصول إلى المناطق التي يصعب الوصول إليها."

#. STRINGS.BUILDINGS.PREFABS.TILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TILE.EFFECT"
msgid "Used to build the walls and floors of rooms.\n\nIncreases Duplicant runspeed."
msgstr "يُستخدم لبناء جدران وأرضيات الغرف.\n\nيزيد من سرعة ركض المكرر."

#. STRINGS.BUILDINGS.PREFABS.TILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TILE.NAME"
msgid "<link=\"TILE\">Tile</link>"
msgstr "<link=\"TILE\">بلاط</link>"

#. STRINGS.BUILDINGS.PREFABS.TILEPOI.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TILEPOI.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.TILEPOI.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TILEPOI.EFFECT"
msgid "Used to build the walls and floor of rooms."
msgstr "يُستخدم لبناء جدران وأرضية الغرف."

#. STRINGS.BUILDINGS.PREFABS.TILEPOI.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TILEPOI.NAME"
msgid "<link=\"TILEPOI\">Tile</link>"
msgstr "<link=\"TILEPOI\">بلاط</link>"

#. STRINGS.BUILDINGS.PREFABS.TOURISTMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TOURISTMODULE.DESC"
msgid "An astronaut must accompany sight seeing Duplicants on rocket flights."
msgstr "يجب أن يرافق رائد فضاء المكررين في رحلات مشاهدة المعالم على متن الصاروخ."

#. STRINGS.BUILDINGS.PREFABS.TOURISTMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TOURISTMODULE.EFFECT"
msgid "Allows one non-Astronaut Duplicant to visit space.\n\nSight-Seeing Rocket flights decrease <link=\"STRESS\">Stress</link>."
msgstr "يسمح لمكرر واحد ليس برائد فضاء بزيارة الفضاء.\n\nرحلات الصاروخ لمشاهدة المعالم تقلل من <link=\"STRESS\">الإجهاد</link>."

#. STRINGS.BUILDINGS.PREFABS.TOURISTMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TOURISTMODULE.NAME"
msgid "<link=\"TOURISTMODULE\">Sight-Seeing Module</link>"
msgstr "<link=\"TOURISTMODULE\">وحدة مشاهدة المعالم</link>"

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBE.DESC"
msgid "Duplicants will only exit a transit tube when a safe landing area is available beneath it."
msgstr "لن يخرج المكررون من أنبوب النقل إلا عند توفر منطقة هبوط آمنة تحته."

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBE.EFFECT"
msgid "Quickly transports Duplicants from a <link=\"TRAVELTUBEENTRANCE\">Transit Tube Access</link> to the tube's end.\n\nOnly transports Duplicants."
msgstr "ينقل المكررين بسرعة من <link=\"TRAVELTUBEENTRANCE\">مدخل أنبوب النقل</link> إلى نهاية الأنبوب.\n\nينقل المكررين فقط."

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBE.NAME"
msgid "<link=\"TRAVELTUBE\">Transit Tube</link>"
msgstr "<link=\"TRAVELTUBE\">أنبوب النقل</link>"

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBEENTRANCE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEENTRANCE.DESC"
msgid "Duplicants require access points to enter tubes, but not to exit them."
msgstr "يحتاج المكررون إلى نقاط وصول لدخول الأنابيب، ولكن ليس للخروج منها."

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBEENTRANCE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEENTRANCE.EFFECT"
msgid "Allows Duplicants to enter the connected <link=\"TRAVELTUBE\">Transit Tube</link> system.\n\nStops drawing <link=\"POWER\">Power</link> once fully charged."
msgstr "يسمح للمكررين بدخول نظام <link=\"TRAVELTUBE\">أنبوب النقل</link> المتصل.\n\nيتوقف عن سحب <link=\"POWER\">الطاقة</link> بمجرد شحنه بالكامل."

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBEENTRANCE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEENTRANCE.NAME"
msgid "<link=\"TRAVELTUBEENTRANCE\">Transit Tube Access</link>"
msgstr "<link=\"TRAVELTUBEENTRANCE\">مدخل أنبوب النقل</link>"

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBEWALLBRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEWALLBRIDGE.DESC"
msgid "Tube crossings can run transit tubes through walls without leaking gas or liquid."
msgstr "يمكن لتقاطعات الأنابيب تمرير أنابيب النقل عبر الجدران دون تسريب الغاز أو السائل."

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBEWALLBRIDGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEWALLBRIDGE.EFFECT"
msgid "Allows <link=\"TRAVELTUBE\">Transit Tubes</link> to be run through wall and floor tile.\n\nFunctions as regular tile."
msgstr "يسمح بتمرير <link=\"TRAVELTUBE\">أنابيب النقل</link> عبر بلاط الجدار والأرضية.\n\nيعمل كبلاط عادي."

#. STRINGS.BUILDINGS.PREFABS.TRAVELTUBEWALLBRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.TRAVELTUBEWALLBRIDGE.NAME"
msgid "<link=\"TRAVELTUBEWALLBRIDGE\">Transit Tube Crossing</link>"
msgstr "<link=\"TRAVELTUBEWALLBRIDGE\">تقاطع أنبوب النقل</link>"

#. STRINGS.BUILDINGS.PREFABS.UNCONSTRUCTEDROCKETMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.UNCONSTRUCTEDROCKETMODULE.DESC"
msgid "Something useful could be put here someday"
msgstr "يمكن وضع شيء مفيد هنا يوماً ما"

#. STRINGS.BUILDINGS.PREFABS.UNCONSTRUCTEDROCKETMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.UNCONSTRUCTEDROCKETMODULE.EFFECT"
msgid "Can be changed into a different rocket module"
msgstr "يمكن تغييرها إلى وحدة صاروخ مختلفة"

#. STRINGS.BUILDINGS.PREFABS.UNCONSTRUCTEDROCKETMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.UNCONSTRUCTEDROCKETMODULE.NAME"
msgid "Empty Rocket Module"
msgstr "وحدة صاروخ فارغة"

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERCRITTERCONDO.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERCRITTERCONDO.DESC"
msgid "Even wild critters are happier after they've had a little R&R."
msgstr "حتى المخلوقات البرية تكون أكثر سعادة بعد حصولها على القليل من الراحة والاستجمام."

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERCRITTERCONDO.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERCRITTERCONDO.EFFECT"
msgid "A fancy respite area for adult <link=\"CRABSPECIES\">Pokeshells</link> and <link=\"PACUSPECIES\">Pacu</link>."
msgstr "منطقة استراحة فاخرة للبالغين من <link=\"CRABSPECIES\">البوكشيل</link> و<link=\"PACUSPECIES\">الباكو</link>."

#. STRINGS.BUILDINGS.PREFABS.UNDERWATERCRITTERCONDO.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.UNDERWATERCRITTERCONDO.NAME"
msgid "<link=\"UNDERWATERCRITTERCONDO\">Water Fort</link>"
msgstr "<link=\"UNDERWATERCRITTERCONDO\">حصن الماء</link>"

#. STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.DESC"
msgid "Enriched uranium is a specialized substance that can be used to fuel powerful research reactors."
msgstr "اليورانيوم المخصب مادة متخصصة يمكن استخدامها لتزويد المفاعلات البحثية القوية بالوقود."

#. STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.EFFECT"
msgid "Extracts <link=\"ENRICHEDURANIUM\">Enriched Uranium</link> from <link=\"URANIUMORE\">Uranium Ore</link>.\n\nOutputs <link=\"DEPLETEDURANIUM\">Depleted Uranium</link> in molten form."
msgstr "يستخلص <link=\"ENRICHEDURANIUM\">يورانيوم مخصب</link> من <link=\"URANIUMORE\">خام اليورانيوم</link>.\n\nيخرج <link=\"DEPLETEDURANIUM\">يورانيوم مستنفد</link> في شكل منصهر."

#. STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.NAME"
msgid "<link=\"URANIUMCENTRIFUGE\">Uranium Centrifuge</link>"
msgstr "<link=\"URANIUMCENTRIFUGE\">جهاز طرد مركزي لليورانيوم</link>"

#. STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.URANIUMCENTRIFUGE.RECIPE_DESCRIPTION"
msgid "Convert Uranium ore to Molten Uranium and Enriched Uranium"
msgstr "تحويل خام اليورانيوم إلى يورانيوم منصهر ويورانيوم مخصب"

#. STRINGS.BUILDINGS.PREFABS.VENDINGMACHINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.VENDINGMACHINE.DESC"
msgid "A pristine <link=\"FIELDRATION\">Nutrient Bar</link> dispenser."
msgstr "موزع <link=\"FIELDRATION\">لوح مغذيات</link> أصلي."

#. STRINGS.BUILDINGS.PREFABS.VENDINGMACHINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.VENDINGMACHINE.NAME"
msgid "Vending Machine"
msgstr "آلة بيع"

#. STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.DESC"
msgid "Duplicants love the feeling of high-powered wind through their hair."
msgstr "يعشق المكررون شعور الرياح القوية التي تمر عبر شعرهم."

#. STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.DISPLACEMENTEFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.DISPLACEMENTEFFECT"
msgid "Gas Displacement: {amount}"
msgstr "إزاحة الغاز: {amount}"

#. STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.DISPLACEMENTEFFECT_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.DISPLACEMENTEFFECT_TOOLTIP"
msgid "This building will displace {amount} Gas while in use."
msgstr "سيقوم هذا المبنى بإزاحة {amount} من الغاز أثناء الاستخدام."

#. STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.EFFECT"
msgid "Must be connected to a <link=\"POWER\">Power Source</link>. To properly function, the area under this building must be left vacant.\n\nIncreases Duplicants <link=\"MORALE\">Morale</link>."
msgstr "يجب توصيله بـ <link=\"POWER\">مصدر طاقة</link>. ليعمل بشكل صحيح، يجب ترك المنطقة أسفل هذا المبنى شاغرة.\n\nيزيد من <link=\"MORALE\">معنويات</link> المكررين."

#. STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.VERTICALWINDTUNNEL.NAME"
msgid "<link=\"VERTICALWINDTUNNEL\">Vertical Wind Tunnel</link>"
msgstr "<link=\"VERTICALWINDTUNNEL\">نفق رياح عمودي</link>"

#. STRINGS.BUILDINGS.PREFABS.WALLTOILET.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WALLTOILET.DESC"
msgid "Wall Toilets transmit fewer germs to Duplicants and require no emptying."
msgstr "تنقل المراحيض الجدارية جراثيم أقل إلى المكررين ولا تتطلب تفريغاً."

#. STRINGS.BUILDINGS.PREFABS.WALLTOILET.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WALLTOILET.EFFECT"
msgid "Gives Duplicants a place to relieve themselves. Empties directly on the other side of the wall.\n\nSpreads very few <link=\"DISEASE\">Germs</link>."
msgstr "يمنح المكررين مكاناً لقضاء حاجتهم. يفرغ مباشرة على الجانب الآخر من الجدار.\n\nينشر عدداً قليلاً جداً من <link=\"DISEASE\">الجراثيم</link>."

#. STRINGS.BUILDINGS.PREFABS.WALLTOILET.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WALLTOILET.NAME"
msgid "<link=\"WALLTOILET\">Wall Toilet</link>"
msgstr "<link=\"WALLTOILET\">مرحاض جداري</link>"

#. STRINGS.BUILDINGS.PREFABS.WARPCONDUITRECEIVER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITRECEIVER.DESC"
msgid "The tubes at the back disappear into nowhere."
msgstr "تختفي الأنابيب الموجودة في الخلف في العدم."

#. STRINGS.BUILDINGS.PREFABS.WARPCONDUITRECEIVER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITRECEIVER.EFFECT"
msgid "A machine capable of teleporting <link=\"ELEMENTSLIQUID\">Liquid</link>, <link=\"ELEMENTSSOLID\">Solid</link>, and <link=\"ELEMENTSGAS\">Gas</link> resources to another asteroid.\n\nIt can be activated by a Duplicant with the <link=\"RESEARCHING2\">Field Research</link> skill.\n\nThis is the receiving side."
msgstr "آلة قادرة على نقل موارد <link=\"ELEMENTSLIQUID\">السائل</link>، و<link=\"ELEMENTSSOLID\">الصلب</link>، و<link=\"ELEMENTSGAS\">الغاز</link> إلى كويكب آخر.\n\nيمكن تفعيلها بواسطة مكرر لديه مهارة <link=\"RESEARCHING2\">البحث الميداني</link>.\n\nهذا هو جانب الاستقبال."

#. STRINGS.BUILDINGS.PREFABS.WARPCONDUITRECEIVER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITRECEIVER.NAME"
msgid "<link=\"WARPCONDUITRECEIVER\">Supply Teleporter Output</link>"
msgstr "<link=\"WARPCONDUITRECEIVER\">مخرج ناقل الإمدادات</link>"

#. STRINGS.BUILDINGS.PREFABS.WARPCONDUITSENDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITSENDER.DESC"
msgid "The tubes at the back disappear into nowhere."
msgstr "تختفي الأنابيب الموجودة في الخلف في العدم."

#. STRINGS.BUILDINGS.PREFABS.WARPCONDUITSENDER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITSENDER.EFFECT"
msgid "A machine capable of teleporting <link=\"ELEMENTSLIQUID\">Liquid</link>, <link=\"ELEMENTSSOLID\">Solid</link>, and <link=\"ELEMENTSGAS\">Gas</link> resources to another asteroid.\n\nIt can be activated by a Duplicant with the <link=\"RESEARCHING2\">Field Research</link> skill.\n\nThis is the transmitting side."
msgstr "آلة قادرة على نقل موارد <link=\"ELEMENTSLIQUID\">السائل</link>، و<link=\"ELEMENTSSOLID\">الصلب</link>، و<link=\"ELEMENTSGAS\">الغاز</link> إلى كويكب آخر.\n\nيمكن تفعيلها بواسطة مكرر لديه مهارة <link=\"RESEARCHING2\">البحث الميداني</link>.\n\nهذا هو جانب الإرسال."

#. STRINGS.BUILDINGS.PREFABS.WARPCONDUITSENDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPCONDUITSENDER.NAME"
msgid "<link=\"WARPCONDUITSENDER\">Supply Teleporter Input</link>"
msgstr "<link=\"WARPCONDUITSENDER\">مدخل ناقل الإمدادات</link>"

#. STRINGS.BUILDINGS.PREFABS.WARPPORTAL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPPORTAL.DESC"
msgid "The functional remnants of an intricate teleportation system.\n\nThis is the outgoing side, and has one pre-programmed destination."
msgstr "البقايا الوظيفية لنظام انتقال معقد.\n\nهذا هو جانب المغادرة، ويحتوي على وجهة واحدة مبرمجة مسبقاً."

#. STRINGS.BUILDINGS.PREFABS.WARPPORTAL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPPORTAL.NAME"
msgid "Teleporter Transmitter"
msgstr "جهاز إرسال الانتقال"

#. STRINGS.BUILDINGS.PREFABS.WARPRECEIVER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPRECEIVER.DESC"
msgid "The functional remnants of an intricate teleportation system.\n\nThis is the incoming side."
msgstr "البقايا الوظيفية لنظام انتقال معقد.\n\nهذا هو جانب الاستقبال."

#. STRINGS.BUILDINGS.PREFABS.WARPRECEIVER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WARPRECEIVER.NAME"
msgid "Teleporter Receiver"
msgstr "جهاز استقبال الانتقال"

#. STRINGS.BUILDINGS.PREFABS.WASHBASIN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHBASIN.DESC"
msgid "Germ spread can be reduced by building these where Duplicants often get dirty."
msgstr "يمكن تقليل انتشار الجراثيم عن طريق بناء هذه الأحواض حيث يتسخ المكررون غالباً."

#. STRINGS.BUILDINGS.PREFABS.WASHBASIN.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHBASIN.EFFECT"
msgid "Removes some <link=\"DISEASE\">Germs</link> from Duplicants.\n\nGerm-covered Duplicants use Wash Basins when passing by in the selected direction."
msgstr "يزيل بعض <link=\"DISEASE\">الجراثيم</link> من المكررين.\n\nيستخدم المكررون الملوثون بالجراثيم أحواض الغسيل عند المرور في الاتجاه المحدد."

#. STRINGS.BUILDINGS.PREFABS.WASHBASIN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHBASIN.NAME"
msgid "<link=\"WASHBASIN\">Wash Basin</link>"
msgstr "<link=\"WASHBASIN\">حوض غسيل</link>"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.DESC"
msgid "Sinks are plumbed and do not need to be manually emptied or refilled."
msgstr "الأحواض موصلة بأنابيب ولا تحتاج إلى إفراغ أو إعادة تعبئة يدوياً."

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.EFFECT"
msgid "Removes <link=\"DISEASE\">Germs</link> from Duplicants.\n\nGerm-covered Duplicants use Sinks when passing by in the selected direction."
msgstr "تزيل <link=\"DISEASE\">الجراثيم</link> من المكررين.\n\nيستخدم المكررون الملوثون بالجراثيم الأحواض عند المرور بها في الاتجاه المحدد."

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.BLUE_BABYTEARS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.BLUE_BABYTEARS.DESC"
msgid "A calm, colorful sink for heavy-hearted Duplicants."
msgstr "حوض هادئ وملون للمكررين ذوي القلوب المثقلة."

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.BLUE_BABYTEARS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.BLUE_BABYTEARS.NAME"
msgid "<link=\"WASHSINK\">Weepy Blue Sink</link>"
msgstr "<link=\"WASHSINK\">حوض أزرق باكٍ</link>"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.DEFAULT_WASHSINK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.DEFAULT_WASHSINK.DESC"
msgid "Sinks are plumbed and do not need to be manually emptied or refilled."
msgstr "الأحواض موصلة بأنابيب ولا تحتاج إلى إفراغ أو إعادة تعبئة يدوياً."

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.DEFAULT_WASHSINK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.DEFAULT_WASHSINK.NAME"
msgid "<link=\"WASHSINK\">Sink</link>"
msgstr "<link=\"WASHSINK\">حوض</link>"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.GREEN_MUSH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.GREEN_MUSH.DESC"
msgid "Even the soap is mush-colored."
msgstr "حتى الصابون بلون الهريس."

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.GREEN_MUSH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.GREEN_MUSH.NAME"
msgid "<link=\"WASHSINK\">Mush Green Sink</link>"
msgstr "<link=\"WASHSINK\">حوض أخضر هريسي</link>"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.PURPLE_BRAINFAT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.PURPLE_BRAINFAT.DESC"
msgid "A refreshing splash of color for the light-headed."
msgstr "دفقة لون منعشة لمن يعانون من الدوار."

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.PURPLE_BRAINFAT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.PURPLE_BRAINFAT.NAME"
msgid "<link=\"WASHSINK\">Faint Purple Sink</link>"
msgstr "<link=\"WASHSINK\">حوض أرجواني باهت</link>"

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.RED_ROSE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.RED_ROSE.DESC"
msgid "Some Duplicants say it looks like a germ-devouring mouth."
msgstr "يقول بعض المكررين إنه يشبه فماً يلتهم الجراثيم."

#. STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.RED_ROSE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.WASHSINK.FACADES.RED_ROSE.NAME"
